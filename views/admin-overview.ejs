<!DOCTYPE html>
<html lang="en">
<head>
    <% pageTitle = 'Admin Overview' %>
    <%- include('partials/head') %>
</head>
<body class="antialiased overflow-x-hidden">
    <%- include('partials/nav') %>

    <main class="max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-10">
        <h1 class="text-2xl sm:text-3xl font-extrabold mb-8">Admin Overview</h1>

        <% if (!mailConfigured) { %>
            <div class="mb-8 px-4 sm:px-5 py-4 rounded-xl bg-amber-500/10 border border-amber-500/30 text-amber-400 text-sm flex items-center justify-between flex-wrap gap-3">
                <span><i class="fas fa-envelope-circle-check mr-2"></i>Email isn't configured yet — invites, password resets, and ticket notifications won't be sent.</span>
                <a href="/admin/settings" class="btn-amber px-4 py-2 rounded-lg text-xs whitespace-nowrap">Set Up Mail</a>
            </div>
        <% } %>

        <!-- Server data (live, from the admin SSH access configured in Settings) -->
        <div class="flex items-center justify-between mb-4 flex-wrap gap-2">
            <h2 class="text-sm uppercase tracking-widest text-slate-500 font-bold">Server Data</h2>
            <a href="/admin/ssh-console" class="text-sky-400 hover:text-sky-300 text-xs">SSH Console <i class="fas fa-arrow-right ml-1"></i></a>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 sm:gap-5 mb-10 sm:mb-12" id="serverDataGrid">
            <div class="glass rounded-2xl p-5 sm:p-6">
                <p class="text-slate-500 text-xs uppercase tracking-widest font-semibold mb-2"><i class="fas fa-clock mr-1"></i>Uptime</p>
                <p class="text-base sm:text-lg font-bold text-white" data-server-stat="uptime">—</p>
            </div>
            <div class="glass rounded-2xl p-5 sm:p-6">
                <p class="text-slate-500 text-xs uppercase tracking-widest font-semibold mb-2"><i class="fas fa-gauge-high mr-1"></i>Load Average</p>
                <p class="text-base sm:text-lg font-bold text-white" data-server-stat="load">—</p>
            </div>
            <div class="glass rounded-2xl p-5 sm:p-6">
                <p class="text-slate-500 text-xs uppercase tracking-widest font-semibold mb-2"><i class="fas fa-memory mr-1"></i>Memory</p>
                <p class="text-base sm:text-lg font-bold text-white" data-server-stat="memory">—</p>
            </div>
            <div class="glass rounded-2xl p-5 sm:p-6">
                <p class="text-slate-500 text-xs uppercase tracking-widest font-semibold mb-2"><i class="fas fa-hard-drive mr-1"></i>Disk</p>
                <p class="text-base sm:text-lg font-bold text-white" data-server-stat="disk">—</p>
            </div>
        </div>
        <p id="serverDataMessage" class="hidden text-slate-500 text-sm -mt-8 mb-10 sm:mb-12"></p>

        <!-- Container health summary (live, from the Health page's containers) -->
        <div class="flex items-center justify-between mb-4 flex-wrap gap-2">
            <h2 class="text-sm uppercase tracking-widest text-slate-500 font-bold">Container Health</h2>
            <a href="/admin/health" class="text-sky-400 hover:text-sky-300 text-xs">View Health Page <i class="fas fa-arrow-right ml-1"></i></a>
        </div>
        <% if (healthContainerCount === 0) { %>
            <div class="glass rounded-2xl p-5 sm:p-6 mb-10 sm:mb-12 text-slate-400 text-sm">
                No containers being monitored yet — add some on the <a href="/admin/health" class="text-sky-400 hover:text-sky-300">Health page</a> to see their status here.
            </div>
        <% } else { %>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 sm:gap-5 mb-10 sm:mb-12" id="healthSummaryGrid">
                <div class="glass rounded-2xl p-5 sm:p-6">
                    <p class="text-slate-500 text-xs uppercase tracking-widest font-semibold mb-2"><i class="fas fa-circle-check text-emerald-400 mr-1"></i>Online</p>
                    <p class="text-2xl sm:text-3xl font-extrabold text-emerald-400" data-health-count="up">—</p>
                </div>
                <div class="glass rounded-2xl p-5 sm:p-6">
                    <p class="text-slate-500 text-xs uppercase tracking-widest font-semibold mb-2"><i class="fas fa-triangle-exclamation text-amber-400 mr-1"></i>Unhealthy</p>
                    <p class="text-2xl sm:text-3xl font-extrabold text-amber-400" data-health-count="unhealthy">—</p>
                </div>
                <div class="glass rounded-2xl p-5 sm:p-6">
                    <p class="text-slate-500 text-xs uppercase tracking-widest font-semibold mb-2"><i class="fas fa-circle-xmark text-red-400 mr-1"></i>Offline</p>
                    <p class="text-2xl sm:text-3xl font-extrabold text-red-400" data-health-count="down">—</p>
                </div>
                <div class="glass rounded-2xl p-5 sm:p-6">
                    <p class="text-slate-500 text-xs uppercase tracking-widest font-semibold mb-2"><i class="fas fa-question text-slate-500 mr-1"></i>Unknown</p>
                    <p class="text-2xl sm:text-3xl font-extrabold text-slate-400" data-health-count="unknown">—</p>
                </div>
            </div>
        <% } %>

        <div class="flex items-center justify-between mb-4 flex-wrap gap-2">
            <h2 class="text-sm uppercase tracking-widest text-slate-500 font-bold">Account Overview</h2>
            <a href="/admin/users" class="text-sky-400 hover:text-sky-300 text-xs">View Users Page <i class="fas fa-arrow-right ml-1"></i></a>
        </div>
        <div class="grid sm:grid-cols-2 md:grid-cols-4 gap-4 sm:gap-5 mb-10 sm:mb-12">
            <div class="glass rounded-2xl p-5 sm:p-6">
                <p class="text-slate-500 text-xs uppercase tracking-widest font-semibold mb-2">Subscribers</p>
                <p class="text-2xl sm:text-3xl font-extrabold text-white"><%= userCount %></p>
            </div>
            <div class="glass rounded-2xl p-5 sm:p-6">
                <p class="text-slate-500 text-xs uppercase tracking-widest font-semibold mb-2">Plans</p>
                <p class="text-2xl sm:text-3xl font-extrabold text-white"><%= planCount %></p>
            </div>
            <div class="glass rounded-2xl p-5 sm:p-6">
                <p class="text-slate-500 text-xs uppercase tracking-widest font-semibold mb-2">Active Subscriptions</p>
                <p class="text-2xl sm:text-3xl font-extrabold text-sky-400"><%= activeSubs %></p>
            </div>
            <a href="/admin/tickets" class="glass rounded-2xl p-5 sm:p-6 hover:bg-white/5 transition block">
                <p class="text-slate-500 text-xs uppercase tracking-widest font-semibold mb-2">Open Tickets</p>
                <p class="text-2xl sm:text-3xl font-extrabold text-amber-400"><%= openTickets %></p>
            </a>
        </div>

        <div class="flex flex-wrap gap-3 sm:gap-4 mb-10 sm:mb-12">
            <a href="/admin/users" class="btn-primary px-5 sm:px-6 py-3 rounded-2xl text-sm"><i class="fas fa-users mr-2"></i>Manage Users</a>
            <button type="button" onclick="openNowWatchingModal()" class="btn-outline px-5 sm:px-6 py-3 rounded-2xl text-sm relative">
                <i class="fas fa-tv mr-2"></i>Now Watching
                <span id="nowWatchingCountBadge" class="hidden absolute -top-2 -right-2 w-5 h-5 rounded-full bg-sky-500 text-[#0b0f1a] text-[10px] font-bold flex items-center justify-center">0</span>
            </button>
            <a href="/admin/plans" class="btn-outline px-5 sm:px-6 py-3 rounded-2xl text-sm"><i class="fas fa-layer-group mr-2"></i>Manage Plans</a>
            <a href="/admin/tickets" class="btn-outline px-5 sm:px-6 py-3 rounded-2xl text-sm"><i class="fas fa-life-ring mr-2"></i>View Tickets</a>
        </div>

        <h2 class="text-sm uppercase tracking-widest text-slate-500 font-bold mb-4">Recent Action Requests</h2>
        <div class="glass rounded-2xl overflow-x-auto">
            <% if (recentActions.length === 0) { %>
                <p class="text-slate-500 text-sm p-6">No action requests yet.</p>
            <% } else { %>
                <table class="kb-table min-w-[560px]">
                    <thead><tr><th>User</th><th>Action</th><th>Time</th><th>Result</th></tr></thead>
                    <tbody>
                        <% recentActions.forEach(function(r) { %>
                            <tr>
                                <td><%= r.name %><br><span class="text-slate-500 text-xs"><%= r.email %></span></td>
                                <td class="text-slate-300"><%= r.action_label %></td>
                                <td class="text-slate-400"><%= formatUK(r.requested_at) %></td>
                                <td>
                                    <% if (r.success) { %>
                                        <span class="badge badge-active">Success</span>
                                    <% } else { %>
                                        <span class="badge badge-expired">Failed</span>
                                    <% } %>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            <% } %>
        </div>
    </main>

    <!-- Now Watching Modal -->
    <div id="nowWatchingModal" class="fixed inset-0 bg-black/70 backdrop-blur-sm hidden items-center justify-center z-50 px-4 py-8 overflow-y-auto">
        <div class="glass rounded-3xl p-6 sm:p-8 max-w-2xl w-full my-auto">
            <div class="flex items-center justify-between mb-5">
                <h3 class="text-lg font-bold text-white"><i class="fas fa-tv mr-2 text-sky-400"></i>Now Watching</h3>
                <button type="button" onclick="closeNowWatchingModal()" class="text-slate-400 hover:text-white w-8 h-8 flex items-center justify-center rounded-lg hover:bg-white/5">
                    <i class="fas fa-xmark"></i>
                </button>
            </div>
            <div id="nowWatchingModalContent" class="space-y-3">
                <p class="text-slate-500 text-sm"><i class="fas fa-circle-notch fa-spin mr-2"></i>Loading…</p>
            </div>
        </div>
    </div>

    <script>
        (async function loadServerData() {
            const grid = document.getElementById('serverDataGrid');
            const messageEl = document.getElementById('serverDataMessage');
            if (!grid) return;

            try {
                const res = await fetch('/admin/server-data/status');
                const data = await res.json();

                if (!data.ok) {
                    grid.classList.add('hidden');
                    if (messageEl) {
                        messageEl.classList.remove('hidden');
                        messageEl.innerHTML = (data.message || 'Could not load server data.') + ' Set it up in <a href="/admin/settings" class="text-sky-400 hover:text-sky-300">Settings</a>.';
                    }
                    return;
                }

                ['uptime', 'load', 'memory', 'disk'].forEach(function (key) {
                    const el = grid.querySelector('[data-server-stat="' + key + '"]');
                    if (el) el.textContent = data[key];
                });
            } catch (e) {
                grid.classList.add('hidden');
                if (messageEl) {
                    messageEl.classList.remove('hidden');
                    messageEl.textContent = 'Could not load server data.';
                }
            }
        })();

        (async function loadHealthSummary() {
            const grid = document.getElementById('healthSummaryGrid');
            if (!grid) return; // no containers configured - nothing to summarize

            try {
                const res = await fetch('/admin/health/status');
                const data = await res.json();
                if (!data.ok) return;

                const tally = { up: 0, unhealthy: 0, down: 0, unknown: 0 };
                data.containers.forEach(function (c) {
                    if (c.status === 'starting') { tally.unknown++; return; } // rare transient state, folded in
                    if (tally.hasOwnProperty(c.status)) tally[c.status]++;
                    else tally.unknown++;
                });

                Object.keys(tally).forEach(function (key) {
                    const el = grid.querySelector('[data-health-count="' + key + '"]');
                    if (el) el.textContent = tally[key];
                });
            } catch (e) {
                // leave placeholders as "—" on failure
            }
        })();

        // ---------- Now Watching (system-wide) ----------
        // One continuous poll drives both the button's count badge (always
        // running, so the number stays current even with the modal
        // closed) and the modal's full detail list (only rendered when
        // it's actually open) - avoids two separate timers hitting the
        // same endpoint at once when both happen to be active together.
        const mediaIconFor = function (type) {
            if (type === 'movie') return 'fa-film';
            if (type === 'episode') return 'fa-tv';
            if (type === 'track') return 'fa-music';
            return 'fa-play';
        };
        const stateBadgeFor = function (state) {
            if (state === 'playing') return ['badge-active', 'fa-circle-play', 'Playing'];
            if (state === 'buffering') return ['badge-suspended', 'fa-circle-notch fa-spin', 'Buffering'];
            return ['badge-closed', 'fa-circle-pause', 'Paused'];
        };

        function openNowWatchingModal() {
            openModal('nowWatchingModal');
            refreshNowWatching();
        }

        function closeNowWatchingModal() {
            closeModal('nowWatchingModal');
        }

        async function refreshNowWatching() {
            const countBadge = document.getElementById('nowWatchingCountBadge');
            const modal = document.getElementById('nowWatchingModal');
            const modalOpen = modal && !modal.classList.contains('hidden');
            const content = document.getElementById('nowWatchingModalContent');

            try {
                const res = await fetch('/admin/plex/now-watching-all');
                const data = await res.json();

                if (!data.ok) {
                    countBadge.classList.add('hidden');
                    if (modalOpen) content.innerHTML = '<p class="text-slate-500 text-sm">' + (data.message || 'Could not load current activity.') + '</p>';
                    return;
                }

                const count = data.items ? data.items.length : 0;
                if (count > 0) {
                    countBadge.textContent = count;
                    countBadge.classList.remove('hidden');
                } else {
                    countBadge.classList.add('hidden');
                }

                if (!modalOpen) return; // count is all that needs updating while it's closed

                if (count === 0) {
                    content.innerHTML = '<p class="text-slate-500 text-sm">Nobody is watching anything right now.</p>';
                    return;
                }

                content.innerHTML = data.items.map(function (item) {
                    const badge = stateBadgeFor(item.state);
                    const icon = mediaIconFor(item.mediaType);
                    const poster = item.posterUrl
                        ? '<img src="' + item.posterUrl + '" alt="" class="w-14 h-20 rounded-lg object-cover flex-shrink-0 bg-slate-800" onerror="this.style.display=\'none\'">'
                        : '<div class="w-14 h-20 rounded-lg bg-slate-800 flex items-center justify-center flex-shrink-0"><i class="fas ' + icon + ' text-slate-600"></i></div>';
                    const meta = [item.device, item.client].filter(Boolean).join(' — ');
                    return '<div class="flex items-center gap-4 bg-slate-900/40 rounded-2xl p-4">' +
                        poster +
                        '<div class="flex-1 min-w-0">' +
                        '<div class="flex items-center gap-2 flex-wrap mb-1">' +
                        '<span class="text-white font-bold text-sm">' + item.subscriberName + '</span>' +
                        '<span class="badge ' + badge[0] + '"><i class="fas ' + badge[1] + '"></i> ' + badge[2] + '</span>' +
                        '</div>' +
                        '<p class="text-slate-300 text-sm truncate">' + item.title + '</p>' +
                        (meta ? '<p class="text-slate-500 text-xs mt-1"><i class="fas fa-tablet-screen-button mr-1"></i>' + meta + '</p>' : '') +
                        (item.location ? '<p class="text-slate-500 text-xs mt-1"><i class="fas fa-location-dot mr-1"></i>' + item.location + '</p>' : '') +
                        '<div class="w-full bg-slate-800 rounded-full h-1.5 mt-2">' +
                        '<div class="bg-sky-500 h-1.5 rounded-full" style="width:' + Math.max(0, Math.min(100, item.progressPercent)) + '%"></div>' +
                        '</div>' +
                        '<p class="text-slate-500 text-xs mt-1">' + Math.round(item.progressPercent) + '% watched</p>' +
                        '</div></div>';
                }).join('');
            } catch (e) {
                if (modalOpen) content.innerHTML = '<p class="text-slate-500 text-sm">Could not load current activity.</p>';
            }
        }

        refreshNowWatching();
        setInterval(refreshNowWatching, 15000);
    </script>
</body>
</html>
