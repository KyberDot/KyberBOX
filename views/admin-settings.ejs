<!DOCTYPE html>
<html lang="en">
<head>
    <% pageTitle = 'Settings' %>
    <%- include('partials/head') %>
</head>
<body class="antialiased overflow-x-hidden">
    <%- include('partials/nav') %>

    <main class="max-w-3xl mx-auto px-4 sm:px-6 py-8 sm:py-10 pb-24">
        <h1 class="text-2xl sm:text-3xl font-extrabold mb-8">Settings</h1>

        <% if (saved) { %>
            <div class="mb-6 px-4 py-3 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-sm">
                <i class="fas fa-circle-check mr-2"></i>Settings saved.
            </div>
        <% } %>
        <% if (testResult) { %>
            <div class="mb-6 px-4 py-3 rounded-xl <%= testResult.sent ? 'bg-emerald-500/10 border border-emerald-500/30 text-emerald-400' : 'bg-red-500/10 border border-red-500/30 text-red-400' %> text-sm">
                <i class="fas <%= testResult.sent ? 'fa-circle-check' : 'fa-triangle-exclamation' %> mr-2"></i>
                <%= testResult.sent ? 'Test email sent — check your inbox.' : ('Failed to send: ' + testResult.reason) %>
            </div>
        <% } %>

        <% if (typeof brandingError !== 'undefined' && brandingError) { %>
            <div class="mb-6 px-4 py-3 rounded-xl bg-red-500/10 border border-red-500/30 text-red-400 text-sm">
                <i class="fas fa-triangle-exclamation mr-2"></i><%= brandingError %>
            </div>
        <% } %>

        <% if (typeof adminActionResult !== 'undefined' && adminActionResult) { %>
            <div class="mb-6 px-4 py-3 rounded-xl <%= adminActionResult.ok ? 'bg-emerald-500/10 border border-emerald-500/30 text-emerald-400' : 'bg-red-500/10 border border-red-500/30 text-red-400' %> text-sm">
                <i class="fas <%= adminActionResult.ok ? 'fa-circle-check' : 'fa-triangle-exclamation' %> mr-2"></i><%= adminActionResult.message %>
            </div>
        <% } %>

        <!-- Admins -->
        <div class="glass rounded-2xl sm:rounded-3xl p-5 sm:p-8 mb-8">
            <h2 class="text-lg font-bold text-white mb-1"><i class="fas fa-user-shield mr-2 text-sky-400"></i>Admins</h2>
            <p class="text-slate-400 text-sm mb-5">Full access admins can do anything, including manage other admins. Limited access admins can only see the specific pages granted below.</p>

            <div class="space-y-3 mb-6">
                <% admins.forEach(function(admin) { %>
                    <details class="bg-slate-900/40 rounded-xl px-4 py-3" data-ajax-key="admin-<%= admin.id %>">
                        <summary class="cursor-pointer flex items-center justify-between gap-3 flex-wrap">
                            <span class="text-sm">
                                <span class="text-white font-semibold"><%= admin.name %></span>
                                <span class="text-slate-500 ml-2"><%= admin.email %></span>
                            </span>
                            <% if (admin.admin_access_mode === 'full') { %>
                                <span class="badge badge-active"><i class="fas fa-crown"></i> Full Access</span>
                            <% } else { %>
                                <span class="badge badge-suspended"><i class="fas fa-lock"></i> Limited: <%= admin.pages.length > 0 ? admin.pages.join(', ') : 'nothing yet' %></span>
                            <% } %>
                        </summary>

                        <form method="POST" action="/admin/admins/<%= admin.id %>/access" data-ajax-form class="mt-4 pt-4 border-t border-white/5">
                            <label class="text-xs uppercase tracking-widest text-slate-500 font-semibold mb-2 block">Access Level</label>
                            <select name="access_mode" class="input mb-3" onchange="document.getElementById('admin-pages-<%= admin.id %>').classList.toggle('hidden', this.value !== 'limited')">
                                <option value="full" <%= admin.admin_access_mode === 'full' ? 'selected' : '' %>>Full Access (everything, including managing other admins)</option>
                                <option value="limited" <%= admin.admin_access_mode === 'limited' ? 'selected' : '' %>>Limited (only selected pages below)</option>
                            </select>
                            <div id="admin-pages-<%= admin.id %>" class="grid sm:grid-cols-3 gap-2 mb-4 <%= admin.admin_access_mode === 'limited' ? '' : 'hidden' %>">
                                <% ['overview', 'users', 'plans', 'health', 'settings', 'tickets', 'storage', 'providers'].forEach(function(page) { %>
                                    <label class="flex items-center gap-2 bg-slate-900/60 rounded-lg px-3 py-2 text-xs text-slate-300 cursor-pointer">
                                        <input type="checkbox" name="pages" value="<%= page %>" <%= admin.pages.indexOf(page) !== -1 ? 'checked' : '' %> class="accent-sky-500">
                                        <%= page.charAt(0).toUpperCase() + page.slice(1) %>
                                    </label>
                                <% }); %>
                            </div>
                            <div class="flex flex-wrap gap-2">
                                <button type="submit" class="btn-primary py-2 px-4 rounded-lg text-xs">Save Access</button>
                                <% if (admin.id !== currentUser.id) { %>
                                    <button type="submit" formaction="/admin/admins/<%= admin.id %>/delete" data-confirm="Remove <%= admin.name %> as an admin? This can't be undone." class="text-red-400 hover:text-red-300 text-xs bg-red-500/10 px-4 py-2 rounded-lg">Remove Admin</button>
                                <% } %>
                            </div>
                        </form>
                    </details>
                <% }); %>
            </div>

            <details data-ajax-key="invite-admin">
                <summary class="cursor-pointer text-sky-400 text-xs font-semibold uppercase tracking-wide">Invite a New Admin</summary>
                <form method="POST" action="/admin/admins/invite" data-ajax-form class="grid sm:grid-cols-2 gap-3 mt-3">
                    <input type="text" name="name" required class="input" placeholder="Name">
                    <input type="email" name="email" required class="input" placeholder="Email address">
                    <select name="access_mode" class="input sm:col-span-2" onchange="document.getElementById('invite-admin-pages').classList.toggle('hidden', this.value !== 'limited')">
                        <option value="full">Full Access (everything, including managing other admins)</option>
                        <option value="limited" selected>Limited (only selected pages below)</option>
                    </select>
                    <div id="invite-admin-pages" class="grid sm:grid-cols-3 gap-2 sm:col-span-2">
                        <% ['overview', 'users', 'plans', 'health', 'settings', 'tickets', 'storage', 'providers'].forEach(function(page) { %>
                            <label class="flex items-center gap-2 bg-slate-900/40 rounded-lg px-3 py-2 text-xs text-slate-300 cursor-pointer">
                                <input type="checkbox" name="pages" value="<%= page %>" class="accent-sky-500">
                                <%= page.charAt(0).toUpperCase() + page.slice(1) %>
                            </label>
                        <% }); %>
                    </div>
                    <button type="submit" class="btn-primary py-3 rounded-xl text-sm sm:col-span-2">Send Invite</button>
                </form>
            </details>
        </div>

        <!-- General -->
        <div class="glass rounded-2xl sm:rounded-3xl p-5 sm:p-8 mb-8">
            <h2 class="text-lg font-bold text-white mb-4"><i class="fas fa-sliders mr-2 text-sky-400"></i>General</h2>
            <form method="POST" action="/admin/settings/general" data-ajax-form class="space-y-4">
                <div>
                    <label class="text-xs uppercase tracking-widest text-slate-500 font-semibold mb-2 block">Site Name</label>
                    <input type="text" name="site_name" class="input" value="<%= settings.site_name %>">
                </div>
                <div>
                    <label class="text-xs uppercase tracking-widest text-slate-500 font-semibold mb-2 block">Public Site URL</label>
                    <input type="text" name="site_url" class="input" placeholder="https://portal.kyberbox.app" value="<%= settings.site_url %>">
                    <p class="text-slate-500 text-xs mt-2">Used to build links in emails (invites, password resets, ticket notifications). Leave blank to auto-detect from incoming requests.</p>
                </div>
                <button type="submit" class="btn-primary px-6 py-3 rounded-xl text-sm">Save General Settings</button>
            </form>
        </div>

        <!-- Branding -->
        <div class="glass rounded-2xl sm:rounded-3xl p-5 sm:p-8 mb-8">
            <h2 class="text-lg font-bold text-white mb-1"><i class="fas fa-icons mr-2 text-sky-400"></i>Branding</h2>
            <p class="text-slate-400 text-sm mb-4">Browser favicon, and the icon used when a client adds this site to their iPhone home screen via Safari.</p>
            <form method="POST" action="/admin/settings/branding" enctype="multipart/form-data" data-ajax-form class="grid sm:grid-cols-2 gap-6">
                <div>
                    <label class="text-xs uppercase tracking-widest text-slate-500 font-semibold mb-2 block">Favicon</label>
                    <div class="flex items-center gap-3 mb-3">
                        <img src="<%= faviconPath %>" alt="Current favicon" class="w-8 h-8 rounded bg-slate-800 object-contain">
                        <span class="text-slate-500 text-xs">Current favicon</span>
                    </div>
                    <input type="file" name="favicon" accept="image/png,image/x-icon,image/vnd.microsoft.icon,.ico,image/svg+xml">
                    <p class="text-slate-500 text-xs mt-2">PNG or ICO recommended, square, at least 32×32.</p>
                </div>
                <div>
                    <label class="text-xs uppercase tracking-widest text-slate-500 font-semibold mb-2 block">Apple Touch Icon (iOS "Add to Home Screen")</label>
                    <div class="flex items-center gap-3 mb-3">
                        <img src="<%= appleIconPath %>" alt="Current apple touch icon" class="w-8 h-8 rounded bg-slate-800 object-contain">
                        <span class="text-slate-500 text-xs">Current icon</span>
                    </div>
                    <input type="file" name="apple_icon" accept="image/png,image/jpeg">
                    <p class="text-slate-500 text-xs mt-2">PNG recommended, square, 180×180 works best - this is what shows on a client's phone when they add the site to their home screen in Safari.</p>
                </div>
                <button type="submit" class="btn-primary px-6 py-3 rounded-xl text-sm sm:col-span-2">
                    <i class="fas fa-upload mr-2"></i>Upload
                </button>
            </form>
        </div>

        <!-- Health Page SSH -->
        <div class="glass rounded-2xl sm:rounded-3xl p-5 sm:p-8 mb-8">
            <h2 class="text-lg font-bold text-white mb-1"><i class="fas fa-terminal mr-2 text-sky-400"></i>Server Access (Health &amp; SSH Console)</h2>
            <p class="text-slate-400 text-sm mb-4">Used by Admin → Health and Admin → SSH Console to check container status and run commands. Separate from any plan's own SSH access.</p>
            <form method="POST" action="/admin/settings/health-ssh" data-ajax-form class="grid sm:grid-cols-3 gap-3">
                <input type="text" name="host" required class="input" placeholder="Host / IP" value="<%= healthSsh ? healthSsh.host : '' %>">
                <input type="number" name="port" class="input" placeholder="Port (22)" value="<%= healthSsh ? healthSsh.port : 22 %>">
                <input type="text" name="username" required class="input" placeholder="SSH username" value="<%= healthSsh ? healthSsh.username : '' %>">
                <select name="auth_type" class="input sm:col-span-3">
                    <option value="password" <%= healthSsh && healthSsh.auth_type === 'password' ? 'selected' : '' %>>Password</option>
                    <option value="key" <%= healthSsh && healthSsh.auth_type === 'key' ? 'selected' : '' %>>Private Key</option>
                </select>
                <textarea name="secret" rows="2" class="input sm:col-span-3" placeholder="Password or private key (leave blank to keep current)"></textarea>
                <div class="sm:col-span-3">
                    <label class="text-xs uppercase tracking-widest text-slate-500 font-semibold mb-1.5 block">Docker Compose Path</label>
                    <input type="text" name="compose_path" class="input" placeholder="/opt/media-stack" value="<%= settings.compose_path %>">
                    <p class="text-slate-500 text-xs mt-2">The folder on this server containing your docker-compose.yml — used by the "Full Reset &amp; Update" button on the Health page (runs <code class="font-mono">docker compose down</code>, <code class="font-mono">pull</code>, then <code class="font-mono">up -d</code> there, in that order). KyberBOX should live in its own separate compose file/stack, not this one, so a full reset here never affects the portal itself.</p>
                </div>
                <button type="submit" class="btn-primary py-3 rounded-xl text-sm sm:col-span-3">
                    <i class="fas fa-lock mr-2"></i>Save (encrypted at rest)
                </button>
            </form>
            <p class="text-slate-500 text-xs mt-4">Manage which containers show up on the Health page from <a href="/admin/health" class="text-sky-400 hover:text-sky-300">Admin → Health</a>, or run one-off commands from <a href="/admin/ssh-console" class="text-sky-400 hover:text-sky-300">Admin → SSH Console</a>.</p>

            <div class="mt-6 pt-6 border-t border-white/5">
                <h3 class="text-sm font-bold text-white mb-1"><i class="fas fa-eye mr-2 text-sky-400"></i>Stuck-Mount Watchdog</h3>
                <p class="text-slate-400 text-xs mb-4">Checks a container's recent startup logs every few minutes for a script stuck waiting on the same step (e.g. mounts never coming up) and automatically runs a Full Reset if it's been stuck for ~15 minutes straight. Built for mount-checker scripts that print repeated "⏳ waiting..." lines while a dependency is down, followed by a distinct line once everything's actually up. Add one watch per container.</p>

                <div class="space-y-2 mb-4">
                    <% stuckWatches.forEach(function(w) { %>
                        <div class="flex items-center justify-between gap-3 bg-slate-900/40 rounded-xl px-3 py-2.5 text-xs">
                            <span class="min-w-0">
                                <span class="text-white font-semibold"><%= w.service_label %></span>
                                <span class="text-slate-500 ml-2 font-mono"><%= w.container_name %></span>
                                <% if (w.last_status === 'ok') { %>
                                    <span class="badge badge-active ml-2">ok</span>
                                <% } else if (w.last_status === 'waiting') { %>
                                    <span class="badge badge-suspended ml-2">stuck <%= w.consecutive_stuck_checks %>/3</span>
                                <% } else { %>
                                    <span class="badge badge-closed ml-2">unknown</span>
                                <% } %>
                            </span>
                            <form method="POST" action="/admin/settings/stuck-watch/<%= w.id %>/delete" data-ajax-form>
                                <button type="submit" class="text-red-400 hover:text-red-300 flex-shrink-0"><i class="fas fa-trash"></i></button>
                            </form>
                        </div>
                    <% }); %>
                    <% if (stuckWatches.length === 0) { %>
                        <p class="text-slate-500 text-sm">No containers being watched yet.</p>
                    <% } %>
                </div>

                <details data-ajax-key="stuck-watch-add">
                    <summary class="cursor-pointer text-sky-400 text-xs font-semibold uppercase tracking-wide">Add a Watch</summary>
                    <form method="POST" action="/admin/settings/stuck-watch" data-ajax-form class="grid sm:grid-cols-2 gap-3 mt-3">
                        <select name="preset" class="input" onchange="
                            const marker = document.getElementById('stuckWatchMarker');
                            const label = document.getElementById('stuckWatchLabel');
                            if (this.value === 'plex') { marker.value = 'Starting Plex Media Server'; label.value = 'Plex'; }
                            else if (this.value === 'jellyfin') { marker.value = 'Starting Jellyfin Media Server'; label.value = 'Jellyfin'; }
                            else { marker.value = ''; label.value = ''; }
                        ">
                            <option value="custom">Custom / Other</option>
                            <option value="plex">Plex (mount-checker script)</option>
                            <option value="jellyfin">Jellyfin (mount-checker script)</option>
                        </select>
                        <input type="text" name="container_name" required class="input" placeholder="Exact container name (e.g. plex)">
                        <input type="text" name="service_label" id="stuckWatchLabel" required class="input" placeholder="Display name (e.g. Plex)">
                        <input type="text" name="success_marker" id="stuckWatchMarker" required class="input sm:col-span-2" placeholder="Exact line the script prints once healthy (e.g. Starting Plex Media Server)">
                        <button type="submit" class="btn-primary py-3 rounded-xl text-sm sm:col-span-2">Add Watch</button>
                    </form>
                </details>
            </div>
        </div>

        <!-- VPN Guard Watchdog -->
        <div class="glass rounded-2xl sm:rounded-3xl p-5 sm:p-8 mb-8">
            <h3 class="text-sm font-bold text-white mb-1"><i class="fas fa-shield-halved mr-2 text-sky-400"></i>VPN Guard Watchdog</h3>
            <p class="text-slate-400 text-xs mb-4">For containers that run a VPN-check script before launching their real service, refusing to start until a VPN tunnel is confirmed up. Adds a live status tag on the Health page - green once connected, red if the container reports the VPN failed. A failure emails every admin account once (not repeatedly while it stays down).</p>

            <div class="space-y-2 mb-4">
                <% vpnWatches.forEach(function(w) { %>
                    <div class="flex items-center justify-between gap-3 bg-slate-900/40 rounded-xl px-3 py-2.5 text-xs">
                        <span class="min-w-0">
                            <span class="text-white font-semibold"><%= w.service_label %></span>
                            <span class="text-slate-500 ml-2 font-mono"><%= w.container_name %></span>
                            <% if (w.last_status === 'active') { %>
                                <span class="badge badge-active ml-2">VPN Active</span>
                            <% } else if (w.last_status === 'inactive') { %>
                                <span class="badge badge-expired ml-2">VPN Inactive</span>
                            <% } else { %>
                                <span class="badge badge-closed ml-2">VPN Unknown</span>
                            <% } %>
                        </span>
                        <form method="POST" action="/admin/settings/vpn-watch/<%= w.id %>/delete" data-ajax-form>
                            <button type="submit" class="text-red-400 hover:text-red-300 flex-shrink-0"><i class="fas fa-trash"></i></button>
                        </form>
                    </div>
                <% }); %>
                <% if (vpnWatches.length === 0) { %>
                    <p class="text-slate-500 text-sm">No containers being watched yet.</p>
                <% } %>
            </div>

            <details data-ajax-key="vpn-watch-add">
                <summary class="cursor-pointer text-sky-400 text-xs font-semibold uppercase tracking-wide">Add a Watch</summary>
                <form method="POST" action="/admin/settings/vpn-watch" data-ajax-form class="grid sm:grid-cols-2 gap-3 mt-3">
                    <input type="text" name="container_name" required class="input" placeholder="Exact container name (e.g. decypharr)">
                    <input type="text" name="service_label" required class="input" placeholder="Display name (e.g. Decypharr)">
                    <button type="submit" class="btn-primary py-3 rounded-xl text-sm sm:col-span-2">Add Watch</button>
                </form>
            </details>
        </div>

        <!-- Email Watchdog Notifications -->
        <div class="glass rounded-2xl sm:rounded-3xl p-5 sm:p-8 mb-8">
            <h3 class="text-sm font-bold text-white mb-1"><i class="fas fa-bell mr-2 text-sky-400"></i>Email Watchdog Notifications</h3>
            <p class="text-slate-400 text-xs mb-4">Turn any of KyberBOX's admin notification emails on or off. New notification features land here going forward, rather than scattered across settings.</p>

            <div class="pb-5 mb-5 border-b border-white/5">
                <form method="POST" action="/admin/settings/provider-notifications" data-ajax-form class="flex items-start justify-between gap-4">
                    <div class="min-w-0">
                        <p class="text-white text-sm font-semibold">Provider Expiry Notifications</p>
                        <p class="text-slate-500 text-xs mt-0.5">Emails every admin when a Providers page entry tracking an expiry date is within 2 days of it.</p>
                    </div>
                    <label class="flex items-center gap-2 flex-shrink-0 cursor-pointer">
                        <input type="checkbox" name="enabled" value="1" <%= settings.provider_expiry_notifications_enabled === '1' ? 'checked' : '' %> onchange="this.form.requestSubmit()" class="accent-sky-500 w-4 h-4">
                        <span class="text-xs text-slate-400">Enabled</span>
                    </label>
                </form>
            </div>

            <form method="POST" action="/admin/settings/container-watchdog" data-ajax-form>
                <div class="flex items-start justify-between gap-4 mb-4">
                    <div class="min-w-0">
                        <p class="text-white text-sm font-semibold">Container Health Watchdog</p>
                        <p class="text-slate-500 text-xs mt-0.5">Emails every admin once if a container is offline or unhealthy for over 2 minutes, outside of a restart/update triggered from KyberBOX itself.</p>
                    </div>
                    <label class="flex items-center gap-2 flex-shrink-0 cursor-pointer">
                        <input type="checkbox" name="enabled" value="1" <%= settings.container_watchdog_enabled === '1' ? 'checked' : '' %> class="accent-sky-500 w-4 h-4">
                        <span class="text-xs text-slate-400">Enabled</span>
                    </label>
                </div>

                <% if (healthContainers.length === 0) { %>
                    <p class="text-slate-500 text-xs mb-4">No containers added yet — add some on the <a href="/admin/health" class="text-sky-400 hover:text-sky-300">Health page</a> first.</p>
                <% } else { %>
                    <div class="flex items-center gap-4 mb-3 text-xs">
                        <label class="flex items-center gap-1.5 cursor-pointer">
                            <input type="radio" name="mode" value="all" <%= settings.container_watchdog_mode !== 'selected' ? 'checked' : '' %> onchange="toggleContainerWatchdogList(false)" class="accent-sky-500">
                            <span class="text-slate-300">All containers</span>
                        </label>
                        <label class="flex items-center gap-1.5 cursor-pointer">
                            <input type="radio" name="mode" value="selected" <%= settings.container_watchdog_mode === 'selected' ? 'checked' : '' %> onchange="toggleContainerWatchdogList(true)" class="accent-sky-500">
                            <span class="text-slate-300">Specific containers</span>
                        </label>
                    </div>

                    <div id="containerWatchdogList" class="<%= settings.container_watchdog_mode === 'selected' ? '' : 'hidden' %> grid sm:grid-cols-2 gap-2 mb-4">
                        <% healthContainers.forEach(function(c) { %>
                            <label class="flex items-center gap-2 bg-slate-900/40 rounded-lg px-3 py-2 text-xs cursor-pointer">
                                <input type="checkbox" name="container_ids" value="<%= c.id %>" <%= watchedContainerIds.has(c.id) ? 'checked' : '' %> class="accent-sky-500 flex-shrink-0">
                                <span class="text-slate-300 truncate"><%= c.label %></span>
                                <span class="text-slate-600 font-mono truncate">(<%= c.container_name %>)</span>
                            </label>
                        <% }); %>
                    </div>
                <% } %>

                <div class="flex items-start justify-between gap-4 pt-4 mt-4 border-t border-white/5 mb-4">
                    <div class="min-w-0">
                        <p class="text-white text-sm font-semibold">VPN Guard Watchdog Notifications</p>
                        <p class="text-slate-500 text-xs mt-0.5">Emails every admin once if a watched container's VPN has been inactive for over 2 minutes while the container itself is running.</p>
                    </div>
                    <label class="flex items-center gap-2 flex-shrink-0 cursor-pointer">
                        <input type="checkbox" name="vpn_enabled" value="1" <%= settings.vpn_watchdog_enabled === '1' ? 'checked' : '' %> class="accent-sky-500 w-4 h-4">
                        <span class="text-xs text-slate-400">Enabled</span>
                    </label>
                </div>

                <button type="submit" class="btn-primary px-6 py-3 rounded-xl text-sm">Save</button>
            </form>
        </div>

        <!-- Payment Methods -->
        <div class="glass rounded-2xl sm:rounded-3xl p-5 sm:p-8 mb-8">
            <h2 class="text-lg font-bold text-white mb-1"><i class="fas fa-credit-card mr-2 text-sky-400"></i>Payment Methods</h2>
            <p class="text-slate-400 text-sm mb-4">Names only for now — assign one to each client from Admin → Users.</p>
            <div class="flex flex-wrap gap-2 mb-4">
                <% paymentMethods.forEach(function(pm) { %>
                    <form method="POST" action="/admin/settings/payment-methods/<%= pm.id %>/delete" data-ajax-form data-confirm="Delete this payment method? Any clients using it will be unassigned." class="flex items-center gap-2 bg-slate-900/40 rounded-lg px-3 py-2 text-xs text-slate-300">
                        <span><%= pm.name %></span>
                        <button type="submit" class="text-red-400 hover:text-red-300"><i class="fas fa-trash"></i></button>
                    </form>
                <% }); %>
                <% if (paymentMethods.length === 0) { %>
                    <p class="text-slate-500 text-sm">No payment methods added yet.</p>
                <% } %>
            </div>
            <form method="POST" action="/admin/settings/payment-methods" data-ajax-form class="flex flex-col sm:flex-row gap-3">
                <input type="text" name="name" required class="input" placeholder="Payment method name (e.g. Bank Transfer, PayPal)">
                <button type="submit" class="btn-primary px-6 py-3 rounded-xl text-sm whitespace-nowrap">Add Method</button>
            </form>
        </div>

        <!-- Tautulli -->
        <div class="glass rounded-2xl sm:rounded-3xl p-5 sm:p-8 mb-8">
            <h2 class="text-lg font-bold text-white mb-1"><i class="fas fa-chart-simple mr-2 text-sky-400"></i>Tautulli (Plex Watch History)</h2>
            <p class="text-slate-400 text-sm mb-4">Lets subscribers on a Plex plan see their own recent watch history on their dashboard. Reachable at the container's internal address if Tautulli is on the same Docker network (e.g. <code class="font-mono">http://tautulli:8181</code>), or its full URL otherwise.</p>
            <% if (typeof tautulliTestResult !== 'undefined' && tautulliTestResult) { %>
                <div class="mb-4 px-4 py-3 rounded-xl <%= tautulliTestResult.ok ? 'bg-emerald-500/10 border border-emerald-500/30 text-emerald-400' : 'bg-red-500/10 border border-red-500/30 text-red-400' %> text-sm">
                    <i class="fas <%= tautulliTestResult.ok ? 'fa-circle-check' : 'fa-triangle-exclamation' %> mr-2"></i><%= tautulliTestResult.message %>
                </div>
            <% } %>
            <form method="POST" action="/admin/settings/tautulli" data-ajax-form class="grid sm:grid-cols-2 gap-4">
                <input type="text" name="tautulli_url" class="input sm:col-span-2" placeholder="http://tautulli:8181" value="<%= settings.tautulli_url %>">
                <input type="password" name="tautulli_api_key" class="input sm:col-span-2" placeholder="API key (leave blank to keep current) - found in Tautulli under Settings → Web Interface">
                <button type="submit" class="btn-primary px-6 py-3 rounded-xl text-sm">Save Tautulli Settings</button>
            </form>
            <form method="POST" action="/admin/settings/tautulli/test" data-ajax-form class="mt-4">
                <button type="submit" class="btn-outline px-6 py-3 rounded-xl text-sm">
                    <i class="fas fa-plug mr-2"></i>Test Connection
                </button>
            </form>
            <p class="text-slate-500 text-xs mt-4">Each client's Plex username still needs linking individually from <a href="/admin/users" class="text-sky-400 hover:text-sky-300">Admin → Users</a> before they'll see anything.</p>
        </div>

        <!-- Library Data Order -->
        <div class="glass rounded-2xl sm:rounded-3xl p-5 sm:p-8 mb-8">
            <h2 class="text-lg font-bold text-white mb-1"><i class="fas fa-arrows-up-down-left-right mr-2 text-sky-400"></i>Library Data Order</h2>
            <p class="text-slate-400 text-sm mb-4">Drag to reorder how libraries appear in the Library Data section on the Overview dashboard.</p>
            <div id="libraryOrderList" class="space-y-2">
                <p class="text-slate-500 text-xs">Loading libraries…</p>
            </div>
        </div>

        <!-- Dashboard Sections -->
        <div class="glass rounded-2xl sm:rounded-3xl p-5 sm:p-8 mb-8">
            <h2 class="text-lg font-bold text-white mb-1"><i class="fas fa-table-cells-large mr-2 text-sky-400"></i>Dashboard Sections</h2>
            <p class="text-slate-400 text-sm mb-4">Drag to reorder, or click a badge to toggle it off, the sections shown on the Admin Overview dashboard.</p>
            <div id="dashboardSectionsList" class="space-y-2">
                <%
                var dashboardSectionLabels = { server_data: 'Server Data', container_health: 'Container Health', account_overview: 'Account Overview', stream_data: 'Stream Data', library_data: 'Library Data' };
                var dashboardSectionsConfig;
                try {
                    dashboardSectionsConfig = JSON.parse(settings.dashboard_sections_config);
                    if (!Array.isArray(dashboardSectionsConfig)) throw new Error('not an array');
                } catch (e) {
                    dashboardSectionsConfig = Object.keys(dashboardSectionLabels).map(function (key) { return { key: key, enabled: true }; });
                }
                %>
                <% dashboardSectionsConfig.forEach(function (section) { %>
                    <div class="flex items-center gap-2 bg-slate-900/40 rounded-xl px-3 py-2.5" data-dashboard-section-row="<%= section.key %>" draggable="true" ondragstart="dashboardSectionDragStart(event)" ondragover="dashboardSectionDragOver(event)" ondrop="dashboardSectionDrop(event)" ondragend="dashboardSectionDragEnd(event)">
                        <i class="fas fa-grip-vertical text-slate-600 flex-shrink-0" title="Drag to reorder" style="cursor: grab;"></i>
                        <span class="text-white text-sm font-semibold flex-1"><%= dashboardSectionLabels[section.key] || section.key %></span>
                        <button type="button" onclick="toggleDashboardSectionEnabled(this)" data-enabled="<%= section.enabled !== false ? '1' : '0' %>" class="badge <%= section.enabled !== false ? 'badge-active' : 'badge-closed' %> text-[10px] px-3 py-1 cursor-pointer flex-shrink-0"><%= section.enabled !== false ? 'Enabled' : 'Disabled' %></button>
                    </div>
                <% }); %>
            </div>
        </div>

        <!-- Mail -->
        <div class="glass rounded-2xl sm:rounded-3xl p-5 sm:p-8 mb-8">
            <h2 class="text-lg font-bold text-white mb-1"><i class="fas fa-envelope mr-2 text-sky-400"></i>Mail (SMTP)</h2>
            <p class="text-slate-400 text-sm mb-4">Used for client invites, password resets, ticket notifications, and maintenance-mode alerts.</p>

            <div class="flex flex-wrap items-center gap-3 mb-2">
                <button type="button" onclick="toggleEmailCategory(this, 'user')" data-enabled="<%= settings.user_emails_enabled === '1' ? '1' : '0' %>" class="badge <%= settings.user_emails_enabled === '1' ? 'badge-active' : 'badge-closed' %> text-[10px] px-3 py-1.5 cursor-pointer">
                    <i class="fas fa-users mr-1"></i>User Emails: <%= settings.user_emails_enabled === '1' ? 'Enabled' : 'Disabled' %>
                </button>
                <button type="button" onclick="toggleEmailCategory(this, 'admin')" data-enabled="<%= settings.admin_emails_enabled === '1' ? '1' : '0' %>" class="badge <%= settings.admin_emails_enabled === '1' ? 'badge-active' : 'badge-closed' %> text-[10px] px-3 py-1.5 cursor-pointer">
                    <i class="fas fa-user-shield mr-1"></i>Admin Emails: <%= settings.admin_emails_enabled === '1' ? 'Enabled' : 'Disabled' %>
                </button>
            </div>
            <p class="text-slate-500 text-xs mb-5">Turning one off only stops emails in that category from sending - every background process (watchdogs, monitoring, expiry checks, etc) keeps running exactly as before. Turn it back on any time to resume.</p>

            <form method="POST" action="/admin/settings/mail" data-ajax-form class="grid md:grid-cols-2 gap-4">
                <input type="text" name="smtp_host" class="input" placeholder="SMTP host (e.g. smtp.gmail.com)" value="<%= settings.smtp_host %>">
                <input type="number" name="smtp_port" class="input" placeholder="Port (587)" value="<%= settings.smtp_port %>">
                <input type="text" name="smtp_user" class="input" placeholder="SMTP username" value="<%= settings.smtp_user %>">
                <input type="password" name="smtp_pass" class="input" placeholder="SMTP password (leave blank to keep current)">
                <input type="text" name="smtp_from_name" class="input" placeholder="From name" value="<%= settings.smtp_from_name %>">
                <input type="email" name="smtp_from_email" class="input" placeholder="From email address" value="<%= settings.smtp_from_email %>">
                <label class="flex items-center gap-2 text-sm text-slate-400 md:col-span-2">
                    <input type="checkbox" name="smtp_secure" value="1" <%= (settings.smtp_secure === '1') ? 'checked' : '' %>>
                    Use implicit TLS (port 465). Leave unchecked for STARTTLS (port 587).
                </label>
                <button type="submit" class="btn-primary px-6 py-3 rounded-xl text-sm md:col-span-2">Save Mail Settings</button>
            </form>
            <form method="POST" action="/admin/settings/test-email" data-ajax-form class="mt-4">
                <button type="submit" class="btn-outline px-6 py-3 rounded-xl text-sm">
                    <i class="fas fa-paper-plane mr-2"></i>Send Test Email to Myself
                </button>
            </form>
        </div>
    </main>

    <script>
        function toggleContainerWatchdogList(showList) {
            const list = document.getElementById('containerWatchdogList');
            if (list) list.classList.toggle('hidden', !showList);
        }

        // ---------- Library Data Order ----------
        let libraryDragState = null;

        async function loadLibraryOrderList() {
            const list = document.getElementById('libraryOrderList');
            if (!list) return;
            try {
                const res = await fetch('/admin/overview/library-data');
                const data = await res.json();
                if (!data.ok || !data.libraries || data.libraries.length === 0) {
                    list.innerHTML = '<p class="text-slate-500 text-xs">No libraries found - make sure Tautulli is connected above.</p>';
                    return;
                }
                const icons = { movie: 'fa-film', show: 'fa-tv' };
                list.innerHTML = data.libraries.map(function (lib) {
                    const icon = icons[lib.type] || 'fa-photo-film';
                    const safeName = String(lib.name).replace(/</g, '&lt;');
                    return '<div class="flex items-center gap-2 bg-slate-900/40 rounded-xl px-3 py-2.5" data-library-row="' + lib.sectionId + '" draggable="true" ondragstart="libraryDragStart(event)" ondragover="libraryDragOver(event)" ondrop="libraryDrop(event)" ondragend="libraryDragEnd(event)">'
                        + '<i class="fas fa-grip-vertical text-slate-600 flex-shrink-0" title="Drag to reorder" style="cursor: grab;"></i>'
                        + '<i class="fas ' + icon + ' text-sky-400 flex-shrink-0"></i>'
                        + '<span class="text-white text-sm font-semibold truncate flex-1">' + safeName + '</span>'
                        + '<span class="text-slate-500 text-xs font-mono flex-shrink-0">' + lib.count.toLocaleString() + '</span>'
                        + '</div>';
                }).join('');
            } catch (e) {
                list.innerHTML = '<p class="text-red-400 text-xs">Could not load libraries.</p>';
            }
        }

        function libraryDragStart(event) {
            libraryDragState = event.currentTarget;
            event.currentTarget.classList.add('opacity-40');
            event.dataTransfer.effectAllowed = 'move';
            event.dataTransfer.setData('text/plain', ''); // some browsers require this for drag to initiate at all
        }

        function libraryDragOver(event) {
            event.preventDefault(); // required for this row to be a valid drop target
            if (!libraryDragState) return;
            const row = event.currentTarget;
            if (row === libraryDragState) return;
            const rect = row.getBoundingClientRect();
            const draggingDown = event.clientY > rect.top + rect.height / 2;
            row.parentElement.insertBefore(libraryDragState, draggingDown ? row.nextSibling : row);
        }

        function libraryDrop(event) {
            event.preventDefault();
        }

        async function libraryDragEnd(event) {
            event.currentTarget.classList.remove('opacity-40');
            if (!libraryDragState) return;
            libraryDragState = null;

            const list = document.getElementById('libraryOrderList');
            const ids = Array.from(list.querySelectorAll('[data-library-row]')).map(function (el) { return el.getAttribute('data-library-row'); });

            try {
                const res = await fetch('/admin/settings/library-order', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: ids.map(function (id) { return 'ids=' + encodeURIComponent(id); }).join('&'),
                });
                const data = await res.json();
                if (!data.ok) showToast('Could not save the new order.', 'error');
            } catch (e) {
                showToast('Could not reach the server to save the new order.', 'error');
            }
        }

        loadLibraryOrderList();

        // ---------- Dashboard Sections ----------
        let dashboardSectionDragState = null;

        function persistDashboardSectionsConfig() {
            const list = document.getElementById('dashboardSectionsList');
            const config = Array.from(list.querySelectorAll('[data-dashboard-section-row]')).map(function (row) {
                const btn = row.querySelector('[data-enabled]');
                return { key: row.getAttribute('data-dashboard-section-row'), enabled: btn.getAttribute('data-enabled') === '1' };
            });

            fetch('/admin/settings/dashboard-sections', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'config=' + encodeURIComponent(JSON.stringify(config)),
            }).then(function (res) { return res.json(); }).then(function (data) {
                if (!data.ok) showToast('Could not save the new layout.', 'error');
            }).catch(function () {
                showToast('Could not reach the server to save the new layout.', 'error');
            });
        }

        async function toggleEmailCategory(btn, category) {
            const enabled = btn.getAttribute('data-enabled') === '1';
            const newEnabled = !enabled;
            const label = category === 'user' ? 'User Emails' : 'Admin Emails';
            const icon = category === 'user' ? 'fa-users' : 'fa-user-shield';
            btn.setAttribute('data-enabled', newEnabled ? '1' : '0');
            btn.className = 'badge ' + (newEnabled ? 'badge-active' : 'badge-closed') + ' text-[10px] px-3 py-1.5 cursor-pointer';
            btn.innerHTML = '<i class="fas ' + icon + ' mr-1"></i>' + label + ': ' + (newEnabled ? 'Enabled' : 'Disabled');

            try {
                await fetch('/admin/settings/email-toggles', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: 'category=' + encodeURIComponent(category) + '&enabled=' + (newEnabled ? '1' : '0'),
                });
            } catch (e) {
                showToast('Could not reach the server to save this setting.', 'error');
            }
        }

        function toggleDashboardSectionEnabled(btn) {
            const enabled = btn.getAttribute('data-enabled') === '1';
            const newEnabled = !enabled;
            btn.setAttribute('data-enabled', newEnabled ? '1' : '0');
            btn.className = 'badge ' + (newEnabled ? 'badge-active' : 'badge-closed') + ' text-[10px] px-3 py-1 cursor-pointer flex-shrink-0';
            btn.textContent = newEnabled ? 'Enabled' : 'Disabled';
            persistDashboardSectionsConfig();
        }

        function dashboardSectionDragStart(event) {
            dashboardSectionDragState = event.currentTarget;
            event.currentTarget.classList.add('opacity-40');
            event.dataTransfer.effectAllowed = 'move';
            event.dataTransfer.setData('text/plain', ''); // some browsers require this for drag to initiate at all
        }

        function dashboardSectionDragOver(event) {
            event.preventDefault(); // required for this row to be a valid drop target
            if (!dashboardSectionDragState) return;
            const row = event.currentTarget;
            if (row === dashboardSectionDragState) return;
            const rect = row.getBoundingClientRect();
            const draggingDown = event.clientY > rect.top + rect.height / 2;
            row.parentElement.insertBefore(dashboardSectionDragState, draggingDown ? row.nextSibling : row);
        }

        function dashboardSectionDrop(event) {
            event.preventDefault();
        }

        function dashboardSectionDragEnd(event) {
            event.currentTarget.classList.remove('opacity-40');
            if (!dashboardSectionDragState) return;
            dashboardSectionDragState = null;
            persistDashboardSectionsConfig();
        }
    </script>
</body>
</html>
