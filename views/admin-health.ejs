<!DOCTYPE html>
<html lang="en">
<head>
    <% pageTitle = 'Health' %>
    <%- include('partials/head') %>
</head>
<body class="antialiased overflow-x-hidden">
    <%- include('partials/nav') %>

    <main class="max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-10 pb-24">
        <h1 class="text-2xl sm:text-3xl font-extrabold mb-2">Server Health</h1>
        <p class="text-slate-400 text-sm mb-8">A live view of any container in your compose stack, independent of any single plan.</p>

        <% if (!sshConfigured) { %>
            <div class="mb-8 px-4 sm:px-5 py-4 rounded-xl bg-amber-500/10 border border-amber-500/30 text-amber-400 text-sm flex items-center justify-between flex-wrap gap-3">
                <span><i class="fas fa-triangle-exclamation mr-2"></i>No server access configured yet for this page.</span>
                <a href="/admin/settings" class="btn-amber px-4 py-2 rounded-lg text-xs whitespace-nowrap">Set Up in Settings</a>
            </div>
        <% } %>

        <!-- Search -->
        <div class="mb-4">
            <div class="relative max-w-sm">
                <i class="fas fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 text-sm"></i>
                <input type="text" id="containerSearch" oninput="filterContainers()" class="input pl-10" placeholder="Search containers…">
            </div>
        </div>

        <!-- Toolbar -->
        <div class="flex items-center justify-between mb-6 flex-wrap gap-3">
            <h2 class="text-sm uppercase tracking-widest text-slate-500 font-bold">Containers (<span id="containerVisibleCount"><%= containers.length %></span>)</h2>
            <div class="flex items-center gap-2 flex-wrap">
                <button type="button" id="refreshAllBtn" onclick="refreshAllStatuses()" title="Refresh all statuses" class="w-10 h-10 flex items-center justify-center rounded-xl btn-outline">
                    <i class="fas fa-arrows-rotate"></i>
                </button>
                <button type="button" id="bulkModeToggle" onclick="toggleBulkMode()" class="btn-outline px-4 py-2.5 rounded-xl text-sm">
                    <i class="fas fa-check-double mr-2"></i>Bulk Actions
                </button>
                <button type="button" onclick="confirmFullReset()" class="px-4 py-2.5 rounded-xl text-sm bg-red-600 hover:bg-red-500 text-white font-bold transition">
                    <i class="fas fa-triangle-exclamation mr-2"></i>Full Reset &amp; Update
                </button>
                <button type="button" onclick="openModal('addContainerModal')" class="btn-primary px-5 py-2.5 rounded-xl text-sm">
                    <i class="fas fa-plus mr-2"></i>Add Container
                </button>
            </div>
        </div>

        <!-- Bulk action bar (shown only in bulk mode) -->
        <div id="bulkActionBar" class="hidden mb-4 glass rounded-2xl p-4 flex items-center justify-between flex-wrap gap-3">
            <span class="text-sm text-slate-300"><span id="bulkSelectedCount">0</span> selected</span>
            <div class="flex items-center gap-2">
                <button type="button" onclick="runBulkAction('stop')" class="btn-outline px-4 py-2 rounded-lg text-sm">
                    <i class="fas fa-stop mr-2"></i>Stop Selected
                </button>
                <button type="button" onclick="runBulkAction('restart')" class="btn-amber px-4 py-2 rounded-lg text-sm">
                    <i class="fas fa-rotate mr-2"></i>Restart Selected
                </button>
            </div>
        </div>

        <div id="fullResetResult" class="hidden text-sm rounded-xl p-4 mb-6"></div>
        <div id="healthActionResult" class="hidden text-sm rounded-xl p-4 mb-6"></div>

        <!-- Containers -->
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3 sm:gap-4 mb-6" id="healthContainerList" data-bulk-mode="off">
            <% containers.forEach(function(c, index) { %>
                <div class="glass rounded-2xl p-3 sm:p-4 flex flex-col items-center text-center gap-2 relative" data-container-row data-container-id="<%= c.id %>" data-container-search="<%= (c.label + ' ' + c.container_name).toLowerCase() %>">
                    <input type="checkbox" class="bulk-select-checkbox absolute top-2 left-2 w-4 h-4 accent-sky-500" data-bulk-checkbox value="<%= c.id %>">
                    <button type="button" class="container-actions-btn absolute top-2 left-2 w-5 h-5 flex items-center justify-center rounded text-slate-500 hover:text-white hover:bg-white/5 text-[10px]" title="Actions" onclick="openContainerActions('<%= c.id %>', '<%= c.label %>')" data-custom-actions="<%= JSON.stringify(c.customActions) %>">
                        <i class="fas fa-sliders"></i>
                    </button>
                    <button type="button" class="absolute top-2 right-2 w-5 h-5 flex items-center justify-center rounded text-slate-500 hover:text-white hover:bg-white/5 text-[10px]" title="Server usage" onclick="openUsage('<%= c.id %>', '<%= c.label %>')">
                        <i class="fas fa-chart-line"></i>
                    </button>

                    <% if (c.link_url) { %>
                        <a href="<%= c.link_url %>" target="_blank" rel="noopener noreferrer" class="w-11 h-11 sm:w-12 sm:h-12 rounded-xl logo-box-<%= c.logo_bg || 'default' %> flex items-center justify-center overflow-hidden flex-shrink-0">
                            <% if (c.logo_path) { %>
                                <img src="<%= c.logo_path %>" alt="<%= c.label %>" class="w-full h-full object-cover">
                            <% } else { %>
                                <i class="fas fa-cube text-slate-600 text-lg"></i>
                            <% } %>
                        </a>
                    <% } else { %>
                        <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-xl logo-box-<%= c.logo_bg || 'default' %> flex items-center justify-center overflow-hidden flex-shrink-0">
                            <% if (c.logo_path) { %>
                                <img src="<%= c.logo_path %>" alt="<%= c.label %>" class="w-full h-full object-cover">
                            <% } else { %>
                                <i class="fas fa-cube text-slate-600 text-lg"></i>
                            <% } %>
                        </div>
                    <% } %>

                    <div class="w-full min-w-0">
                        <% if (c.link_url) { %>
                            <a href="<%= c.link_url %>" target="_blank" rel="noopener noreferrer" class="font-semibold text-white text-xs truncate block hover:text-sky-400"><%= c.label %></a>
                        <% } else { %>
                            <p class="font-semibold text-white text-xs truncate"><%= c.label %></p>
                        <% } %>
                        <p class="text-slate-500 text-[10px] font-mono truncate"><%= c.container_name %></p>
                    </div>

                    <span class="badge badge-suspended text-[10px] px-2 py-0.5" data-status-pill><i class="fas fa-circle-notch fa-spin"></i> checking</span>

                    <div class="flex items-center gap-1.5 flex-wrap justify-center w-full">
                        <button class="btn-outline flex-1 py-1.5 rounded-lg text-[11px]" data-health-btn data-health-action="stop" data-health-id="<%= c.id %>" data-health-label="<%= c.label %>" title="Stop">
                            <i class="fas fa-stop"></i>
                        </button>
                        <button class="btn-outline flex-1 py-1.5 rounded-lg text-[11px]" data-update-btn data-update-id="<%= c.id %>" data-update-label="<%= c.label %>" title="Update (stop, pull, up)">
                            <i class="fas fa-cloud-arrow-down"></i>
                        </button>
                        <button class="btn-amber flex-1 py-1.5 rounded-lg text-[11px]" data-health-btn data-health-action="restart" data-health-id="<%= c.id %>" data-health-label="<%= c.label %>" title="Restart">
                            <i class="fas fa-rotate"></i>
                        </button>
                    </div>

                    <div class="flex items-center gap-0.5 flex-wrap justify-center pt-1.5 border-t border-white/5 w-full">
                        <form method="POST" action="/admin/health/containers/<%= c.id %>/move" data-ajax-form>
                            <input type="hidden" name="direction" value="up">
                            <button type="submit" class="w-6 h-6 rounded-lg text-slate-400 hover:text-white hover:bg-white/5 text-[11px]" title="Move earlier" <%= index === 0 ? 'disabled style=opacity:0.3' : '' %>>
                                <i class="fas fa-arrow-up"></i>
                            </button>
                        </form>
                        <form method="POST" action="/admin/health/containers/<%= c.id %>/move" data-ajax-form>
                            <input type="hidden" name="direction" value="down">
                            <button type="submit" class="w-6 h-6 rounded-lg text-slate-400 hover:text-white hover:bg-white/5 text-[11px]" title="Move later" <%= index === containers.length - 1 ? 'disabled style=opacity:0.3' : '' %>>
                                <i class="fas fa-arrow-down"></i>
                            </button>
                        </form>
                        <button type="button" class="w-6 h-6 rounded-lg text-slate-400 hover:text-white hover:bg-white/5 text-[11px]" title="Refresh status" data-refresh-btn data-refresh-id="<%= c.id %>">
                            <i class="fas fa-arrows-rotate"></i>
                        </button>
                        <button type="button" class="w-6 h-6 rounded-lg text-slate-400 hover:text-white hover:bg-white/5 text-[11px]" title="View logs" onclick="openLogs('<%= c.id %>', '<%= c.label %>')">
                            <i class="fas fa-file-lines"></i>
                        </button>
                        <button type="button" class="px-2 h-6 rounded-lg text-slate-400 hover:text-white hover:bg-white/5 text-[11px]" title="Edit" data-toggle-target="container-<%= c.id %>-edit">
                            <i class="fas fa-pen mr-1"></i>Edit
                        </button>
                    </div>

                    <div class="hidden w-full flex flex-col gap-3 mt-1 pt-2 border-t border-white/5" data-toggle-key="container-<%= c.id %>-edit">
                        <form method="POST" action="/admin/health/containers/<%= c.id %>/update" enctype="multipart/form-data" data-ajax-form class="w-full flex flex-col gap-2 text-left">
                            <input type="text" name="label" required value="<%= c.label %>" class="input text-[11px] px-2 py-1.5" placeholder="Label">
                            <input type="url" name="link_url" value="<%= c.link_url || '' %>" class="input text-[11px] px-2 py-1.5" placeholder="Link (optional, e.g. https://plex.example.com)">
                            <select name="logo_bg" class="input text-[11px] px-2 py-1.5">
                                <option value="default" <%= (c.logo_bg || 'default') === 'default' ? 'selected' : '' %>>Dark box (default)</option>
                                <option value="white" <%= c.logo_bg === 'white' ? 'selected' : '' %>>White background (for transparent logos)</option>
                                <option value="none" <%= c.logo_bg === 'none' ? 'selected' : '' %>>No box / border</option>
                            </select>
                            <label for="logo-file-<%= c.id %>" class="btn-outline inline-flex items-center justify-center gap-1.5 py-1.5 px-3 rounded-lg text-[11px] cursor-pointer w-fit mx-auto">
                                <i class="fas fa-image"></i>Choose Image
                            </label>
                            <input type="file" name="logo" id="logo-file-<%= c.id %>" accept="image/png,image/jpeg,image/webp,image/svg+xml" class="hidden">
                            <button type="submit" class="btn-primary px-4 py-1.5 rounded-lg text-[11px]">Save</button>
                        </form>
                        <form method="POST" action="/admin/health/containers/<%= c.id %>/delete" data-ajax-form data-confirm="Stop monitoring this container?" class="pt-2 border-t border-white/5">
                            <button type="submit" class="w-full text-red-400 hover:text-red-300 hover:bg-red-500/10 rounded-lg text-[11px] py-1.5">
                                <i class="fas fa-trash mr-1"></i>Remove Container
                            </button>
                        </form>
                    </div>
                </div>
            <% }); %>
            <% if (containers.length === 0) { %>
                <p class="text-slate-500 text-sm col-span-full">No containers added yet.</p>
            <% } %>
        </div>
        <p id="containerSearchEmpty" class="hidden text-slate-500 text-sm mb-6">No containers match your search.</p>

        <!-- Recent actions -->
        <h2 class="text-sm uppercase tracking-widest text-slate-500 font-bold mb-4">Recent Stop/Restart Requests</h2>
        <div class="glass rounded-2xl overflow-x-auto">
            <% if (recentLog.length === 0) { %>
                <p class="text-slate-500 text-sm p-6">No requests yet.</p>
            <% } else { %>
                <table class="kb-table min-w-[560px]">
                    <thead><tr><th>Admin</th><th>Container</th><th>Action</th><th>Time (UK)</th><th>Result</th></tr></thead>
                    <tbody>
                        <% recentLog.forEach(function(l) { %>
                            <tr>
                                <td class="text-slate-300"><%= l.admin_name %></td>
                                <td class="text-slate-400 font-mono"><%= l.container_name %></td>
                                <td class="text-slate-400 capitalize"><%= l.action %></td>
                                <td class="text-slate-500 text-xs"><%= formatUK(l.requested_at) %></td>
                                <td><span class="badge <%= l.success ? 'badge-active' : 'badge-expired' %>"><%= l.success ? 'Success' : 'Failed' %></span></td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            <% } %>
        </div>

        <!-- Add Container Modal -->
        <div id="addContainerModal" class="fixed inset-0 bg-black/70 backdrop-blur-sm hidden items-center justify-center z-50 px-4 py-8 overflow-y-auto">
            <div class="glass rounded-3xl p-6 sm:p-8 max-w-lg w-full my-auto">
                <div class="flex items-center justify-between mb-5">
                    <h3 class="text-lg font-bold text-white"><i class="fas fa-plus mr-2 text-sky-400"></i>Add a Container to Monitor</h3>
                    <button type="button" onclick="closeModal('addContainerModal')" class="text-slate-400 hover:text-white w-8 h-8 flex items-center justify-center rounded-lg hover:bg-white/5">
                        <i class="fas fa-xmark"></i>
                    </button>
                </div>
                <form method="POST" action="/admin/health/containers" enctype="multipart/form-data" data-ajax-form class="space-y-4">
                    <input type="text" name="label" required class="input" placeholder="Display label (e.g. Plex Server)">
                    <input type="text" name="container_name" required class="input" placeholder="Exact container name (e.g. plex)">
                    <input type="url" name="link_url" class="input" placeholder="Link (optional, e.g. https://plex.example.com)">
                    <select name="logo_bg" class="input">
                        <option value="default">Dark box (default)</option>
                        <option value="white">White background (for transparent logos)</option>
                        <option value="none">No box / border</option>
                    </select>
                    <div>
                        <label class="text-xs uppercase tracking-widest text-slate-500 font-semibold mb-1.5 block">Logo (optional)</label>
                        <label for="add-container-logo" class="btn-outline inline-flex items-center justify-center gap-1.5 py-2 px-4 rounded-lg text-xs cursor-pointer w-fit">
                            <i class="fas fa-image"></i>Choose Image
                        </label>
                        <input type="file" name="logo" id="add-container-logo" accept="image/png,image/jpeg,image/webp,image/svg+xml" class="hidden">
                        <p class="text-slate-500 text-xs mt-2">Square images work best - you can add or change it later too.</p>
                    </div>
                    <button type="submit" class="btn-primary py-3 rounded-xl text-sm w-full">Add Container</button>
                </form>
            </div>
        </div>

        <!-- Logs Modal -->
        <div id="logsModal" class="fixed inset-0 bg-black/70 backdrop-blur-sm hidden items-center justify-center z-50 px-4 py-8 overflow-y-auto">
            <div class="glass rounded-3xl p-6 sm:p-8 max-w-2xl w-full my-auto">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="text-lg font-bold text-white"><i class="fas fa-file-lines mr-2 text-sky-400"></i>Logs — <span id="logsModalLabel"></span></h3>
                    <button type="button" onclick="closeLogs()" class="text-slate-400 hover:text-white w-8 h-8 flex items-center justify-center rounded-lg hover:bg-white/5">
                        <i class="fas fa-xmark"></i>
                    </button>
                </div>
                <p class="text-slate-500 text-xs mb-3">Showing the last 200 lines, refreshed automatically every few seconds. This is a snapshot, not a true live stream.</p>
                <div id="logsOutput" class="console-output">Loading…</div>
                <div class="flex justify-end mt-3">
                    <button type="button" onclick="refreshLogs()" class="btn-outline px-4 py-2 rounded-lg text-xs">
                        <i class="fas fa-rotate mr-2"></i>Refresh Now
                    </button>
                </div>
            </div>
        </div>

        <!-- Usage Modal -->
        <div id="usageModal" class="fixed inset-0 bg-black/70 backdrop-blur-sm hidden items-center justify-center z-50 px-4 py-8 overflow-y-auto">
            <div class="glass rounded-3xl p-6 sm:p-8 max-w-md w-full my-auto">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="text-lg font-bold text-white"><i class="fas fa-chart-line mr-2 text-sky-400"></i>Usage — <span id="usageModalLabel"></span></h3>
                    <div class="flex items-center gap-1 flex-shrink-0">
                        <button type="button" onclick="refreshUsage()" title="Refresh" class="text-slate-400 hover:text-white w-8 h-8 flex items-center justify-center rounded-lg hover:bg-white/5">
                            <i class="fas fa-rotate"></i>
                        </button>
                        <button type="button" onclick="closeUsage()" title="Close" class="text-slate-400 hover:text-white w-8 h-8 flex items-center justify-center rounded-lg hover:bg-white/5">
                            <i class="fas fa-xmark"></i>
                        </button>
                    </div>
                </div>
                <div id="usageContent" class="grid grid-cols-2 gap-3">
                    <p class="text-slate-500 text-sm col-span-2">Loading…</p>
                </div>
                <p class="text-slate-500 text-xs mt-3">Only meaningful while the container is running.</p>
            </div>
        </div>

        <!-- Container Actions Modal -->
        <div id="containerActionsModal" class="fixed inset-0 bg-black/70 backdrop-blur-sm hidden items-center justify-center z-50 px-4 py-8 overflow-y-auto">
            <div class="glass rounded-3xl p-6 sm:p-8 max-w-lg w-full my-auto">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="text-lg font-bold text-white"><i class="fas fa-sliders mr-2 text-sky-400"></i>Actions — <span id="containerActionsLabel"></span></h3>
                    <button type="button" onclick="closeContainerActions()" title="Close" class="text-slate-400 hover:text-white w-8 h-8 flex items-center justify-center rounded-lg hover:bg-white/5">
                        <i class="fas fa-xmark"></i>
                    </button>
                </div>

                <div id="containerActionsResult" class="hidden text-sm rounded-xl p-3 mb-4"></div>

                <div id="containerActionsList" class="space-y-2 mb-5">
                    <p class="text-slate-500 text-sm">No custom actions yet - add one below.</p>
                </div>

                <details>
                    <summary class="cursor-pointer text-sky-400 text-xs font-semibold uppercase tracking-wide">Add New Action</summary>
                    <form id="newActionForm" class="mt-3 space-y-3" onsubmit="submitNewAction(event)">
                        <input type="text" name="label" required class="input" placeholder="Label (e.g. Reset World Seed)">
                        <div>
                            <label class="text-xs uppercase tracking-widest text-slate-500 font-semibold mb-2 block">Icon</label>
                            <div class="grid grid-cols-6 gap-2" id="newActionIconPicker">
                                <% ['fa-bolt', 'fa-dice', 'fa-rotate', 'fa-terminal', 'fa-database', 'fa-broom', 'fa-download', 'fa-upload', 'fa-trash', 'fa-wrench', 'fa-clock-rotate-left', 'fa-play'].forEach(function(icon, i) { %>
                                    <label class="flex items-center justify-center h-10 rounded-lg bg-slate-900/60 cursor-pointer has-[:checked]:bg-sky-500/20 has-[:checked]:ring-1 has-[:checked]:ring-sky-500">
                                        <input type="radio" name="icon" value="<%= icon %>" class="hidden" <%= i === 0 ? 'checked' : '' %>>
                                        <i class="fas <%= icon %> text-slate-300"></i>
                                    </label>
                                <% }); %>
                            </div>
                        </div>
                        <div>
                            <label class="text-xs uppercase tracking-widest text-slate-500 font-semibold mb-1.5 block">Command</label>
                            <textarea name="command" required rows="3" class="input font-mono text-xs" placeholder="The full command to run over SSH, e.g. docker exec mc-server rcon-cli seed-reset"></textarea>
                            <p class="text-slate-500 text-xs mt-1.5">Runs exactly as written, over the same SSH connection used for the other actions on this page.</p>
                        </div>
                        <button type="submit" class="btn-primary py-2.5 px-5 rounded-lg text-sm">Add Action</button>
                    </form>
                </details>
            </div>
        </div>
    </main>

    <script>
        // ---------- Search ----------
        function filterContainers() {
            const query = document.getElementById('containerSearch').value.trim().toLowerCase();
            const rows = document.querySelectorAll('[data-container-row]');
            let visible = 0;
            rows.forEach(function (row) {
                const haystack = row.getAttribute('data-container-search') || '';
                const match = !query || haystack.indexOf(query) !== -1;
                row.classList.toggle('hidden', !match);
                if (match) visible++;
            });
            const countEl = document.getElementById('containerVisibleCount');
            if (countEl) countEl.textContent = visible;
            const emptyEl = document.getElementById('containerSearchEmpty');
            if (emptyEl) emptyEl.classList.toggle('hidden', visible !== 0);
        }

        // ---------- Bulk mode ----------
        function toggleBulkMode() {
            const list = document.getElementById('healthContainerList');
            const on = list.getAttribute('data-bulk-mode') === 'on';
            if (on) {
                exitBulkMode();
            } else {
                list.setAttribute('data-bulk-mode', 'on');
                document.getElementById('bulkActionBar').classList.remove('hidden');
            }
        }

        function exitBulkMode() {
            const list = document.getElementById('healthContainerList');
            list.setAttribute('data-bulk-mode', 'off');
            document.getElementById('bulkActionBar').classList.add('hidden');
            document.querySelectorAll('[data-bulk-checkbox]').forEach(function (cb) { cb.checked = false; });
            updateBulkCount();
        }

        function updateBulkCount() {
            const count = document.querySelectorAll('[data-bulk-checkbox]:checked').length;
            const el = document.getElementById('bulkSelectedCount');
            if (el) el.textContent = count;
        }

        document.addEventListener('change', function (e) {
            if (e.target.matches('[data-bulk-checkbox]')) updateBulkCount();
        });

        async function runBulkAction(action) {
            const ids = Array.from(document.querySelectorAll('[data-bulk-checkbox]:checked')).map(function (cb) { return cb.value; });
            if (ids.length === 0) { alert('Select at least one container first.'); return; }
            if (!confirm((action === 'stop' ? 'Stop' : 'Restart') + ' ' + ids.length + ' container(s) now? This runs one combined command.')) return;

            const resultBox = document.getElementById('healthActionResult');
            const inProgressLabel = action === 'stop' ? 'Stopping…' : 'Restarting…';

            // Immediate per-item feedback so it's obvious which containers are
            // actually part of this run, rather than a single generic message
            // with no visibility into individual items until it's all done.
            ids.forEach(function (id) {
                const pill = document.querySelector('[data-container-id="' + id + '"] [data-status-pill]');
                if (pill) {
                    pill.className = 'badge badge-suspended text-[10px] px-2 py-0.5';
                    pill.innerHTML = '<i class="fas fa-circle-notch fa-spin"></i> ' + inProgressLabel;
                    pill.removeAttribute('data-current-status');
                }
            });

            try {
                const formData = new URLSearchParams();
                ids.forEach(function (id) { formData.append('ids', id); });
                formData.append('action', action);
                const res = await fetch('/admin/health/containers/bulk-action', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: formData.toString(),
                });
                const data = await res.json();
                resultBox.classList.remove('hidden');
                resultBox.className = 'text-sm rounded-xl p-4 mb-6 ' + (data.ok
                    ? 'bg-emerald-500/10 border border-emerald-500/30 text-emerald-400'
                    : 'bg-red-500/10 border border-red-500/30 text-red-400');
                resultBox.textContent = data.message;
                showToast(data.message, data.ok ? 'success' : 'error');
                exitBulkMode();
                refreshHealth();
            } catch (e) {
                resultBox.classList.remove('hidden');
                resultBox.className = 'text-sm rounded-xl p-4 mb-6 bg-red-500/10 border border-red-500/30 text-red-400';
                resultBox.textContent = 'Something went wrong sending the bulk request.';
                showToast('Something went wrong sending the bulk request.', 'error');
                exitBulkMode();
                refreshHealth(); // pull real state back in either way - don't leave pills stuck showing "in progress"
            }
        }

        // ---------- Full Reset & Update ----------
        let fullResetPollTimer = null;

        async function confirmFullReset() {
            if (!confirm('This will run "docker compose down", then "pull", then "up -d" for your ENTIRE stack, in that order. Every container in it will go offline briefly. Continue?')) return;
            if (!confirm('Are you sure? This affects everything, not just one container. This can take several minutes, especially the pull step.')) return;

            const resultBox = document.getElementById('fullResetResult');
            resultBox.classList.remove('hidden');
            resultBox.className = 'text-sm rounded-xl p-4 mb-6 bg-amber-500/10 border border-amber-500/30 text-amber-400';
            resultBox.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>Starting full reset…';

            try {
                const res = await fetch('/admin/health/full-reset', { method: 'POST' });
                const data = await res.json();

                if (!res.ok || (!data.ok && !data.started)) {
                    resultBox.className = 'text-sm rounded-xl p-4 mb-6 bg-red-500/10 border border-red-500/30 text-red-400';
                    resultBox.textContent = data.message || 'Could not start the full reset.';
                    showToast(data.message || 'Could not start the full reset.', 'error');
                    return;
                }

                resultBox.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>Running in the background — this can take several minutes. You can navigate away; it keeps running on the server either way.';
                pollFullResetStatus();
            } catch (e) {
                resultBox.className = 'text-sm rounded-xl p-4 mb-6 bg-red-500/10 border border-red-500/30 text-red-400';
                resultBox.textContent = 'Could not reach the server to start the reset. Check your connection and try again.';
                showToast('Could not reach the server to start the reset.', 'error');
            }
        }

        async function pollFullResetStatus() {
            if (fullResetPollTimer) clearInterval(fullResetPollTimer);

            const check = async function () {
                const resultBox = document.getElementById('fullResetResult');
                try {
                    const res = await fetch('/admin/health/full-reset/status');
                    const data = await res.json();

                    if (data.running) {
                        return; // still going - keep polling, leave the "running" message as-is
                    }

                    clearInterval(fullResetPollTimer);
                    fullResetPollTimer = null;

                    if (data.lastResult) {
                        resultBox.className = 'text-sm rounded-xl p-4 mb-6 ' + (data.lastResult.ok
                            ? 'bg-emerald-500/10 border border-emerald-500/30 text-emerald-400'
                            : 'bg-red-500/10 border border-red-500/30 text-red-400');
                        resultBox.textContent = data.lastResult.message;
                        showToast(data.lastResult.message, data.lastResult.ok ? 'success' : 'error');
                    }
                    refreshHealth();
                } catch (e) {
                    // transient network hiccup while polling - keep trying, don't clear the interval
                }
            };

            check();
            fullResetPollTimer = setInterval(check, 5000);
        }

        // If a reset was already running when this page loaded (e.g. it was
        // started, then the page got reloaded/reopened), pick up polling for it.
        (async function checkForInProgressReset() {
            try {
                const res = await fetch('/admin/health/full-reset/status');
                const data = await res.json();
                if (data.running) {
                    const resultBox = document.getElementById('fullResetResult');
                    resultBox.classList.remove('hidden');
                    resultBox.className = 'text-sm rounded-xl p-4 mb-6 bg-amber-500/10 border border-amber-500/30 text-amber-400';
                    resultBox.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>A full reset is already running in the background — this can take several minutes.';
                    pollFullResetStatus();
                }
            } catch (e) {
                // ignore - not critical on page load
            }
        })();

        // ---------- Logs modal (polling snapshot, not a true stream) ----------
        let logsContainerId = null;
        let logsPollTimer = null;

        function openLogs(id, label) {
            logsContainerId = id;
            document.getElementById('logsModalLabel').textContent = label;
            document.getElementById('logsOutput').textContent = 'Loading…';
            openModal('logsModal');
            refreshLogs();
            logsPollTimer = setInterval(refreshLogs, 4000);
        }

        function closeLogs() {
            closeModal('logsModal');
            logsContainerId = null;
            if (logsPollTimer) { clearInterval(logsPollTimer); logsPollTimer = null; }
        }

        async function refreshLogs() {
            if (!logsContainerId) return;
            try {
                const res = await fetch('/admin/health/containers/' + logsContainerId + '/logs');
                const data = await res.json();
                const box = document.getElementById('logsOutput');
                if (!box) return;
                if (data.ok) {
                    const wasScrolledToBottom = box.scrollTop + box.clientHeight >= box.scrollHeight - 20;
                    box.textContent = data.output || '(no output)';
                    if (wasScrolledToBottom) box.scrollTop = box.scrollHeight;
                } else {
                    box.textContent = data.message || 'Failed to load logs.';
                }
            } catch (e) {
                // leave existing content on transient failure
            }
        }

        // ---------- Usage stats ----------
        let usageContainerId = null;

        function openUsage(id, label) {
            usageContainerId = id;
            document.getElementById('usageModalLabel').textContent = label;
            openModal('usageModal');
            refreshUsage();
        }

        function closeUsage() {
            closeModal('usageModal');
            usageContainerId = null;
        }

        async function refreshUsage() {
            if (!usageContainerId) return;
            const content = document.getElementById('usageContent');
            content.innerHTML = '<p class="text-slate-500 text-sm col-span-2"><i class="fas fa-spinner fa-spin mr-2"></i>Loading…</p>';

            try {
                const res = await fetch('/admin/health/containers/' + usageContainerId + '/usage');
                const data = await res.json();
                if (!data.ok) {
                    content.innerHTML = '<p class="text-slate-500 text-sm col-span-2">' + (data.message || 'Could not load usage stats.') + '</p>';
                    return;
                }
                const stat = function (icon, label, value) {
                    return '<div class="bg-slate-900/40 rounded-xl p-3">' +
                        '<p class="text-slate-500 text-[10px] uppercase tracking-widest font-semibold mb-1"><i class="fas ' + icon + ' mr-1"></i>' + label + '</p>' +
                        '<p class="text-white font-mono text-sm">' + value + '</p></div>';
                };
                content.innerHTML =
                    stat('fa-microchip', 'CPU', data.cpu) +
                    stat('fa-memory', 'Memory', data.memPercent) +
                    stat('fa-server', 'Mem Usage', data.memUsage) +
                    stat('fa-network-wired', 'Network I/O', data.netIO) +
                    stat('fa-hard-drive', 'Disk I/O', data.blockIO) +
                    stat('fa-tag', 'Container', data.label);
            } catch (e) {
                content.innerHTML = '<p class="text-slate-500 text-sm col-span-2">Something went wrong loading usage stats.</p>';
            }
        }

        // ---------- Container Actions (custom per-container) ----------
        let containerActionsId = null;

        function openContainerActions(id, label) {
            containerActionsId = id;
            document.getElementById('containerActionsLabel').textContent = label;
            document.getElementById('containerActionsResult').classList.add('hidden');
            document.getElementById('newActionForm').reset();

            const btn = document.querySelector('[data-container-id="' + id + '"] .container-actions-btn');
            let actions = [];
            try { actions = JSON.parse((btn && btn.getAttribute('data-custom-actions')) || '[]'); } catch (e) { actions = []; }
            renderContainerActions(actions);

            openModal('containerActionsModal');
        }

        function closeContainerActions() {
            closeModal('containerActionsModal');
            containerActionsId = null;
        }

        function renderContainerActions(actions) {
            const list = document.getElementById('containerActionsList');
            if (!actions || actions.length === 0) {
                list.innerHTML = '<p class="text-slate-500 text-sm">No custom actions yet - add one below.</p>';
                return;
            }
            list.innerHTML = actions.map(function (a) {
                return '<div class="flex items-center gap-3 bg-slate-900/40 rounded-xl px-3 py-2.5" data-action-row="' + a.id + '">' +
                    '<div class="w-8 h-8 rounded-lg bg-slate-800 flex items-center justify-center flex-shrink-0"><i class="fas ' + a.icon + ' text-sky-400 text-sm"></i></div>' +
                    '<span class="text-slate-200 text-sm flex-1 truncate">' + a.label + '</span>' +
                    '<button type="button" onclick="runCustomAction(' + a.id + ', this)" class="btn-outline py-1.5 px-3 rounded-lg text-xs flex-shrink-0">Run</button>' +
                    '<button type="button" onclick="deleteCustomAction(' + a.id + ')" title="Delete" class="text-slate-500 hover:text-red-400 w-7 h-7 flex items-center justify-center rounded-lg hover:bg-white/5 flex-shrink-0"><i class="fas fa-trash text-xs"></i></button>' +
                    '</div>';
            }).join('');
        }

        function showContainerActionsResult(ok, message) {
            const box = document.getElementById('containerActionsResult');
            box.classList.remove('hidden');
            box.className = 'text-sm rounded-xl p-3 mb-4 ' + (ok ? 'bg-emerald-500/10 border border-emerald-500/30 text-emerald-400' : 'bg-red-500/10 border border-red-500/30 text-red-400');
            box.textContent = message;
            showToast(message, ok ? 'success' : 'error');
        }

        async function runCustomAction(actionId, btn) {
            if (!confirm('Run this action now? This runs the exact command configured for it.')) return;
            const originalHtml = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';

            try {
                const res = await fetch('/admin/health/containers/' + containerActionsId + '/actions/' + actionId + '/run', { method: 'POST' });
                const data = await res.json();
                showContainerActionsResult(data.ok, data.message);
            } catch (e) {
                showContainerActionsResult(false, 'Something went wrong sending that request.');
            } finally {
                btn.disabled = false;
                btn.innerHTML = originalHtml;
            }
        }

        async function deleteCustomAction(actionId) {
            if (!confirm('Delete this action? This only removes the button - it does not undo anything it already ran.')) return;
            try {
                const res = await fetch('/admin/health/containers/' + containerActionsId + '/actions/' + actionId + '/delete', { method: 'POST' });
                const data = await res.json();
                if (!data.ok) return showContainerActionsResult(false, data.message || 'Could not delete that action.');

                // Update both the modal's live list and the cached data on
                // the triggering button, so reopening later (without a full
                // page reload) reflects the deletion too.
                const row = document.querySelector('[data-action-row="' + actionId + '"]');
                if (row) row.remove();
                const list = document.getElementById('containerActionsList');
                if (!list.querySelector('[data-action-row]')) {
                    list.innerHTML = '<p class="text-slate-500 text-sm">No custom actions yet - add one below.</p>';
                }
                const btn = document.querySelector('[data-container-id="' + containerActionsId + '"] .container-actions-btn');
                if (btn) {
                    try {
                        const actions = JSON.parse(btn.getAttribute('data-custom-actions') || '[]').filter(function (a) { return a.id !== actionId; });
                        btn.setAttribute('data-custom-actions', JSON.stringify(actions));
                    } catch (e) { /* leave cached data as-is if it was somehow malformed */ }
                }
                showToast('Action deleted.', 'success');
            } catch (e) {
                showContainerActionsResult(false, 'Something went wrong sending that request.');
            }
        }

        async function submitNewAction(e) {
            e.preventDefault();
            const form = e.target;
            const submitBtn = form.querySelector('button[type="submit"]');
            const originalHtml = submitBtn.innerHTML;
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';

            try {
                const formData = new URLSearchParams(new FormData(form));
                const res = await fetch('/admin/health/containers/' + containerActionsId + '/actions', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: formData.toString(),
                });
                const data = await res.json();
                if (!data.ok) {
                    showContainerActionsResult(false, data.message || 'Could not add that action.');
                    return;
                }

                // Update both the live list and the cached data on the
                // triggering button, matching the deletion path above.
                const list = document.getElementById('containerActionsList');
                const emptyMsg = list.querySelector('p');
                if (emptyMsg) list.innerHTML = '';
                list.insertAdjacentHTML('beforeend',
                    '<div class="flex items-center gap-3 bg-slate-900/40 rounded-xl px-3 py-2.5" data-action-row="' + data.action.id + '">' +
                    '<div class="w-8 h-8 rounded-lg bg-slate-800 flex items-center justify-center flex-shrink-0"><i class="fas ' + data.action.icon + ' text-sky-400 text-sm"></i></div>' +
                    '<span class="text-slate-200 text-sm flex-1 truncate">' + data.action.label + '</span>' +
                    '<button type="button" onclick="runCustomAction(' + data.action.id + ', this)" class="btn-outline py-1.5 px-3 rounded-lg text-xs flex-shrink-0">Run</button>' +
                    '<button type="button" onclick="deleteCustomAction(' + data.action.id + ')" title="Delete" class="text-slate-500 hover:text-red-400 w-7 h-7 flex items-center justify-center rounded-lg hover:bg-white/5 flex-shrink-0"><i class="fas fa-trash text-xs"></i></button>' +
                    '</div>'
                );
                const btn = document.querySelector('[data-container-id="' + containerActionsId + '"] .container-actions-btn');
                if (btn) {
                    try {
                        const actions = JSON.parse(btn.getAttribute('data-custom-actions') || '[]');
                        actions.push(data.action);
                        btn.setAttribute('data-custom-actions', JSON.stringify(actions));
                    } catch (e) { /* leave cached data as-is if it was somehow malformed */ }
                }

                form.reset();
                showContainerActionsResult(true, 'Action added.');
            } catch (e) {
                showContainerActionsResult(false, 'Something went wrong sending that request.');
            } finally {
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalHtml;
            }
        }

        // ---------- Update (stop, pull, up) ----------
        document.addEventListener('click', async function (e) {
            const btn = e.target.closest('[data-update-btn]');
            if (!btn) return;

            const label = btn.getAttribute('data-update-label');
            const id = btn.getAttribute('data-update-id');
            if (!confirm('Update "' + label + '"? This stops it, pulls the latest image, and brings it back up. It can take a minute or two.')) return;

            const resultBox = document.getElementById('healthActionResult');
            const originalHtml = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';

            const pill = document.querySelector('[data-container-id="' + id + '"] [data-status-pill]');
            if (pill) {
                pill.className = 'badge badge-suspended text-[10px] px-2 py-0.5';
                pill.innerHTML = '<i class="fas fa-circle-notch fa-spin"></i> Updating…';
                pill.removeAttribute('data-current-status');
            }

            try {
                const res = await fetch('/admin/health/containers/' + id + '/docker-update', { method: 'POST' });
                const data = await res.json();
                if (resultBox) {
                    resultBox.classList.remove('hidden');
                    resultBox.className = 'text-sm rounded-xl p-4 mb-6 ' + (data.ok
                        ? 'bg-emerald-500/10 border border-emerald-500/30 text-emerald-400'
                        : 'bg-red-500/10 border border-red-500/30 text-red-400');
                    resultBox.textContent = data.message;
                }
                showToast(data.message, data.ok ? 'success' : 'error');
                refreshHealth();
            } catch (err) {
                if (resultBox) {
                    resultBox.classList.remove('hidden');
                    resultBox.className = 'text-sm rounded-xl p-4 mb-6 bg-red-500/10 border border-red-500/30 text-red-400';
                    resultBox.textContent = 'Something went wrong sending that request.';
                }
                showToast('Something went wrong sending that request.', 'error');
            } finally {
                btn.disabled = false;
                btn.innerHTML = originalHtml;
            }
        });

        // ---------- Live status ----------
        const STATUS_MAP = {
            up: ['badge-active', 'fa-circle-check', 'Online'],
            starting: ['badge-suspended', 'fa-circle-notch fa-spin', 'Starting'],
            unhealthy: ['badge-expired', 'fa-triangle-exclamation', 'Unhealthy'],
            down: ['badge-expired', 'fa-circle-xmark', 'Offline'],
            unknown: ['badge-closed', 'fa-question', 'Unknown'],
        };

        function applyStatuses(list) {
            list.forEach(function (c) {
                const row = document.querySelector('[data-container-id="' + c.id + '"] [data-status-pill]');
                if (!row) return;
                // Skip entirely if this is exactly what's already showing -
                // nothing to update, and nothing for the person to notice
                // flicker on. The one exception is right after an action
                // (Stop/Restart/Update/Bulk), which explicitly clears this
                // attribute so the real status is guaranteed to land at
                // least once even if it happens to match what was last
                // confirmed before the action started.
                if (row.getAttribute('data-current-status') === c.status) return;

                const chosen = STATUS_MAP[c.status] || STATUS_MAP.unknown;
                row.className = 'badge ' + chosen[0] + ' text-[10px] px-2 py-0.5';
                row.innerHTML = '<i class="fas ' + chosen[1] + '"></i> ' + chosen[2];
                row.setAttribute('data-current-status', c.status);
            });
        }

        async function refreshHealth() {
            try {
                const res = await fetch('/admin/health/status');
                const data = await res.json();
                if (!data.ok) return;
                applyStatuses(data.containers);
            } catch (e) {
                // leave "checking" state as-is
            }
        }
        refreshHealth();
        document.addEventListener('main:updated', refreshHealth);

        // A single refresh right after an action completes can still catch
        // a container mid-restart (the SSH command returning doesn't mean
        // it's fully back up yet) - without anything polling afterward,
        // that transient status was the last thing ever shown, stuck until
        // someone manually refreshed. This keeps checking in the
        // background - quietly, since applyStatuses() above only touches
        // the DOM when something's actually different - so it self-
        // corrects within a few seconds either way, without flickering
        // pills that haven't changed.
        setInterval(refreshHealth, 4000);

        // ---------- Refresh all statuses ----------
        async function refreshAllStatuses() {
            const btn = document.getElementById('refreshAllBtn');
            const icon = btn ? btn.querySelector('i') : null;

            if (icon) icon.classList.add('fa-spin');
            if (btn) btn.disabled = true;

            // Immediate feedback on every card at once, same as the per-container refresh.
            document.querySelectorAll('[data-status-pill]').forEach(function (pill) {
                pill.className = 'badge badge-suspended text-[10px] px-2 py-0.5';
                pill.innerHTML = '<i class="fas fa-circle-notch fa-spin"></i> checking';
                pill.removeAttribute('data-current-status');
            });

            try {
                await refreshHealth();
            } finally {
                if (icon) icon.classList.remove('fa-spin');
                if (btn) btn.disabled = false;
            }
        }

        // ---------- Per-container refresh ----------
        document.addEventListener('click', async function (e) {
            const btn = e.target.closest('[data-refresh-btn]');
            if (!btn) return;
            const icon = btn.querySelector('i');
            const id = btn.getAttribute('data-refresh-id');

            if (icon) icon.classList.add('fa-spin');
            btn.disabled = true;

            // Immediate feedback on this specific card so it's obvious the
            // click registered, rather than waiting silently for the fetch.
            const pill = document.querySelector('[data-container-id="' + id + '"] [data-status-pill]');
            if (pill) {
                pill.className = 'badge badge-suspended text-[10px] px-2 py-0.5';
                pill.innerHTML = '<i class="fas fa-circle-notch fa-spin"></i> checking';
                pill.removeAttribute('data-current-status');
            }

            try {
                await refreshHealth();
            } finally {
                if (icon) icon.classList.remove('fa-spin');
                btn.disabled = false;
            }
        });

        // ---------- Stop/Restart (event delegation - survives ajax swaps) ----------
        document.addEventListener('click', async function (e) {
            const btn = e.target.closest('[data-health-btn]');
            if (!btn) return;

            const action = btn.getAttribute('data-health-action');
            const label = btn.getAttribute('data-health-label');
            const id = btn.getAttribute('data-health-id');
            if (!confirm((action === 'stop' ? 'Stop' : 'Restart') + ' "' + label + '" now?')) return;

            const resultBox = document.getElementById('healthActionResult');
            const originalHtml = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';

            const pill = document.querySelector('[data-container-id="' + id + '"] [data-status-pill]');
            if (pill) {
                pill.className = 'badge badge-suspended text-[10px] px-2 py-0.5';
                pill.innerHTML = '<i class="fas fa-circle-notch fa-spin"></i> ' + (action === 'stop' ? 'Stopping…' : 'Restarting…');
                pill.removeAttribute('data-current-status');
            }

            try {
                const res = await fetch('/admin/health/containers/' + id + '/' + action, { method: 'POST' });
                const data = await res.json();
                if (resultBox) {
                    resultBox.classList.remove('hidden');
                    resultBox.className = 'text-sm rounded-xl p-4 mb-6 ' + (data.ok
                        ? 'bg-emerald-500/10 border border-emerald-500/30 text-emerald-400'
                        : 'bg-red-500/10 border border-red-500/30 text-red-400');
                    resultBox.textContent = data.message;
                }
                showToast(data.message, data.ok ? 'success' : 'error');
                refreshHealth();
            } catch (err) {
                if (resultBox) {
                    resultBox.classList.remove('hidden');
                    resultBox.className = 'text-sm rounded-xl p-4 mb-6 bg-red-500/10 border border-red-500/30 text-red-400';
                    resultBox.textContent = 'Something went wrong sending that request.';
                }
                showToast('Something went wrong sending that request.', 'error');
            } finally {
                btn.disabled = false;
                btn.innerHTML = originalHtml;
            }
        });
    </script>
</body>
</html>
