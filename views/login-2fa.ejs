<!DOCTYPE html>
<html lang="en">
<head>
    <% pageTitle = 'Verify Your Identity | ' + siteName %>
    <%- include('partials/head') %>
</head>
<body class="antialiased overflow-x-hidden flex flex-col min-h-screen">
    <nav class="max-w-7xl mx-auto px-8 py-6 w-full">
        <img src="/img/KY.svg" alt="<%= siteName %> Logo" class="h-10 w-auto">
    </nav>

    <main class="flex-grow flex items-center justify-center px-6 py-12 relative">
        <div class="hero-glow"></div>

        <div class="max-w-md w-full relative z-10">
            <div class="text-center mb-8">
                <div class="w-20 h-20 mx-auto rounded-full bg-sky-500/10 border border-sky-500/30 flex items-center justify-center mb-6">
                    <i class="fas fa-shield-halved text-sky-400 text-3xl"></i>
                </div>
                <h1 class="text-3xl font-extrabold mb-2 tracking-tight">Verify it's you</h1>
                <p class="text-slate-400 text-sm">Enter the 6-digit code from your authenticator app.</p>
            </div>

            <div class="glass rounded-3xl p-8">
                <% if (error) { %>
                    <div class="mb-5 px-4 py-3 rounded-xl bg-red-500/10 border border-red-500/30 text-red-400 text-sm">
                        <i class="fas fa-triangle-exclamation mr-2"></i><%= error %>
                    </div>
                <% } %>
                <form method="POST" action="/login/2fa" class="space-y-4">
                    <input
                        type="text"
                        name="code"
                        required
                        autofocus
                        autocomplete="one-time-code"
                        inputmode="numeric"
                        class="input text-center text-2xl tracking-[0.4em] font-mono"
                        placeholder="000000"
                        maxlength="11"
                    >
                    <button type="submit" class="w-full btn-primary py-4 rounded-2xl text-sm mt-2">
                        <i class="fas fa-right-to-bracket mr-2"></i> Verify
                    </button>
                </form>
                <p class="text-slate-500 text-xs text-center mt-5">
                    Lost your device? Enter one of your recovery codes above instead.
                </p>
            </div>

            <p class="text-center text-slate-500 text-sm mt-8">
                <a href="/login" class="text-sky-400 hover:text-sky-300">Use a different account</a>
            </p>
        </div>
    </main>
</body>
</html>
