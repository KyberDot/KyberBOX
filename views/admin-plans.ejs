<!DOCTYPE html>
<html lang="en">
<head>
    <% pageTitle = 'Plans' %>
    <%- include('partials/head') %>
</head>
<body class="antialiased overflow-x-hidden">
    <%- include('partials/nav') %>

    <main class="max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-10 pb-24">
        <h1 class="text-2xl sm:text-3xl font-extrabold mb-2">Plans</h1>
        <p class="text-slate-400 text-sm mb-8">Each plan controls what subscribers on it see when they log in: its feature list, its server access, its action buttons (like a Plex restart), and which containers' health is shown.</p>

        <!-- Create plan trigger -->
        <div class="flex justify-end mb-8">
            <button type="button" onclick="openModal('createPlanModal')" class="btn-primary px-6 py-3 rounded-xl text-sm">
                <i class="fas fa-plus mr-2"></i>Create a New Plan
            </button>
        </div>

        <!-- Plans list -->
        <div class="space-y-6">
            <% plans.forEach(function(plan) { %>
                <div class="glass rounded-2xl p-5 sm:p-6 <%= newPlanId === plan.id ? 'border border-emerald-500/40' : '' %>">
                    <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
                        <div>
                            <p class="font-bold text-white text-lg"><%= plan.name %></p>
                            <div class="flex flex-wrap items-center gap-2 mt-1">
                                <span class="badge badge-answered"><%= serviceLabel(plan.service) %></span>
                                <% if (plan.pricing_mode === 'free') { %>
                                    <span class="badge badge-active">Free</span>
                                <% } else if (plan.pricing_mode === 'included_with') { %>
                                    <% const triggerIds = String(plan.included_with_plan_ids || '').split(',').map(function(id) { return Number(id.trim()); }).filter(Boolean); %>
                                    <% const triggerNames = plans.filter(function(p) { return triggerIds.indexOf(p.id) !== -1; }).map(function(p) { return p.name; }); %>
                                    <span class="badge badge-active"><i class="fas fa-gift mr-1"></i>Included with <%= triggerNames.length > 0 ? triggerNames.join(' or ') : 'another plan' %></span>
                                <% } else if (plan.price !== null && plan.price !== undefined) { %>
                                    <span class="badge badge-active"><%= formatMoney(plan.price, plan.currency) %>/mo</span>
                                <% } %>
                                <% if (plan.maintenance_mode) { %>
                                    <span class="badge badge-suspended"><i class="fas fa-triangle-exclamation"></i> Maintenance Mode</span>
                                <% } %>
                            </div>
                        </div>
                        <div class="flex flex-wrap gap-2">
                            <% if (sshByPlan[plan.id]) { %>
                                <span class="badge badge-active"><i class="fas fa-terminal"></i> SSH configured</span>
                            <% } else { %>
                                <span class="badge badge-suspended"><i class="fas fa-triangle-exclamation"></i> No SSH</span>
                            <% } %>
                            <span class="badge badge-answered"><i class="fas fa-users"></i> <%= subscriberCountByPlan[plan.id] || 0 %> subscriber<%= (subscriberCountByPlan[plan.id] || 0) === 1 ? '' : 's' %></span>
                            <span class="badge badge-answered"><i class="fas fa-bolt"></i> <%= (actionsByPlan[plan.id] || []).length %> action(s)</span>
                            <span class="badge badge-answered"><i class="fas fa-heart-pulse"></i> <%= (containersByPlan[plan.id] || []).length %> container(s)</span>
                        </div>
                    </div>

                    <details class="mb-3" data-ajax-key="plan-<%= plan.id %>-details">
                        <summary class="cursor-pointer text-sky-400 text-xs font-semibold uppercase tracking-wide">Plan Details &amp; Features</summary>
                        <form method="POST" action="/admin/plans/<%= plan.id %>/update" data-ajax-form class="grid sm:grid-cols-2 gap-3 mt-3">
                            <input type="text" name="name" required class="input" value="<%= plan.name %>">
                            <select name="service" class="input">
                                <option value="docker" <%= plan.service === 'docker' ? 'selected' : '' %>>Docker Hosting</option>
                                <option value="plex" <%= plan.service === 'plex' ? 'selected' : '' %>>Plex Servers</option>
                                <option value="stream" <%= plan.service === 'stream' ? 'selected' : '' %>>Stream Addons</option>
                                <option value="indexers" <%= plan.service === 'indexers' ? 'selected' : '' %>>Indexers</option>
                                <option value="hosting" <%= plan.service === 'hosting' ? 'selected' : '' %>>Web Hosting</option>
                                <option value="minecraft" <%= plan.service === 'minecraft' ? 'selected' : '' %>>Minecraft Server</option>
                                <option value="multiple" <%= plan.service === 'multiple' ? 'selected' : '' %>>Multiple Services</option>
                            </select>
                            <input type="text" name="description" class="input sm:col-span-2" value="<%= plan.description || '' %>" placeholder="Short description">
                            <select name="pricing_mode" class="input" onchange="document.getElementById('included-with-<%= plan.id %>').classList.toggle('hidden', this.value !== 'included_with')">
                                <option value="paid" <%= plan.pricing_mode === 'paid' ? 'selected' : '' %>>Paid</option>
                                <option value="free" <%= plan.pricing_mode === 'free' ? 'selected' : '' %>>Free</option>
                                <option value="included_with" <%= plan.pricing_mode === 'included_with' ? 'selected' : '' %>>Included with other plan(s)</option>
                            </select>
                            <div></div>
                            <div id="included-with-<%= plan.id %>" class="sm:col-span-2 <%= plan.pricing_mode === 'included_with' ? '' : 'hidden' %>">
                                <p class="text-slate-500 text-xs mb-2">Anyone with an active subscription to <strong>any</strong> plan checked below automatically gets this plan added too, at no extra cost, for as long as they keep one of those plans.</p>
                                <% const triggerIds = String(plan.included_with_plan_ids || '').split(',').map(function(id) { return Number(id.trim()); }).filter(Boolean); %>
                                <div class="grid sm:grid-cols-2 gap-2">
                                    <% plans.filter(function(p) { return p.id !== plan.id; }).forEach(function(p) { %>
                                        <label class="flex items-center gap-2 bg-slate-900/40 rounded-lg px-3 py-2 text-xs text-slate-300 cursor-pointer">
                                            <input type="checkbox" name="included_with_plan_ids" value="<%= p.id %>" <%= triggerIds.indexOf(p.id) !== -1 ? 'checked' : '' %> class="accent-sky-500">
                                            <%= p.name %>
                                        </label>
                                    <% }); %>
                                </div>
                            </div>
                            <input type="number" step="0.01" min="0" name="price" class="input" value="<%= plan.price !== null && plan.price !== undefined ? plan.price : '' %>" placeholder="Price (used if Paid)">
                            <select name="currency" class="input">
                                <option value="GBP" <%= plan.currency === 'GBP' ? 'selected' : '' %>>GBP (£)</option>
                                <option value="USD" <%= plan.currency === 'USD' ? 'selected' : '' %>>USD ($)</option>
                                <option value="CAD" <%= plan.currency === 'CAD' ? 'selected' : '' %>>CAD ($)</option>
                            </select>
                            <input type="text" name="server_connection_info" class="input sm:col-span-2" value="<%= plan.server_connection_info || '' %>" placeholder="Server address to show subscribers (e.g. play.example.com:25565) - optional">
                            <textarea name="features" rows="4" class="input sm:col-span-2" placeholder="One feature per line"><%= plan.features || '' %></textarea>
                            <button type="submit" class="btn-primary py-3 rounded-xl text-sm sm:col-span-2">Save Details</button>
                        </form>
                    </details>

                    <details class="mb-3" data-ajax-key="plan-<%= plan.id %>-maintenance">
                        <summary class="cursor-pointer text-amber-400 text-xs font-semibold uppercase tracking-wide">Maintenance Mode <% if (plan.maintenance_mode) { %>(currently ON)<% } %></summary>
                        <form method="POST" action="/admin/plans/<%= plan.id %>/maintenance" data-ajax-form class="grid sm:grid-cols-2 gap-3 mt-3">
                            <label class="flex items-center gap-2 text-sm text-slate-300 sm:col-span-2">
                                <input type="checkbox" name="maintenance_mode" value="on" <%= plan.maintenance_mode ? 'checked' : '' %>>
                                Show a maintenance banner to subscribers on this plan
                            </label>
                            <div>
                                <label class="text-xs uppercase tracking-widest text-slate-500 font-semibold mb-1.5 block">Expected resume time (UK time)</label>
                                <input type="datetime-local" name="maintenance_resume_at" class="input" value="<%= plan.maintenance_resume_at ? utcToLondonInputValue(plan.maintenance_resume_at) : '' %>">
                            </div>
                            <div>
                                <label class="text-xs uppercase tracking-widest text-slate-500 font-semibold mb-1.5 block">Custom message (optional)</label>
                                <input type="text" name="maintenance_message" class="input" value="<%= plan.maintenance_message || '' %>" placeholder="Default: scheduled maintenance notice">
                            </div>
                            <button type="submit" class="btn-amber py-3 rounded-xl text-sm sm:col-span-2">
                                <i class="fas fa-triangle-exclamation mr-2"></i>Save Maintenance Settings
                            </button>
                        </form>
                    </details>

                    <details class="mb-3" data-ajax-key="plan-<%= plan.id %>-ssh">
                        <summary class="cursor-pointer text-sky-400 text-xs font-semibold uppercase tracking-wide">Server / SSH Access (shared by everyone on this plan)</summary>
                        <form method="POST" action="/admin/plans/<%= plan.id %>/ssh" data-ajax-form class="grid sm:grid-cols-3 gap-3 mt-3">
                            <input type="text" name="host" required class="input" placeholder="Host / IP" value="<%= sshByPlan[plan.id] ? sshByPlan[plan.id].host : '' %>">
                            <input type="number" name="port" class="input" placeholder="Port (22)" value="<%= sshByPlan[plan.id] ? sshByPlan[plan.id].port : 22 %>">
                            <input type="text" name="username" required class="input" placeholder="SSH username" value="<%= sshByPlan[plan.id] ? sshByPlan[plan.id].username : '' %>">
                            <select name="auth_type" class="input sm:col-span-3">
                                <option value="password" <%= sshByPlan[plan.id] && sshByPlan[plan.id].auth_type === 'password' ? 'selected' : '' %>>Password</option>
                                <option value="key" <%= sshByPlan[plan.id] && sshByPlan[plan.id].auth_type === 'key' ? 'selected' : '' %>>Private Key</option>
                            </select>
                            <textarea name="secret" rows="2" class="input sm:col-span-3" placeholder="Password or private key (leave blank to keep current)"></textarea>
                            <button type="submit" class="btn-primary py-3 rounded-xl text-sm sm:col-span-3">
                                <i class="fas fa-lock mr-2"></i>Save (encrypted at rest)
                            </button>
                        </form>
                    </details>

                    <details class="mb-3" data-ajax-key="plan-<%= plan.id %>-actions">
                        <summary class="cursor-pointer text-sky-400 text-xs font-semibold uppercase tracking-wide">Action Buttons (e.g. Restart Plex)</summary>
                        <div class="mt-3 space-y-2 mb-3">
                            <% (actionsByPlan[plan.id] || []).forEach(function(action, actionIndex) { %>
                                <div class="bg-slate-900/40 rounded-lg px-3 py-2 <%= action.enabled ? '' : 'opacity-50' %>">
                                    <div class="flex items-center justify-between gap-2 text-xs text-slate-400">
                                        <span class="truncate">
                                            <i class="fas <%= action.icon %> mr-2 <%= action.style === 'danger' ? 'text-red-400' : 'text-sky-400' %>"></i><strong class="text-white"><%= action.label %></strong>
                                            <% if (action.style === 'danger') { %><span class="badge badge-expired ml-1">danger</span><% } %>
                                            <% if (!action.enabled) { %><span class="badge badge-closed ml-1">disabled</span><% } %>
                                            — <span class="font-mono"><%= action.command %></span> (every <%= action.cooldown_hours %>h)
                                        </span>
                                        <div class="flex items-center gap-0.5 flex-shrink-0">
                                            <form method="POST" action="/admin/plans/<%= plan.id %>/actions/<%= action.id %>/toggle-enabled" data-ajax-form>
                                                <button type="submit" class="w-6 h-6 rounded-lg <%= action.enabled ? 'text-emerald-400 hover:text-emerald-300' : 'text-slate-500 hover:text-white' %> hover:bg-white/5" title="<%= action.enabled ? 'Disable this action' : 'Enable this action' %>">
                                                    <i class="fas <%= action.enabled ? 'fa-toggle-on' : 'fa-toggle-off' %>"></i>
                                                </button>
                                            </form>
                                            <form method="POST" action="/admin/plans/<%= plan.id %>/actions/<%= action.id %>/move" data-ajax-form>
                                                <input type="hidden" name="direction" value="up">
                                                <button type="submit" class="w-6 h-6 rounded-lg text-slate-400 hover:text-white hover:bg-white/5" title="Move earlier" <%= actionIndex === 0 ? 'disabled style=opacity:0.3' : '' %>>
                                                    <i class="fas fa-arrow-up"></i>
                                                </button>
                                            </form>
                                            <form method="POST" action="/admin/plans/<%= plan.id %>/actions/<%= action.id %>/move" data-ajax-form>
                                                <input type="hidden" name="direction" value="down">
                                                <button type="submit" class="w-6 h-6 rounded-lg text-slate-400 hover:text-white hover:bg-white/5" title="Move later" <%= actionIndex === (actionsByPlan[plan.id] || []).length - 1 ? 'disabled style=opacity:0.3' : '' %>>
                                                    <i class="fas fa-arrow-down"></i>
                                                </button>
                                            </form>
                                            <button type="button" class="text-sky-400 hover:text-sky-300 text-xs px-1" data-toggle-target="action-<%= action.id %>-edit">
                                                <i class="fas fa-pen mr-1"></i>Edit
                                            </button>
                                        </div>
                                    </div>
                                    <div class="hidden mt-3 pt-3 border-t border-white/5" data-toggle-key="action-<%= action.id %>-edit">
                                        <form method="POST" action="/admin/plans/<%= plan.id %>/actions/<%= action.id %>/update" data-ajax-form class="grid sm:grid-cols-4 gap-3">
                                            <input type="text" name="label" required class="input" value="<%= action.label %>" placeholder="Button label">
                                            <input type="text" name="command" required class="input sm:col-span-2" value="<%= action.command %>" placeholder="Command (e.g. docker compose restart plex)">
                                            <input type="number" name="cooldown_hours" class="input" value="<%= action.cooldown_hours %>" placeholder="Cooldown hrs">
                                            <select name="icon" class="input sm:col-span-2">
                                                <% ['fa-rotate','fa-arrows-rotate','fa-power-off','fa-play','fa-stop','fa-triangle-exclamation','fa-download','fa-broom','fa-wrench','fa-server','fa-database','fa-terminal','fa-circle-play','fa-gear'].forEach(function(iconOption) { %>
                                                    <option value="<%= iconOption %>" <%= action.icon === iconOption ? 'selected' : '' %>><%= iconOption %></option>
                                                <% }); %>
                                            </select>
                                            <select name="style" onchange="toggleBannerEstimateField(this)" class="input sm:col-span-2">
                                                <option value="warning" <%= action.style !== 'danger' ? 'selected' : '' %>>Warning (amber) — quick actions like a restart</option>
                                                <option value="danger" <%= action.style === 'danger' ? 'selected' : '' %>>Danger (red) — slow/heavy actions like a full stack reset</option>
                                            </select>
                                            <div class="<%= action.style === 'danger' ? 'flex' : 'hidden' %> items-center sm:col-span-2" data-banner-estimate-field>
                                                <button type="button" onclick="toggleBannerUpdatePill(this)" class="badge <%= action.banner_time_estimate === '5-15' ? 'badge-active' : 'badge-closed' %> cursor-pointer text-xs px-3 py-1.5">Update</button>
                                                <input type="hidden" name="banner_with_update" value="<%= action.banner_time_estimate === '5-15' ? '1' : '0' %>">
                                            </div>
                                            <button type="submit" class="btn-primary py-3 rounded-xl text-sm sm:col-span-2">Save Changes</button>
                                        </form>
                                        <form method="POST" action="/admin/plans/<%= plan.id %>/actions/<%= action.id %>/delete" data-ajax-form data-confirm="Delete this action button?" class="mt-2">
                                            <button type="submit" class="text-red-400 hover:text-red-300 text-xs"><i class="fas fa-trash mr-1"></i>Delete Action</button>
                                        </form>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                        <form method="POST" action="/admin/plans/<%= plan.id %>/actions" data-ajax-form class="grid sm:grid-cols-4 gap-3">
                            <input type="text" name="label" required class="input" placeholder="Button label (e.g. Restart Plex)">
                            <input type="text" name="command" required class="input sm:col-span-2" placeholder="Command (e.g. docker compose restart plex)">
                            <input type="number" name="cooldown_hours" class="input" placeholder="Cooldown hrs (6)" value="6">
                            <select name="icon" class="input sm:col-span-2">
                                <% ['fa-rotate','fa-arrows-rotate','fa-power-off','fa-play','fa-stop','fa-triangle-exclamation','fa-download','fa-broom','fa-wrench','fa-server','fa-database','fa-terminal','fa-circle-play','fa-gear'].forEach(function(iconOption) { %>
                                    <option value="<%= iconOption %>"><%= iconOption %></option>
                                <% }); %>
                            </select>
                            <select name="style" onchange="toggleBannerEstimateField(this)" class="input sm:col-span-2">
                                <option value="warning">Warning (amber) — quick actions like a restart</option>
                                <option value="danger">Danger (red) — slow/heavy actions like a full stack reset</option>
                            </select>
                            <div class="hidden items-center sm:col-span-2" data-banner-estimate-field>
                                <button type="button" onclick="toggleBannerUpdatePill(this)" class="badge badge-closed cursor-pointer text-xs px-3 py-1.5">Update</button>
                                <input type="hidden" name="banner_with_update" value="0">
                            </div>
                            <button type="submit" class="btn-primary py-3 rounded-xl text-sm sm:col-span-4">Add Action</button>
                        </form>
                    </details>

                    <% if (plan.service === 'minecraft') { %>
                        <details class="mb-3" data-ajax-key="plan-<%= plan.id %>-deaths">
                            <summary class="cursor-pointer text-sky-400 text-xs font-semibold uppercase tracking-wide"><i class="fas fa-skull mr-1"></i>Death Counter (shown to subscribers)</summary>
                            <div class="flex items-center justify-between mt-3 mb-1">
                                <p class="text-slate-500 text-xs">Turn off to hide the whole widget from subscribers without losing any player data.</p>
                                <form method="POST" action="/admin/plans/<%= plan.id %>/death-counter/toggle-enabled" data-ajax-form class="flex-shrink-0">
                                    <button type="submit" class="badge <%= plan.death_counter_enabled ? 'badge-active' : 'badge-closed' %>"><%= plan.death_counter_enabled ? 'Enabled' : 'Disabled' %> - tap to toggle</button>
                                </form>
                            </div>
                            <form method="POST" action="/admin/plans/<%= plan.id %>/death-counter/title" data-ajax-form class="flex gap-2 mt-3 mb-3">
                                <input type="text" name="death_counter_title" class="input flex-1 text-xs" placeholder="Display title (e.g. Wall of Shame, Death Counter)" value="<%= plan.death_counter_title || '' %>">
                                <button type="submit" class="btn-outline px-4 py-2 rounded-lg text-xs">Save Title</button>
                            </form>
                            <div class="space-y-2 mb-3">
                                <% (deathCounterPlayersByPlan[plan.id] || []).forEach(function(p) { %>
                                    <div class="flex items-center justify-between bg-slate-900/40 rounded-lg px-3 py-2 gap-2">
                                        <span class="text-xs text-white font-semibold truncate flex-1 min-w-0"><i class="fas fa-skull-crossbones text-red-400 mr-1.5"></i><%= p.player_name %></span>
                                        <span class="text-sm font-bold text-white w-8 text-center flex-shrink-0"><%= p.death_count %></span>
                                        <div class="flex items-center gap-0.5 flex-shrink-0">
                                            <form method="POST" action="/admin/plans/<%= plan.id %>/death-counter/players/<%= p.id %>/decrement" data-ajax-form>
                                                <button type="submit" title="-1 death" class="w-7 h-7 rounded-lg text-slate-400 hover:text-white hover:bg-white/5"><i class="fas fa-minus text-xs"></i></button>
                                            </form>
                                            <form method="POST" action="/admin/plans/<%= plan.id %>/death-counter/players/<%= p.id %>/increment" data-ajax-form>
                                                <button type="submit" title="+1 death" class="w-7 h-7 rounded-lg text-emerald-400 hover:text-emerald-300 hover:bg-white/5"><i class="fas fa-plus text-xs"></i></button>
                                            </form>
                                            <button type="button" class="text-sky-400 hover:text-sky-300 px-1" data-toggle-target="plan-death-<%= p.id %>-edit"><i class="fas fa-pen text-xs"></i></button>
                                            <form method="POST" action="/admin/plans/<%= plan.id %>/death-counter/players/<%= p.id %>/delete" data-ajax-form>
                                                <button type="submit" class="text-red-400 hover:text-red-300 px-1"><i class="fas fa-trash text-xs"></i></button>
                                            </form>
                                        </div>
                                    </div>
                                    <div class="hidden bg-slate-900/40 rounded-lg px-3 py-2" data-toggle-key="plan-death-<%= p.id %>-edit">
                                        <form method="POST" action="/admin/plans/<%= plan.id %>/death-counter/players/<%= p.id %>/update" data-ajax-form data-no-preserve class="grid grid-cols-3 gap-2">
                                            <input type="text" name="player_name" required class="input text-xs col-span-2" value="<%= p.player_name %>">
                                            <input type="number" name="death_count" min="0" required class="input text-xs" value="<%= p.death_count %>">
                                            <button type="submit" class="btn-primary py-2 rounded-lg text-xs col-span-3">Save</button>
                                        </form>
                                    </div>
                                <% }); %>
                                <% if ((deathCounterPlayersByPlan[plan.id] || []).length === 0) { %>
                                    <p class="text-slate-500 text-xs">No players added yet.</p>
                                <% } %>
                            </div>
                            <form method="POST" action="/admin/plans/<%= plan.id %>/death-counter/players" data-ajax-form class="flex gap-2">
                                <input type="text" name="player_name" required class="input flex-1 text-xs" placeholder="Player name">
                                <button type="submit" class="btn-primary px-4 py-2 rounded-lg text-xs">Add Player</button>
                            </form>

                            <div class="mt-4 pt-4 border-t border-white/5">
                                <p class="text-xs uppercase tracking-widest text-slate-500 font-bold mb-2"><i class="fas fa-stopwatch mr-1"></i>Run Timer</p>
                                <p class="text-slate-400 text-xs mb-3">Tracks time since the last world reset. Link a manual action below to reset it automatically whenever that action succeeds, or control it manually.</p>

                                <div class="flex items-center justify-between bg-slate-900/40 rounded-lg px-3 py-3 mb-3">
                                    <span class="text-2xl font-mono font-bold text-white" data-run-timer-display data-elapsed="<%= plan.runTimerElapsedSeconds %>" data-status="<%= plan.run_timer_status %>">00:00:00</span>
                                    <span class="badge <%= plan.run_timer_status === 'running' ? 'badge-active' : 'badge-closed' %>" data-run-timer-badge><%= plan.run_timer_status === 'running' ? 'Running' : 'Stopped' %></span>
                                </div>

                                <div class="flex gap-2 mb-3">
                                    <form method="POST" action="/admin/plans/<%= plan.id %>/run-timer/start" data-ajax-form class="flex-1">
                                        <button type="submit" class="w-full btn-outline py-2 rounded-lg text-xs"><i class="fas fa-play mr-1"></i>Start</button>
                                    </form>
                                    <form method="POST" action="/admin/plans/<%= plan.id %>/run-timer/stop" data-ajax-form class="flex-1">
                                        <button type="submit" class="w-full btn-outline py-2 rounded-lg text-xs"><i class="fas fa-pause mr-1"></i>Stop</button>
                                    </form>
                                    <form method="POST" action="/admin/plans/<%= plan.id %>/run-timer/restart" data-ajax-form class="flex-1">
                                        <button type="submit" class="w-full btn-outline py-2 rounded-lg text-xs"><i class="fas fa-rotate-right mr-1"></i>Restart</button>
                                    </form>
                                </div>

                                <p class="text-slate-500 text-xs mb-1">Reset when a subscriber runs a manual action:</p>
                                <form method="POST" action="/admin/plans/<%= plan.id %>/run-timer/link" data-ajax-form class="flex gap-2 mb-3">
                                    <select name="action_id" class="input flex-1 text-xs">
                                        <option value="">No linked action (manual control only)</option>
                                        <% (actionsByPlan[plan.id] || []).forEach(function(a) { %>
                                            <option value="<%= a.id %>" <%= plan.run_timer_linked_action_id === a.id ? 'selected' : '' %>><%= a.label %></option>
                                        <% }); %>
                                    </select>
                                    <button type="submit" class="btn-outline px-4 py-2 rounded-lg text-xs whitespace-nowrap">Save Link</button>
                                </form>

                                <p class="text-slate-500 text-xs mb-1">Reset when admin runs a Health page container action:</p>
                                <form method="POST" action="/admin/plans/<%= plan.id %>/run-timer/link-container-action" data-ajax-form class="flex gap-2">
                                    <select name="container_action_id" class="input flex-1 text-xs">
                                        <option value="">No linked container action</option>
                                        <% allContainerActions.forEach(function(a) { %>
                                            <option value="<%= a.id %>" <%= plan.run_timer_linked_container_action_id === a.id ? 'selected' : '' %>><%= a.container_label %>: <%= a.label %></option>
                                        <% }); %>
                                    </select>
                                    <button type="submit" class="btn-outline px-4 py-2 rounded-lg text-xs whitespace-nowrap">Save Link</button>
                                </form>
                            </div>

                            <div class="mt-4 pt-4 border-t border-white/5">
                                <div class="flex items-center justify-between mb-3">
                                    <p class="text-xs uppercase tracking-widest text-slate-500 font-bold"><i class="fas fa-crown mr-1"></i>Bosses Beaten</p>
                                    <form method="POST" action="/admin/plans/<%= plan.id %>/bosses/toggle-enabled" data-ajax-form>
                                        <button type="submit" class="badge <%= plan.bosses_beaten_enabled ? 'badge-active' : 'badge-closed' %>"><%= plan.bosses_beaten_enabled ? 'Enabled' : 'Disabled' %> - tap to toggle</button>
                                    </form>
                                </div>
                                <p class="text-slate-400 text-xs mb-3">Shown to subscribers under the death counter when enabled. Tap an icon to mark it beaten or not.</p>
                                <div class="grid grid-cols-4 gap-2">
                                    <% BOSSES.forEach(function(boss) { %>
                                        <% var beaten = plan['boss_' + boss.key + '_beaten']; %>
                                        <form method="POST" action="/admin/plans/<%= plan.id %>/bosses/<%= boss.key %>/toggle" data-ajax-form>
                                            <button type="submit" class="w-full flex flex-col items-center gap-1.5 rounded-xl p-2 <%= beaten ? 'bg-amber-500/10 border border-amber-500/30' : 'bg-slate-900/40 border border-transparent' %>" title="<%= boss.label %> - <%= beaten ? 'Beaten' : 'Not beaten' %>">
                                                <img src="<%= boss.image %>" alt="<%= boss.label %>" class="w-10 h-10 rounded-lg <%= beaten ? '' : 'grayscale opacity-40' %>">
                                                <span class="text-[10px] text-center truncate w-full <%= beaten ? 'text-amber-300' : 'text-slate-500' %>"><%= boss.label %></span>
                                            </button>
                                        </form>
                                    <% }); %>
                                </div>
                            </div>
                        </details>
                    <% } %>

                    <% if (plan.service === 'plex' || plan.service === 'multiple') { %>
                        <details class="mb-3" data-ajax-key="plan-<%= plan.id %>-libraries" ontoggle="if (this.open) loadPlanLibraries(<%= plan.id %>)">
                            <summary class="cursor-pointer text-sky-400 text-xs font-semibold uppercase tracking-wide">Plex Libraries (shown to subscribers)</summary>
                            <p class="text-slate-500 text-xs mt-2 mb-3">Choose which libraries show an item count on this plan's dashboard card, and drag to reorder them.</p>

                            <p class="text-[10px] uppercase tracking-wide text-slate-600 font-semibold mb-1.5">Assigned</p>
                            <div id="plan-<%= plan.id %>-libraries-assigned" class="space-y-1.5 mb-4">
                                <p class="text-slate-500 text-xs"><i class="fas fa-circle-notch fa-spin mr-2"></i>Loading…</p>
                            </div>

                            <p class="text-[10px] uppercase tracking-wide text-slate-600 font-semibold mb-1.5">Available</p>
                            <div id="plan-<%= plan.id %>-libraries-available" class="space-y-1.5"></div>
                        </details>
                    <% } %>

                    <details data-ajax-key="plan-<%= plan.id %>-containers">
                        <summary class="cursor-pointer text-sky-400 text-xs font-semibold uppercase tracking-wide">Container Health (shown to subscribers)</summary>
                        <div class="mt-3 space-y-2 mb-3">
                            <% (containersByPlan[plan.id] || []).forEach(function(c, containerIndex) { %>
                                <div class="bg-slate-900/40 rounded-lg px-3 py-2">
                                    <div class="flex items-center justify-between text-xs text-slate-400 gap-2">
                                        <span class="truncate">
                                            <% if (c.link_url) { %><i class="fas fa-arrow-up-right-from-square text-sky-400 mr-1" title="Links to <%= c.link_url %>"></i><% } %>
                                            <strong class="text-white"><%= c.label %></strong> — container: <span class="font-mono"><%= c.container_name %></span>
                                        </span>
                                        <div class="flex items-center gap-0.5 flex-shrink-0">
                                            <form method="POST" action="/admin/plans/<%= plan.id %>/containers/<%= c.id %>/move" data-ajax-form>
                                                <input type="hidden" name="direction" value="up">
                                                <button type="submit" class="w-6 h-6 rounded-lg text-slate-400 hover:text-white hover:bg-white/5" title="Move earlier" <%= containerIndex === 0 ? 'disabled style=opacity:0.3' : '' %>>
                                                    <i class="fas fa-arrow-up"></i>
                                                </button>
                                            </form>
                                            <form method="POST" action="/admin/plans/<%= plan.id %>/containers/<%= c.id %>/move" data-ajax-form>
                                                <input type="hidden" name="direction" value="down">
                                                <button type="submit" class="w-6 h-6 rounded-lg text-slate-400 hover:text-white hover:bg-white/5" title="Move later" <%= containerIndex === (containersByPlan[plan.id] || []).length - 1 ? 'disabled style=opacity:0.3' : '' %>>
                                                    <i class="fas fa-arrow-down"></i>
                                                </button>
                                            </form>
                                            <button type="button" class="text-sky-400 hover:text-sky-300 px-1" data-toggle-target="plan-container-<%= c.id %>-edit"><i class="fas fa-pen"></i></button>
                                            <form method="POST" action="/admin/plans/<%= plan.id %>/containers/<%= c.id %>/delete" data-ajax-form>
                                                <button type="submit" class="text-red-400 hover:text-red-300 px-1"><i class="fas fa-trash"></i></button>
                                            </form>
                                        </div>
                                    </div>
                                    <div class="hidden mt-2 pt-2 border-t border-white/5" data-toggle-key="plan-container-<%= c.id %>-edit">
                                        <form method="POST" action="/admin/plans/<%= plan.id %>/containers/<%= c.id %>/update" data-ajax-form class="grid sm:grid-cols-3 gap-2">
                                            <input type="text" name="label" required class="input text-xs" placeholder="Display label" value="<%= c.label %>">
                                            <input type="text" name="container_name" required class="input text-xs" placeholder="Container name" value="<%= c.container_name %>">
                                            <input type="url" name="link_url" class="input text-xs" placeholder="Link URL (optional)" value="<%= c.link_url || '' %>">
                                            <button type="submit" class="btn-primary py-2 rounded-lg text-xs sm:col-span-3">Save Changes</button>
                                        </form>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                        <form method="POST" action="/admin/plans/<%= plan.id %>/containers" data-ajax-form class="grid sm:grid-cols-3 gap-3">
                            <input type="text" name="label" required class="input" placeholder="Display label (e.g. Plex Server)">
                            <input type="text" name="container_name" required class="input" placeholder="Exact container name (e.g. plex)">
                            <input type="url" name="link_url" class="input sm:col-span-3" placeholder="Link URL (optional, e.g. https://plex.example.com)">
                            <button type="submit" class="btn-primary py-3 rounded-xl text-sm sm:col-span-3">Add Container</button>
                        </form>
                    </details>

                    <form method="POST" action="/admin/plans/<%= plan.id %>/delete" data-ajax-form data-confirm="Delete this plan? Subscribers on it will lose access to its features/actions until reassigned." class="mt-4">
                        <button type="submit" class="text-red-400 hover:text-red-300 text-xs"><i class="fas fa-trash mr-1"></i>Delete Plan</button>
                    </form>
                </div>
            <% }); %>
            <% if (plans.length === 0) { %>
                <p class="text-slate-500 text-sm">No plans yet — create one above to start assigning subscribers.</p>
            <% } %>
        </div>

        <!-- Create Plan Modal -->
        <div id="createPlanModal" class="fixed inset-0 bg-black/70 backdrop-blur-sm hidden items-center justify-center z-50 px-4 py-8 overflow-y-auto">
            <div class="glass rounded-3xl p-6 sm:p-8 max-w-lg w-full my-auto">
                <div class="flex items-center justify-between mb-5">
                    <h3 class="text-lg font-bold text-white"><i class="fas fa-layer-group mr-2 text-sky-400"></i>Create a New Plan</h3>
                    <button type="button" onclick="closeModal('createPlanModal')" class="text-slate-400 hover:text-white w-8 h-8 flex items-center justify-center rounded-lg hover:bg-white/5">
                        <i class="fas fa-xmark"></i>
                    </button>
                </div>
                <form method="POST" action="/admin/plans" data-ajax-form class="grid sm:grid-cols-2 gap-4">
                    <input type="text" name="name" required class="input sm:col-span-2" placeholder="Plan name (e.g. Plex Premium)">
                    <select name="service" class="input sm:col-span-2">
                        <option value="docker">Docker Hosting</option>
                        <option value="plex">Plex Servers</option>
                        <option value="stream">Stream Addons</option>
                        <option value="indexers">Indexers</option>
                        <option value="hosting">Web Hosting</option>
                        <option value="minecraft">Minecraft Server</option>
                        <option value="multiple">Multiple Services</option>
                    </select>
                    <input type="text" name="description" class="input sm:col-span-2" placeholder="Short description (optional)">
                    <select name="pricing_mode" class="input" onchange="document.getElementById('included-with-new').classList.toggle('hidden', this.value !== 'included_with')">
                        <option value="paid">Paid</option>
                        <option value="free">Free</option>
                        <option value="included_with">Included with other plan(s)</option>
                    </select>
                    <div></div>
                    <div id="included-with-new" class="sm:col-span-2 hidden">
                        <p class="text-slate-500 text-xs mb-2">Anyone with an active subscription to <strong>any</strong> plan checked below automatically gets this plan added too, at no extra cost, for as long as they keep one of those plans.</p>
                        <div class="grid sm:grid-cols-2 gap-2">
                            <% plans.forEach(function(p) { %>
                                <label class="flex items-center gap-2 bg-slate-900/40 rounded-lg px-3 py-2 text-xs text-slate-300 cursor-pointer">
                                    <input type="checkbox" name="included_with_plan_ids" value="<%= p.id %>" class="accent-sky-500">
                                    <%= p.name %>
                                </label>
                            <% }); %>
                        </div>
                    </div>
                    <input type="number" step="0.01" min="0" name="price" class="input" placeholder="Price (used if Paid)">
                    <select name="currency" class="input">
                        <option value="GBP">GBP (£)</option>
                        <option value="USD">USD ($)</option>
                        <option value="CAD">CAD ($)</option>
                    </select>
                    <input type="text" name="server_connection_info" class="input sm:col-span-2" placeholder="Server address to show subscribers (e.g. play.example.com:25565) - optional">
                    <textarea name="features" rows="3" class="input sm:col-span-2" placeholder="One feature per line, e.g.&#10;4K Transcoding&#10;5 simultaneous streams&#10;Priority support"></textarea>
                    <button type="submit" class="btn-primary py-3 rounded-xl text-sm sm:col-span-2 mt-2">
                        <i class="fas fa-plus mr-2"></i>Create Plan
                    </button>
                </form>
            </div>
        </div>
    </main>

    <script>
        function toggleBannerEstimateField(styleSelect) {
            const field = styleSelect.closest('form').querySelector('[data-banner-estimate-field]');
            if (!field) return;
            const showing = styleSelect.value === 'danger';
            field.classList.toggle('hidden', !showing);
            field.classList.toggle('flex', showing);
        }

        function toggleBannerUpdatePill(btn) {
            const input = btn.nextElementSibling; // the paired hidden banner_with_update input, always immediately after the pill in the markup
            const willBeActive = input.value === '0';
            input.value = willBeActive ? '1' : '0';
            btn.className = 'badge ' + (willBeActive ? 'badge-active' : 'badge-closed') + ' cursor-pointer text-xs px-3 py-1.5';
        }

        function formatElapsed(totalSeconds) {
            const s = Math.max(0, totalSeconds);
            const days = Math.floor(s / 86400);
            const hours = Math.floor((s % 86400) / 3600);
            const minutes = Math.floor((s % 3600) / 60);
            const secs = s % 60;
            const pad = (n) => String(n).padStart(2, '0');
            return (days > 0 ? days + 'd ' : '') + pad(hours) + ':' + pad(minutes) + ':' + pad(secs);
        }

        function tickRunTimers() {
            document.querySelectorAll('[data-run-timer-display]').forEach(function (el) {
                let elapsed = parseInt(el.getAttribute('data-elapsed'), 10) || 0;
                if (el.getAttribute('data-status') === 'running') {
                    elapsed += 1;
                    el.setAttribute('data-elapsed', elapsed);
                }
                el.textContent = formatElapsed(elapsed);
            });
        }

        tickRunTimers();
        setInterval(tickRunTimers, 1000);

        // ---------- Plan Libraries ----------
        const PLAN_LIBRARY_ICONS = { movie: 'fa-film', show: 'fa-tv' };
        let planLibraryDragState = null;

        async function loadPlanLibraries(planId) {
            const assignedEl = document.getElementById('plan-' + planId + '-libraries-assigned');
            const availableEl = document.getElementById('plan-' + planId + '-libraries-available');
            if (!assignedEl || !availableEl) return;

            try {
                const res = await fetch('/admin/plans/' + planId + '/libraries');
                const data = await res.json();

                if (!data.ok) {
                    assignedEl.innerHTML = '<p class="text-red-400 text-xs">' + (data.message || 'Could not load libraries - check Tautulli is connected in Settings.') + '</p>';
                    availableEl.innerHTML = '';
                    return;
                }

                if (data.assigned.length === 0) {
                    assignedEl.innerHTML = '<p class="text-slate-600 text-xs">None assigned yet.</p>';
                } else {
                    assignedEl.innerHTML = data.assigned.map(function (a) {
                        const icon = a.library ? (PLAN_LIBRARY_ICONS[a.library.type] || 'fa-photo-film') : 'fa-triangle-exclamation';
                        const name = a.library ? String(a.library.name).replace(/</g, '&lt;') : 'Library no longer found in Tautulli';
                        const count = a.library ? a.library.count.toLocaleString() : '';
                        return '<div class="flex items-center gap-2 bg-slate-900/40 rounded-lg px-2.5 py-2" data-plan-library-row="' + a.id + '" draggable="true" ondragstart="planLibraryDragStart(event, ' + planId + ')" ondragover="planLibraryDragOver(event)" ondrop="planLibraryDrop(event)" ondragend="planLibraryDragEnd(event, ' + planId + ')">'
                            + '<i class="fas fa-grip-vertical text-slate-600 text-xs flex-shrink-0" style="cursor: grab;"></i>'
                            + '<i class="fas ' + icon + ' text-sky-400 text-xs flex-shrink-0"></i>'
                            + '<span class="text-white text-xs truncate flex-1">' + name + '</span>'
                            + (count ? '<span class="text-slate-500 text-[11px] font-mono flex-shrink-0">' + count + '</span>' : '')
                            + '<button type="button" onclick="removePlanLibrary(' + planId + ', ' + a.id + ')" class="text-red-400 hover:text-red-300 text-xs flex-shrink-0 px-1"><i class="fas fa-xmark"></i></button>'
                            + '</div>';
                    }).join('');
                }

                if (data.available.length === 0) {
                    availableEl.innerHTML = '<p class="text-slate-600 text-xs">All libraries are already assigned.</p>';
                } else {
                    availableEl.innerHTML = data.available.map(function (lib) {
                        const icon = PLAN_LIBRARY_ICONS[lib.type] || 'fa-photo-film';
                        const name = String(lib.name).replace(/</g, '&lt;');
                        return '<button type="button" onclick="addPlanLibrary(' + planId + ', \'' + lib.sectionId + '\')" class="flex items-center gap-2 bg-slate-900/20 hover:bg-slate-900/40 rounded-lg px-2.5 py-2 w-full text-left transition">'
                            + '<i class="fas ' + icon + ' text-slate-500 text-xs flex-shrink-0"></i>'
                            + '<span class="text-slate-300 text-xs truncate flex-1">' + name + '</span>'
                            + '<span class="text-slate-600 text-[11px] font-mono flex-shrink-0">' + lib.count.toLocaleString() + '</span>'
                            + '<i class="fas fa-plus text-sky-400 text-xs flex-shrink-0"></i>'
                            + '</button>';
                    }).join('');
                }
            } catch (e) {
                assignedEl.innerHTML = '<p class="text-red-400 text-xs">Could not reach the server.</p>';
                availableEl.innerHTML = '';
            }
        }

        async function addPlanLibrary(planId, sectionId) {
            try {
                await fetch('/admin/plans/' + planId + '/libraries', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: 'section_id=' + encodeURIComponent(sectionId),
                });
                loadPlanLibraries(planId);
            } catch (e) {
                showToast('Could not reach the server to add this library.', 'error');
            }
        }

        async function removePlanLibrary(planId, libraryId) {
            try {
                await fetch('/admin/plans/' + planId + '/libraries/' + libraryId + '/delete', { method: 'POST' });
                loadPlanLibraries(planId);
            } catch (e) {
                showToast('Could not reach the server to remove this library.', 'error');
            }
        }

        function planLibraryDragStart(event, planId) {
            planLibraryDragState = { row: event.currentTarget, planId };
            event.currentTarget.classList.add('opacity-40');
            event.dataTransfer.effectAllowed = 'move';
            event.dataTransfer.setData('text/plain', '');
        }

        function planLibraryDragOver(event) {
            event.preventDefault();
            if (!planLibraryDragState) return;
            const row = event.currentTarget;
            if (row === planLibraryDragState.row) return;
            const rect = row.getBoundingClientRect();
            const draggingDown = event.clientY > rect.top + rect.height / 2;
            row.parentElement.insertBefore(planLibraryDragState.row, draggingDown ? row.nextSibling : row);
        }

        function planLibraryDrop(event) {
            event.preventDefault();
        }

        async function planLibraryDragEnd(event, planId) {
            event.currentTarget.classList.remove('opacity-40');
            if (!planLibraryDragState) return;
            planLibraryDragState = null;

            const container = document.getElementById('plan-' + planId + '-libraries-assigned');
            const ids = Array.from(container.querySelectorAll('[data-plan-library-row]')).map(function (el) { return el.getAttribute('data-plan-library-row'); });

            try {
                await fetch('/admin/plans/' + planId + '/libraries/reorder', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: ids.map(function (id) { return 'ids=' + encodeURIComponent(id); }).join('&'),
                });
            } catch (e) {
                showToast('Could not reach the server to save the new order.', 'error');
            }
        }
    </script>
</body>
</html>
