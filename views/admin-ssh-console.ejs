<!DOCTYPE html>
<html lang="en">
<head>
    <% pageTitle = 'SSH Console' %>
    <%- include('partials/head') %>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/xterm/5.5.0/xterm.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xterm/5.5.0/xterm.js"></script>
    <style>
        .xterm { padding: 12px; height: 100%; }
        .xterm-viewport { border-radius: 0 0 1rem 1rem; }
    </style>
</head>
<body class="antialiased overflow-x-hidden">
    <%- include('partials/nav') %>

    <main class="max-w-4xl mx-auto px-4 sm:px-6 py-8 sm:py-10 pb-24">
        <h1 class="text-2xl sm:text-3xl font-extrabold mb-2">SSH Console</h1>
        <p class="text-slate-400 text-sm mb-8">A real interactive terminal to your server, auto-authenticated with the SSH access already saved in Settings. Type commands, run interactive programs, use Ctrl+C - it behaves like a normal terminal because it is one.</p>

        <% if (!sshConfigured) { %>
            <div class="mb-8 px-4 sm:px-5 py-4 rounded-xl bg-amber-500/10 border border-amber-500/30 text-amber-400 text-sm flex items-center justify-between flex-wrap gap-3">
                <span><i class="fas fa-triangle-exclamation mr-2"></i>No server access configured yet.</span>
                <a href="/admin/settings" class="btn-amber px-4 py-2 rounded-lg text-xs whitespace-nowrap">Set Up in Settings</a>
            </div>
        <% } else { %>
            <div class="glass rounded-2xl sm:rounded-3xl overflow-hidden mb-8">
                <div class="flex items-center justify-between gap-2 px-5 py-3 border-b border-white/10 flex-wrap">
                    <div class="flex items-center gap-2">
                        <span id="termStatusDot" class="w-2 h-2 rounded-full bg-amber-400"></span>
                        <span id="termStatusText" class="text-xs text-slate-400">Connecting…</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <button type="button" id="termReconnectBtn" onclick="connectTerminal()" class="hidden text-xs px-3 py-1.5 rounded-lg btn-outline">
                            <i class="fas fa-rotate mr-1.5"></i>Reconnect
                        </button>
                        <button type="button" onclick="term && term.clear()" title="Clear screen" class="w-8 h-8 flex items-center justify-center rounded-lg text-slate-400 hover:text-white hover:bg-white/5">
                            <i class="fas fa-broom"></i>
                        </button>
                    </div>
                </div>
                <div id="terminalContainer" style="height: 60vh; background: #0b1120;"></div>
            </div>
        <% } %>

        <h2 class="text-sm uppercase tracking-widest text-slate-500 font-bold mb-4">Recent Sessions</h2>
        <div class="glass rounded-2xl overflow-x-auto">
            <% if (history.length === 0) { %>
                <p class="text-slate-500 text-sm p-6">No sessions yet.</p>
            <% } else { %>
                <% var logPageSize = 5; var logPageCount = Math.ceil(history.length / logPageSize); %>
                <table class="kb-table min-w-[560px]">
                    <thead><tr><th>Session</th><th>Time (UK)</th><th>Result</th></tr></thead>
                    <% for (var p = 0; p < logPageCount; p++) { %>
                        <tbody data-log-page="<%= p %>" class="<%= p === 0 ? '' : 'hidden' %>">
                            <% history.slice(p * logPageSize, p * logPageSize + logPageSize).forEach(function(h) { %>
                                <tr>
                                    <td class="text-slate-300 font-mono text-xs"><%= h.command %><% if (h.output) { %><span class="text-slate-500"> — <%= h.output %></span><% } %></td>
                                    <td class="text-slate-500 text-xs"><%= formatUK(h.requested_at) %></td>
                                    <td><span class="badge <%= h.success ? 'badge-active' : 'badge-expired' %>"><%= h.success ? 'Success' : 'Failed' %></span></td>
                                </tr>
                            <% }); %>
                        </tbody>
                    <% } %>
                </table>
                <% if (logPageCount > 1) { %>
                    <div class="flex items-center justify-center gap-1.5 p-4 border-t border-white/5">
                        <% for (var p = 0; p < logPageCount; p++) { %>
                            <button type="button" onclick="showLogPage(<%= p %>)" data-log-page-btn="<%= p %>" class="w-7 h-7 rounded-lg text-xs font-semibold <%= p === 0 ? 'bg-sky-500/20 text-sky-400 border border-sky-500/40' : 'text-slate-400 hover:text-white hover:bg-white/5' %>"><%= p + 1 %></button>
                        <% } %>
                    </div>
                <% } %>
            <% } %>
        </div>
    </main>

    <script>
        // Independent of the terminal script below (which only renders when
        // SSH is configured) - historical session logs can still exist and
        // need pagination even if SSH access was since removed.
        function showLogPage(page) {
            document.querySelectorAll('[data-log-page]').forEach(function (tbody) {
                tbody.classList.toggle('hidden', tbody.getAttribute('data-log-page') !== String(page));
            });
            document.querySelectorAll('[data-log-page-btn]').forEach(function (btn) {
                const isActive = btn.getAttribute('data-log-page-btn') === String(page);
                btn.className = 'w-7 h-7 rounded-lg text-xs font-semibold ' + (isActive
                    ? 'bg-sky-500/20 text-sky-400 border border-sky-500/40'
                    : 'text-slate-400 hover:text-white hover:bg-white/5');
            });
        }
    </script>

    <% if (sshConfigured) { %>
    <script>
        let term = null;
        let initError = null;
        try {
            if (typeof Terminal === 'undefined') throw new Error('The terminal library failed to load (likely blocked by a network filter, ad-blocker, or content security policy).');
            term = new Terminal({
                cursorBlink: true,
                fontSize: 14,
                fontFamily: 'Menlo, Monaco, "Courier New", monospace',
                theme: {
                    background: '#0b1120',
                    foreground: '#e2e8f0',
                    cursor: '#38bdf8',
                    selectionBackground: '#38bdf844',
                },
            });
            term.open(document.getElementById('terminalContainer'));
        } catch (e) {
            initError = e;
        }

        let ws = null;
        let measuredCell = null; // { width, height } in px, for the manual fit calculation below

        // No fit addon here (deliberately) - a hidden span with the same
        // font measures one character cell directly, independent of
        // xterm's own render state (which may not have any measurable
        // content yet on first connect). This is the same basic technique
        // xterm's own fit addon uses internally, just without the extra
        // dependency. rows/cols are floor()'d so the terminal never
        // overflows its container.
        function measureCell() {
            const span = document.createElement('span');
            span.style.cssText = 'position:absolute;visibility:hidden;white-space:pre;top:-9999px;left:-9999px;'
                + 'font-family:' + term.options.fontFamily + ';font-size:' + term.options.fontSize + 'px;';
            span.textContent = 'W'.repeat(20);
            document.body.appendChild(span);
            const rect = span.getBoundingClientRect();
            document.body.removeChild(span);
            if (rect.width === 0) return null;
            return { width: rect.width / 20, height: Math.round(term.options.fontSize * 1.2) };
        }

        function fitTerminal() {
            if (!term) return null;
            const container = document.getElementById('terminalContainer');
            if (!container) return null;
            if (!measuredCell) measuredCell = measureCell();
            if (!measuredCell) return null;

            const cols = Math.max(20, Math.floor(container.clientWidth / measuredCell.width));
            const rows = Math.max(10, Math.floor(container.clientHeight / measuredCell.height));
            if (cols !== term.cols || rows !== term.rows) term.resize(cols, rows);
            return { cols: term.cols, rows: term.rows };
        }

        function setStatus(text, tone) {
            const dot = document.getElementById('termStatusDot');
            const label = document.getElementById('termStatusText');
            const colors = { connecting: 'bg-amber-400', connected: 'bg-emerald-400', disconnected: 'bg-slate-600', error: 'bg-red-400' };
            dot.className = 'w-2 h-2 rounded-full ' + (colors[tone] || colors.disconnected);
            label.textContent = text;
            document.getElementById('termReconnectBtn').classList.toggle('hidden', tone !== 'disconnected' && tone !== 'error');
        }

        const CONNECT_TIMEOUT_MS = 12000;
        let connectTimeoutTimer = null;
        let hadError = false; // so onclose (which fires right after onerror on a failed connection) doesn't stomp over a more specific error message with a generic "Disconnected"

        function connectTerminal() {
            if (initError) {
                setStatus('Failed to load terminal', 'error');
                if (term) term.write('\r\n\x1b[31m' + initError.message + '\x1b[0m\r\n');
                return;
            }

            if (ws) { try { ws.close(); } catch (e) {} }
            hadError = false;
            setStatus('Connecting…', 'connecting');

            clearTimeout(connectTimeoutTimer);
            connectTimeoutTimer = setTimeout(function () {
                // Covers the case where the connection just silently never
                // completes - no onopen, no onerror, no onclose at all (a
                // common symptom when a reverse proxy in front of this app
                // isn't configured to forward WebSocket upgrade requests).
                // Without this, the page would otherwise sit on
                // "Connecting…" forever with zero feedback.
                hadError = true;
                setStatus('Connection timed out', 'error');
                if (term) term.write('\r\n\x1b[31mConnection timed out. If this keeps happening, check that your reverse proxy (if any) is configured to forward WebSocket upgrade requests.\x1b[0m\r\n');
                if (ws) { try { ws.close(); } catch (e) {} }
            }, CONNECT_TIMEOUT_MS);

            const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
            ws = new WebSocket(protocol + '//' + window.location.host + '/admin/ssh-console/ws');

            ws.onmessage = function (event) {
                const msg = JSON.parse(event.data);
                if (msg.type === 'ready') {
                    clearTimeout(connectTimeoutTimer);
                    setStatus('Connected', 'connected');
                    measuredCell = null; // re-measure now that real content may be about to render
                    setTimeout(() => {
                        const dims = fitTerminal();
                        if (dims) ws.send(JSON.stringify({ type: 'resize', rows: dims.rows, cols: dims.cols }));
                        term.focus();
                    }, 50);
                } else if (msg.type === 'data') {
                    term.write(msg.data);
                } else if (msg.type === 'error') {
                    clearTimeout(connectTimeoutTimer);
                    hadError = true;
                    setStatus('Error', 'error');
                    term.write('\r\n\x1b[31m' + msg.message + '\x1b[0m\r\n');
                }
            };

            ws.onclose = function () {
                clearTimeout(connectTimeoutTimer);
                if (!hadError) setStatus('Disconnected', 'disconnected');
            };

            ws.onerror = function () {
                clearTimeout(connectTimeoutTimer);
                hadError = true;
                setStatus('Connection error', 'error');
            };
        }

        if (term) {
            term.onData(function (data) {
                if (ws && ws.readyState === WebSocket.OPEN) ws.send(JSON.stringify({ type: 'input', data: data }));
            });
        }

        let resizeTimer = null;
        window.addEventListener('resize', function () {
            clearTimeout(resizeTimer);
            resizeTimer = setTimeout(function () {
                const dims = fitTerminal();
                if (dims && ws && ws.readyState === WebSocket.OPEN) ws.send(JSON.stringify({ type: 'resize', rows: dims.rows, cols: dims.cols }));
            }, 200);
        });

        connectTerminal();
    </script>
    <% } %>
</body>
</html>
