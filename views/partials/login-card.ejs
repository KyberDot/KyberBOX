<div class="login-panel">
    <div class="login-error-box <%= error ? '' : 'hidden' %> mb-5 px-4 py-3 rounded-xl bg-red-500/10 border border-red-500/30 text-red-400 text-sm">
        <i class="fas fa-triangle-exclamation mr-2"></i><span class="login-error-text"><%= error || '' %></span>
    </div>
    <form class="login-form space-y-4">
        <div>
            <label class="text-xs uppercase tracking-widest text-slate-500 font-semibold mb-2 block">Email</label>
            <input type="email" name="email" required autocomplete="email" class="input" placeholder="you@example.com">
        </div>
        <div>
            <div class="flex items-center justify-between mb-2">
                <label class="text-xs uppercase tracking-widest text-slate-500 font-semibold">Password</label>
                <a href="/forgot-password" class="text-xs text-sky-400 hover:text-sky-300">Forgot password?</a>
            </div>
            <input type="password" name="password" required autocomplete="current-password" class="input" placeholder="••••••••">
        </div>
        <button type="submit" class="w-full btn-primary py-4 rounded-2xl text-sm mt-2">
            <i class="fas fa-right-to-bracket mr-2"></i> <span class="login-submit-label">Sign In</span>
        </button>
    </form>
</div>

<div class="twofa-panel hidden">
    <div class="twofa-error-box hidden mb-5 px-4 py-3 rounded-xl bg-red-500/10 border border-red-500/30 text-red-400 text-sm">
        <i class="fas fa-triangle-exclamation mr-2"></i><span class="twofa-error-text"></span>
    </div>
    <form class="twofa-form space-y-4">
        <div>
            <div class="flex items-center justify-between mb-2">
                <label class="text-xs uppercase tracking-widest text-slate-500 font-semibold"><i class="fas fa-shield-halved mr-1.5 text-sky-400"></i>Verification Code</label>
                <button type="button" class="twofa-cancel-btn text-xs text-sky-400 hover:text-sky-300">Use a different account</button>
            </div>
            <input
                type="text"
                name="code"
                autocomplete="one-time-code"
                inputmode="numeric"
                class="input text-center text-xl tracking-[0.4em] font-mono"
                placeholder="000000"
                maxlength="11"
            >
        </div>
        <p class="text-slate-500 text-xs">Enter the 6-digit code from your authenticator app, or a recovery code.</p>
        <button type="submit" class="w-full btn-primary py-4 rounded-2xl text-sm mt-2">
            <i class="fas fa-right-to-bracket mr-2"></i> <span class="twofa-submit-label">Verify</span>
        </button>
    </form>
</div>
