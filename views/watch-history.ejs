<!DOCTYPE html>
<html lang="en">
<head>
    <% pageTitle = 'Watch History | ' + siteName %>
    <%- include('partials/head') %>
</head>
<body class="antialiased overflow-x-hidden">
    <%- include('partials/nav') %>

    <main class="max-w-3xl mx-auto px-4 sm:px-6 py-8 sm:py-10 pb-24">
        <h1 class="text-2xl sm:text-3xl font-extrabold mb-1">Watch History</h1>
        <p class="text-slate-400 mb-8 sm:mb-10 text-sm sm:text-base">Your recent Plex activity, live from <%= siteName %>.</p>

        <% if (!hasPlexPlan) { %>
            <div class="glass rounded-2xl sm:rounded-3xl p-5 sm:p-8 text-slate-400 text-sm">
                This page is only available on a Plex plan. If you think this is wrong, <a href="/support" class="text-sky-400 hover:text-sky-300">raise a ticket</a> and we'll take a look.
            </div>
        <% } else { %>
            <div class="glass rounded-2xl sm:rounded-3xl p-5 sm:p-8">
                <div id="watchHistoryList" class="space-y-2">
                    <p class="text-slate-500 text-sm"><i class="fas fa-circle-notch fa-spin mr-2"></i>Loading…</p>
                </div>
                <div id="watchHistoryPagination" class="hidden flex items-center justify-center gap-1.5 flex-wrap mt-6"></div>
            </div>
        <% } %>
    </main>

    <% if (hasPlexPlan) { %>
    <script>
        let currentPage = 1;

        const mediaIcon = function (type) {
            if (type === 'movie') return 'fa-film';
            if (type === 'episode') return 'fa-tv';
            if (type === 'track') return 'fa-music';
            return 'fa-play';
        };

        function renderPagination(page, totalPages) {
            const bar = document.getElementById('watchHistoryPagination');
            if (totalPages <= 1) {
                bar.classList.add('hidden');
                bar.innerHTML = '';
                return;
            }
            bar.classList.remove('hidden');

            const pageBtn = function (label, targetPage, isActive, isDisabled) {
                const base = 'w-8 h-8 flex items-center justify-center rounded-lg text-xs font-semibold ';
                if (isDisabled) return '<span class="' + base + 'text-slate-700">' + label + '</span>';
                if (isActive) return '<span class="' + base + 'bg-sky-500 text-[#0b0f1a]">' + label + '</span>';
                return '<button type="button" onclick="loadWatchHistory(' + targetPage + ')" class="' + base + 'text-slate-400 hover:text-white hover:bg-white/5">' + label + '</button>';
            };

            // Simple windowed page list: first, last, and a few around the current page.
            const pages = [];
            for (let p = 1; p <= totalPages; p++) {
                if (p === 1 || p === totalPages || Math.abs(p - page) <= 1) pages.push(p);
                else if (pages[pages.length - 1] !== '…') pages.push('…');
            }

            let html = pageBtn('<i class="fas fa-angle-left"></i>', page - 1, false, page <= 1);
            pages.forEach(function (p) {
                html += p === '…'
                    ? '<span class="w-8 h-8 flex items-center justify-center text-slate-600 text-xs">…</span>'
                    : pageBtn(p, p, p === page, false);
            });
            html += pageBtn('<i class="fas fa-angle-right"></i>', page + 1, false, page >= totalPages);

            bar.innerHTML = html;
        }

        async function loadWatchHistory(page) {
            currentPage = page || currentPage;
            const list = document.getElementById('watchHistoryList');
            list.innerHTML = '<p class="text-slate-500 text-sm"><i class="fas fa-circle-notch fa-spin mr-2"></i>Loading…</p>';

            try {
                const res = await fetch('/dashboard/plex/history?page=' + currentPage);
                const data = await res.json();

                if (!data.ok) {
                    list.innerHTML = '<p class="text-slate-500 text-sm">' + (data.message || 'Could not load your Plex activity.') + '</p>';
                    document.getElementById('watchHistoryPagination').classList.add('hidden');
                    return;
                }
                if (!data.items || data.items.length === 0) {
                    list.innerHTML = '<p class="text-slate-500 text-sm">No watch history yet.</p>';
                    document.getElementById('watchHistoryPagination').classList.add('hidden');
                    return;
                }

                list.innerHTML = data.items.map(function (item) {
                    const percent = typeof item.percentComplete === 'number' ? item.percentComplete : null;
                    return '<div class="flex items-center justify-between gap-3 bg-slate-900/40 rounded-xl px-4 py-3">' +
                        '<div class="flex items-center gap-3 min-w-0">' +
                        '<i class="fas ' + mediaIcon(item.mediaType) + ' text-slate-500 text-sm flex-shrink-0"></i>' +
                        '<span class="text-sm text-slate-300 truncate">' + item.title + '</span>' +
                        '</div>' +
                        '<div class="flex items-center gap-3 flex-shrink-0">' +
                        (percent !== null ? '<span class="text-slate-500 text-xs">' + percent + '%</span>' : '') +
                        '<span class="text-slate-500 text-xs">' + (item.watchedAtLabel || '') + '</span>' +
                        '</div></div>';
                }).join('');

                renderPagination(data.page || currentPage, data.totalPages || 1);
                window.scrollTo({ top: 0, behavior: 'smooth' });
            } catch (e) {
                list.innerHTML = '<p class="text-slate-500 text-sm">Could not load your Plex activity.</p>';
            }
        }

        loadWatchHistory(1);
    </script>
    <% } %>
</body>
</html>
