<!DOCTYPE html>
<html lang="en">
<head>
    <% pageTitle = 'My Account | ' + siteName %>
    <%- include('partials/head') %>
</head>
<body class="antialiased overflow-x-hidden">
    <%- include('partials/nav') %>

    <main class="max-w-5xl mx-auto px-4 sm:px-6 py-8 sm:py-10 relative">
        <div class="hero-glow" style="top:0;"></div>

        <div class="relative z-10">
            <h1 class="text-2xl sm:text-3xl font-extrabold mb-1">Welcome back, <%= currentUser.name.split(' ')[0] %></h1>
            <p class="text-slate-400 mb-2 text-sm sm:text-base">Here's what's happening with your account.</p>
            <% if (paymentMethodName) { %>
                <p class="text-slate-500 text-xs mb-8 sm:mb-10"><i class="fas fa-credit-card mr-1.5"></i>Payment method on file: <span class="text-slate-300"><%= paymentMethodName %></span></p>
            <% } else { %>
                <div class="mb-8 sm:mb-10"></div>
            <% } %>

            <!-- Now Watching (hidden until there's an active Plex session) -->
            <% if (hasPlexPlan) { %>
                <div id="nowWatchingSection" class="hidden mb-8">
                    <p class="text-xs uppercase tracking-widest text-slate-500 font-semibold mb-3">Now Watching</p>
                    <div id="nowWatchingContent" class="glass rounded-3xl p-4 sm:p-5"></div>
                </div>
            <% } %>

            <!-- Maintenance banners -->
            <% planViews.forEach(function(pv) { %>
                <% if (pv.plan.maintenance_mode) { %>
                    <div class="mb-6 px-4 sm:px-5 py-4 rounded-xl bg-amber-500/10 border border-amber-500/30 text-amber-400 text-sm">
                        <i class="fas fa-screwdriver-wrench mr-2"></i>
                        <strong><%= serviceLabel(pv.plan.service) %> is under maintenance.</strong>
                        <% if (pv.plan.maintenance_message) { %>
                            <%= pv.plan.maintenance_message %>
                        <% } %>
                        <% if (pv.plan.maintenance_resume_at) { %>
                            We expect to resume by <strong><%= formatUK(pv.plan.maintenance_resume_at) %></strong>.
                        <% } %>
                    </div>
                <% } %>
            <% }); %>

            <% if (legacySubscriptions.length > 0) { %>
                <div class="mb-8 px-4 sm:px-5 py-4 rounded-xl bg-amber-500/10 border border-amber-500/30 text-amber-400 text-sm">
                    <i class="fas fa-triangle-exclamation mr-2"></i>Some of your subscriptions haven't been assigned to a plan yet — contact support if you don't see the features you expect below.
                </div>
            <% } %>

            <% if (planViews.length === 0 && legacySubscriptions.length === 0) { %>
                <div class="glass rounded-2xl p-6 text-slate-400 text-sm mb-10">
                    No subscriptions on file yet. Please contact support if this seems wrong.
                </div>
            <% } %>

            <!-- One card per active plan subscription -->
            <% planViews.forEach(function(pv) { %>
                <div class="glass rounded-3xl p-5 sm:p-8 mb-8">
                    <div class="flex flex-wrap items-start justify-between gap-3 mb-2">
                        <div>
                            <p class="text-xs uppercase tracking-widest text-slate-500 font-semibold mb-1"><%= pv.plan.service %></p>
                            <h2 class="text-lg sm:text-xl font-bold text-white"><%= pv.plan.name %></h2>
                            <% if (pv.plan.description) { %>
                                <p class="text-slate-400 text-sm mt-1"><%= pv.plan.description %></p>
                            <% } %>
                        </div>
                        <div class="text-right flex-shrink-0">
                            <span class="badge badge-<%= pv.subscription.status %>"><%= pv.subscription.status %></span>
                            <% if (pv.plan.price !== null && pv.plan.price !== undefined) { %>
                                <p class="text-white font-bold mt-2"><%= formatMoney(pv.plan.price, pv.plan.currency) %><span class="text-slate-500 text-xs font-normal">/mo</span></p>
                            <% } %>
                        </div>
                    </div>
                    <% if (pv.subscription.expires_at) { %>
                        <p class="text-slate-500 text-xs mb-5">
                            <% if (pv.subscription.renewal_mode === 'auto') { %>
                                <i class="fas fa-rotate mr-1"></i>Auto-renews on <%= formatUKDate(pv.subscription.expires_at) %>
                            <% } else if (pv.subscription.status === 'expired' || pv.subscription.renewal_mode === 'expired') { %>
                                <i class="fas fa-triangle-exclamation mr-1 text-red-400"></i>Expired <%= formatUKDate(pv.subscription.expires_at) %>
                            <% } else { %>
                                <i class="fas fa-calendar mr-1"></i>Renews on <%= formatUKDate(pv.subscription.expires_at) %> (manual renewal)
                            <% } %>
                        </p>
                    <% } %>

                    <!-- Features -->
                    <% if (pv.plan.features) { %>
                        <div class="mb-6">
                            <p class="text-xs uppercase tracking-widest text-slate-500 font-semibold mb-3">Included with this plan</p>
                            <ul class="grid sm:grid-cols-2 gap-2">
                                <% pv.plan.features.split('\n').filter(f => f.trim()).forEach(function(feature) { %>
                                    <li class="flex items-start gap-2 text-sm text-slate-300">
                                        <i class="fas fa-check text-emerald-400 mt-1 text-xs"></i>
                                        <span><%= feature.trim() %></span>
                                    </li>
                                <% }); %>
                            </ul>
                        </div>
                    <% } %>

                    <!-- Container health -->
                    <% if (pv.containers.length > 0) { %>
                        <div class="mb-6" data-plan-id="<%= pv.plan.id %>" data-health-container>
                            <div class="flex items-center justify-between mb-3">
                                <p class="text-xs uppercase tracking-widest text-slate-500 font-semibold">Server Status</p>
                                <button type="button" class="w-6 h-6 flex items-center justify-center rounded-lg text-slate-500 hover:text-white hover:bg-white/5 text-xs" title="Refresh status" data-plan-refresh-btn data-plan-id="<%= pv.plan.id %>">
                                    <i class="fas fa-arrows-rotate"></i>
                                </button>
                            </div>
                            <div class="grid sm:grid-cols-2 gap-2">
                                <% pv.containers.forEach(function(c) { %>
                                    <div class="flex items-center justify-between bg-slate-900/40 rounded-xl px-4 py-3" data-container-name="<%= c.container_name %>">
                                        <span class="text-sm text-slate-300"><%= c.label %></span>
                                        <span class="badge badge-suspended" data-status-pill><i class="fas fa-circle-notch fa-spin"></i> checking</span>
                                    </div>
                                <% }); %>
                            </div>
                        </div>
                    <% } %>

                    <!-- Actions -->
                    <% if (pv.actions.length > 0) { %>
                        <div class="flex flex-col sm:flex-row sm:flex-wrap gap-4">
                            <% pv.actions.forEach(function(action) { %>
                                <button
                                    class="<%= action.style === 'danger' ? 'btn-danger' : 'btn-amber' %> px-6 py-3 rounded-2xl text-sm w-full sm:w-auto flex flex-col items-center justify-center gap-1.5"
                                    data-action-btn
                                    data-action-id="<%= action.id %>"
                                    data-action-label="<%= action.label %>"
                                    data-action-style="<%= action.style || 'warning' %>"
                                    data-cooldown-hours="<%= action.cooldown_hours %>"
                                    <%= (action.nextAllowedAt || pv.plan.maintenance_mode) ? 'disabled' : '' %>
                                >
                                    <span class="flex items-center">
                                        <i class="fas <%= action.icon %> mr-2"></i>
                                        <span data-action-btn-label><%= pv.plan.maintenance_mode ? 'Unavailable (Maintenance)' : (action.nextAllowedAt ? action.label + ' Unavailable' : action.label) %></span>
                                    </span>
                                    <% if (!pv.plan.maintenance_mode) { %>
                                        <span class="countdown-chip <%= action.nextAllowedAt ? '' : 'hidden' %>"
                                              data-cooldown-timer
                                              data-action-id="<%= action.id %>"
                                              data-action-label="<%= action.label %>"
                                              data-next-allowed-at="<%= action.nextAllowedAt || '' %>">
                                            <i class="fas fa-clock"></i>
                                            <span data-countdown-text class="font-mono tabular-nums">--:--:--</span>
                                        </span>
                                    <% } %>
                                </button>
                            <% }); %>
                        </div>
                        <div id="actionResult-<%= pv.plan.id %>" class="mt-4 hidden text-sm rounded-xl p-4"></div>
                        <a href="/support?category=<%= pv.plan.service %>"
                           class="btn-outline inline-block text-center px-6 py-3 rounded-2xl text-sm mt-4">
                            <i class="fas fa-life-ring mr-2"></i> Still having issues? Raise a ticket
                        </a>
                    <% } %>
                </div>
            <% }); %>
        </div>
    </main>

    <!-- Confirmation Modal (shared by all action buttons) -->
    <div id="actionModal" class="fixed inset-0 bg-black/70 backdrop-blur-sm hidden items-center justify-center z-50 px-6">
        <div class="glass rounded-3xl p-8 max-w-sm w-full text-center">
            <div id="actionModalIconWrap" class="w-16 h-16 mx-auto rounded-full bg-amber-500/10 border border-amber-500/30 flex items-center justify-center mb-5">
                <i id="actionModalIcon" class="fas fa-triangle-exclamation text-amber-400 text-2xl"></i>
            </div>
            <h3 id="actionModalTitle" class="text-lg font-bold text-white mb-2">Run this action?</h3>
            <p id="actionModalBody" class="text-slate-400 text-sm mb-6"></p>
            <div class="flex gap-3">
                <button onclick="closeActionModal()" class="btn-outline flex-1 py-3 rounded-xl text-sm">Cancel</button>
                <button id="actionModalConfirmBtn" onclick="confirmAction()" class="btn-amber flex-1 py-3 rounded-xl text-sm">Yes, Continue</button>
            </div>
        </div>
    </div>

    <script>
        let pendingActionBtn = null;

        document.querySelectorAll('[data-action-btn]').forEach(function(btn) {
            btn.addEventListener('click', function() {
                if (btn.disabled) return;
                pendingActionBtn = btn;
                const label = btn.getAttribute('data-action-label');
                const hours = btn.getAttribute('data-cooldown-hours');
                const style = btn.getAttribute('data-action-style') || 'warning';
                const isDanger = style === 'danger';

                document.getElementById('actionModalTitle').textContent = label + ' now?';

                let body = 'This will run "' + label + '" on your server. You\'ll only be able to do this again in ' + hours + ' hour(s).';
                if (isDanger) {
                    body += ' This action can take between 5–15 minutes to finish — please don\'t close this tab while it runs.';
                }
                document.getElementById('actionModalBody').textContent = body;

                const iconWrap = document.getElementById('actionModalIconWrap');
                const icon = document.getElementById('actionModalIcon');
                const confirmBtn = document.getElementById('actionModalConfirmBtn');
                if (isDanger) {
                    iconWrap.className = 'w-16 h-16 mx-auto rounded-full bg-red-500/10 border border-red-500/30 flex items-center justify-center mb-5';
                    icon.className = 'fas fa-triangle-exclamation text-red-400 text-2xl';
                    confirmBtn.className = 'btn-danger flex-1 py-3 rounded-xl text-sm';
                } else {
                    iconWrap.className = 'w-16 h-16 mx-auto rounded-full bg-amber-500/10 border border-amber-500/30 flex items-center justify-center mb-5';
                    icon.className = 'fas fa-triangle-exclamation text-amber-400 text-2xl';
                    confirmBtn.className = 'btn-amber flex-1 py-3 rounded-xl text-sm';
                }

                const modal = document.getElementById('actionModal');
                modal.classList.remove('hidden');
                modal.classList.add('flex');
            });
        });

        function closeActionModal() {
            const modal = document.getElementById('actionModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            pendingActionBtn = null;
        }

        function startCooldown(actionId, nextAllowedAtIso) {
            const timerEl = document.querySelector('[data-cooldown-timer][data-action-id="' + actionId + '"]');
            if (!timerEl || !nextAllowedAtIso) return;
            timerEl.setAttribute('data-next-allowed-at', nextAllowedAtIso);
            timerEl.classList.remove('hidden');
        }

        // Ticks every second, updating any visible cooldown timers and
        // re-enabling their button the moment the cooldown actually expires.
        function tickCountdowns() {
            document.querySelectorAll('[data-cooldown-timer]').forEach(function(el) {
                const iso = el.getAttribute('data-next-allowed-at');
                if (!iso) return;
                const remainingMs = new Date(iso).getTime() - Date.now();
                const textEl = el.querySelector('[data-countdown-text]');

                if (remainingMs <= 0) {
                    el.classList.add('hidden');
                    const actionId = el.getAttribute('data-action-id');
                    const btn = document.querySelector('[data-action-btn][data-action-id="' + actionId + '"]');
                    if (btn && btn.disabled) {
                        btn.disabled = false;
                        const labelEl = btn.querySelector('[data-action-btn-label]');
                        if (labelEl) labelEl.textContent = btn.getAttribute('data-action-label');
                    }
                    return;
                }

                const totalSeconds = Math.floor(remainingMs / 1000);
                const hrs = Math.floor(totalSeconds / 3600);
                const mins = Math.floor((totalSeconds % 3600) / 60);
                const secs = totalSeconds % 60;
                const pad = function (n) { return String(n).padStart(2, '0'); };
                if (textEl) {
                    textEl.textContent = hrs > 0
                        ? pad(hrs) + ':' + pad(mins) + ':' + pad(secs)
                        : pad(mins) + ':' + pad(secs);
                }
            });
        }
        tickCountdowns();
        setInterval(tickCountdowns, 1000);

        const actionPollTimers = {};

        function pollActionStatus(actionId, btn, resultBox, labelEl, originalLabel) {
            if (actionPollTimers[actionId]) clearInterval(actionPollTimers[actionId]);

            const check = async function () {
                try {
                    const res = await fetch('/dashboard/actions/' + actionId + '/status');
                    const data = await res.json();

                    if (data.running) return; // still going - keep polling

                    clearInterval(actionPollTimers[actionId]);
                    delete actionPollTimers[actionId];

                    if (data.lastResult && resultBox) {
                        resultBox.classList.remove('hidden');
                        resultBox.className = 'mt-4 text-sm rounded-xl p-4 ' + (data.lastResult.ok
                            ? 'bg-emerald-500/10 border border-emerald-500/30 text-emerald-400'
                            : 'bg-red-500/10 border border-red-500/30 text-red-400');
                        resultBox.textContent = data.lastResult.message;
                    }
                    if (labelEl) labelEl.textContent = (data.lastResult && data.lastResult.ok) ? 'Done' : originalLabel;
                    // Button stays disabled/enabled based on the cooldown timer set when the
                    // action started, not on completion - the countdown logic already handles that.
                } catch (e) {
                    // transient network hiccup while polling - keep trying
                }
            };

            check();
            actionPollTimers[actionId] = setInterval(check, 5000);
        }

        async function confirmAction() {
            const btn = pendingActionBtn;
            closeActionModal();
            if (!btn) return;

            const actionId = btn.getAttribute('data-action-id');
            const card = btn.closest('.glass');
            const resultBox = card ? card.querySelector('[id^="actionResult-"]') : null;
            const labelEl = btn.querySelector('[data-action-btn-label]');

            btn.disabled = true;
            const originalLabel = btn.getAttribute('data-action-label');
            if (labelEl) labelEl.textContent = 'Working...';

            try {
                const res = await fetch('/dashboard/actions/' + actionId + '/run', { method: 'POST' });
                const data = await res.json();
                if (resultBox) {
                    resultBox.classList.remove('hidden');
                    resultBox.className = 'mt-4 text-sm rounded-xl p-4 ' + (data.ok
                        ? 'bg-emerald-500/10 border border-emerald-500/30 text-emerald-400'
                        : 'bg-red-500/10 border border-red-500/30 text-red-400');
                    resultBox.textContent = data.message;
                }
                if (data.nextAllowedAt) {
                    startCooldown(actionId, data.nextAllowedAt);
                    tickCountdowns();
                }

                if (data.started) {
                    // Long-running (danger-style) action kicked off in the background -
                    // poll for the real result instead of waiting on this one request.
                    if (labelEl) labelEl.textContent = 'Running…';
                    pollActionStatus(actionId, btn, resultBox, labelEl, originalLabel);
                } else if (data.ok) {
                    if (labelEl) labelEl.textContent = 'Done';
                    if (!data.nextAllowedAt) btn.disabled = false;
                } else {
                    btn.disabled = !!data.nextAllowedAt;
                    if (labelEl) labelEl.textContent = data.nextAllowedAt ? originalLabel + ' Unavailable' : originalLabel;
                }
            } catch (e) {
                if (resultBox) {
                    resultBox.classList.remove('hidden');
                    resultBox.className = 'mt-4 text-sm rounded-xl p-4 bg-red-500/10 border border-red-500/30 text-red-400';
                    resultBox.textContent = 'Something went wrong sending that request.';
                }
                btn.disabled = false;
                if (labelEl) labelEl.textContent = originalLabel;
            }
        }

        // Fetch live container health for a plan card without blocking page load
        async function refreshPlanHealth(el) {
            const planId = el.getAttribute('data-plan-id');
            try {
                const res = await fetch('/dashboard/plans/' + planId + '/health');
                const data = await res.json();
                if (!data.ok) return;
                data.containers.forEach(function(c) {
                    const row = el.querySelector('[data-container-name="' + c.container_name + '"] [data-status-pill]');
                    if (!row) return;
                    const map = {
                        up: ['badge-active', 'fa-circle-check', 'Online'],
                        starting: ['badge-suspended', 'fa-circle-notch fa-spin', 'Starting'],
                        unhealthy: ['badge-expired', 'fa-triangle-exclamation', 'Unhealthy'],
                        down: ['badge-expired', 'fa-circle-xmark', 'Offline'],
                        unknown: ['badge-closed', 'fa-question', 'Unknown'],
                    };
                    const chosen = map[c.status] || map.unknown;
                    row.className = 'badge ' + chosen[0];
                    row.innerHTML = '<i class="fas ' + chosen[1] + '"></i> ' + chosen[2];
                });
            } catch (e) {
                // leave "checking" state as-is on failure
            }
        }

        document.querySelectorAll('[data-health-container]').forEach(function(el) {
            refreshPlanHealth(el);
        });

        document.addEventListener('click', async function (e) {
            const btn = e.target.closest('[data-plan-refresh-btn]');
            if (!btn) return;

            const planId = btn.getAttribute('data-plan-id');
            const container = document.querySelector('[data-health-container][data-plan-id="' + planId + '"]');
            if (!container) return;

            const icon = btn.querySelector('i');
            if (icon) icon.classList.add('fa-spin');
            btn.disabled = true;

            // Immediate feedback so it's obvious the click registered.
            container.querySelectorAll('[data-status-pill]').forEach(function (pill) {
                pill.className = 'badge badge-suspended';
                pill.innerHTML = '<i class="fas fa-circle-notch fa-spin"></i> checking';
            });

            try {
                await refreshPlanHealth(container);
            } finally {
                if (icon) icon.classList.remove('fa-spin');
                btn.disabled = false;
            }
        });

        // ---------- Now Watching ----------
        (function () {
            const section = document.getElementById('nowWatchingSection');
            if (!section) return; // no Plex plan - nothing to show

            const content = document.getElementById('nowWatchingContent');
            const stateBadge = function (state) {
                if (state === 'playing') return ['badge-active', 'fa-circle-play', 'Playing'];
                if (state === 'buffering') return ['badge-suspended', 'fa-circle-notch fa-spin', 'Buffering'];
                return ['badge-closed', 'fa-circle-pause', 'Paused'];
            };

            async function refreshNowWatching() {
                try {
                    const res = await fetch('/dashboard/plex/now-watching');
                    const data = await res.json();

                    if (!data.ok || !data.items || data.items.length === 0) {
                        section.classList.add('hidden');
                        return;
                    }

                    section.classList.remove('hidden');
                    content.innerHTML = data.items.map(function (item) {
                        const badge = stateBadge(item.state);
                        const poster = item.posterUrl
                            ? '<img src="' + item.posterUrl + '" alt="" class="w-14 h-20 sm:w-16 sm:h-24 rounded-lg object-cover flex-shrink-0 bg-slate-800">'
                            : '<div class="w-14 h-20 sm:w-16 sm:h-24 rounded-lg bg-slate-800 flex items-center justify-center flex-shrink-0"><i class="fas fa-film text-slate-600"></i></div>';
                        return '<div class="flex items-center gap-4">' +
                            poster +
                            '<div class="flex-1 min-w-0">' +
                            '<span class="badge ' + badge[0] + ' mb-2"><i class="fas ' + badge[1] + '"></i> ' + badge[2] + '</span>' +
                            '<p class="text-white font-bold text-sm sm:text-base truncate">' + item.title + '</p>' +
                            '<div class="w-full bg-slate-800 rounded-full h-1.5 mt-3">' +
                            '<div class="bg-sky-500 h-1.5 rounded-full" style="width:' + Math.max(0, Math.min(100, item.progressPercent)) + '%"></div>' +
                            '</div>' +
                            '<p class="text-slate-500 text-xs mt-1">' + Math.round(item.progressPercent) + '% watched</p>' +
                            '</div></div>';
                    }).join('<div class="border-t border-white/5 my-4"></div>');
                } catch (e) {
                    section.classList.add('hidden');
                }
            }

            refreshNowWatching();
            setInterval(refreshNowWatching, 20000);
        })();
    </script>
</body>
</html>
