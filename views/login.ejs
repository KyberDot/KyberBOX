<!DOCTYPE html>
<html lang="en">
<head>
    <% pageTitle = 'Client Access | ' + siteName %>
    <%- include('partials/head') %>
</head>
<body class="antialiased overflow-x-hidden">

    <!-- ===== Mobile / tablet (below lg) - exact match of the reference design ===== -->
    <div class="lg:hidden flex flex-col min-h-screen">
        <nav class="max-w-7xl mx-auto px-8 py-6 w-full">
            <div class="flex justify-between items-center">
                <img src="/img/KY.svg" alt="<%= siteName %> Logo" class="h-10 w-auto">
            </div>
        </nav>

        <main class="flex-grow flex items-center justify-center px-6 py-12 relative overflow-x-hidden">
            <div class="hero-glow"></div>

            <div class="max-w-md w-full relative z-10">
                <div class="text-center mb-8">
                    <div class="w-20 h-20 mx-auto rounded-full bg-sky-500/10 border border-sky-500/30 flex items-center justify-center float mb-6">
                        <i class="fas fa-shield-halved text-sky-400 text-3xl"></i>
                    </div>
                    <h1 class="text-3xl md:text-4xl font-extrabold mb-2 tracking-tight">
                        Client <span class="gradient-text">Portal</span>
                    </h1>
                    <p class="text-slate-400 text-sm">Sign in to manage your subscription.</p>
                </div>

                <div class="glass rounded-3xl p-8">
                    <%- include('partials/login-card') %>
                </div>

                <p class="text-center text-slate-500 text-sm mt-8">
                    Don't have access yet? Portal accounts are invite-only —
                    <a href="mailto:support@kyberbox.app" class="text-sky-400 hover:text-sky-300">contact support</a>.
                </p>
            </div>
        </main>

        <footer class="py-6 text-center border-t border-white/5">
            <p class="text-slate-600 text-xs uppercase tracking-widest">&copy; <%= new Date().getFullYear() %> <%= siteName %>. All Rights Reserved.</p>
        </footer>
    </div>

    <!-- ===== Desktop (lg+) - split-screen, no icon bubble ===== -->
    <div class="hidden lg:flex" style="height: 100dvh;">
        <div class="lg:w-[42%] xl:w-[38%] flex-shrink-0 relative overflow-hidden flex flex-col justify-between p-10 xl:p-14 bg-gradient-to-br from-[#0d1420] via-[#0b0f1a] to-[#0d1420] border-r border-white/5">
            <div class="hero-glow" style="top:15%; left:20%;"></div>

            <img src="/img/KY.svg" alt="<%= siteName %> Logo" class="h-9 xl:h-10 w-auto relative z-10">

            <div class="relative z-10">
                <h2 class="text-3xl xl:text-[2.5rem] font-extrabold mb-6 leading-tight tracking-tight">
                    One dashboard for <span class="gradient-text">everything</span> you host.
                </h2>
                <ul class="space-y-4 text-slate-400 text-sm xl:text-base">
                    <li class="flex items-center gap-3">
                        <span class="w-7 h-7 rounded-full bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center flex-shrink-0">
                            <i class="fas fa-check text-emerald-400 text-xs"></i>
                        </span>
                        Manage and restart your services in one click
                    </li>
                    <li class="flex items-center gap-3">
                        <span class="w-7 h-7 rounded-full bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center flex-shrink-0">
                            <i class="fas fa-check text-emerald-400 text-xs"></i>
                        </span>
                        See live status at a glance
                    </li>
                    <li class="flex items-center gap-3">
                        <span class="w-7 h-7 rounded-full bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center flex-shrink-0">
                            <i class="fas fa-check text-emerald-400 text-xs"></i>
                        </span>
                        Get support without leaving your dashboard
                    </li>
                </ul>
            </div>

            <p class="text-slate-600 text-xs relative z-10">&copy; <%= new Date().getFullYear() %> <%= siteName %>. All rights reserved.</p>
        </div>

        <main class="flex-1 min-w-0 flex items-center justify-center px-10 relative overflow-y-auto">
            <div class="max-w-md w-full relative z-10">
                <div class="text-left mb-8">
                    <h1 class="text-3xl font-extrabold mb-2 tracking-tight">
                        Client <span class="gradient-text">Portal</span>
                    </h1>
                    <p class="text-slate-400 text-sm">Sign in to manage your subscription.</p>
                </div>

                <div class="glass rounded-3xl p-8">
                    <%- include('partials/login-card') %>
                </div>

                <p class="text-left text-slate-500 text-sm mt-8">
                    Don't have access yet? Portal accounts are invite-only —
                    <a href="mailto:support@kyberbox.app" class="text-sky-400 hover:text-sky-300">contact support</a>.
                </p>
            </div>
        </main>
    </div>

    <script>
        // Both the mobile and desktop layouts render their own copy of the
        // login card (see partials/login-card.ejs) - only one is ever
        // visible via CSS at a time, but both exist in the DOM, so every
        // helper here operates on "all matching elements" rather than a
        // single id, keeping both copies in sync automatically.
        function showTwoFactorPanels() {
            document.querySelectorAll('.login-panel').forEach((p) => p.classList.add('hidden'));
            document.querySelectorAll('.twofa-panel').forEach((p) => p.classList.remove('hidden'));
            document.querySelectorAll('.twofa-panel:not(.hidden) input[name="code"]').forEach((i) => i.focus());
        }

        function showLoginPanels() {
            document.querySelectorAll('.twofa-panel').forEach((p) => p.classList.add('hidden'));
            document.querySelectorAll('.login-panel').forEach((p) => p.classList.remove('hidden'));
            setTwoFactorError(null);
        }

        function setLoginError(message) {
            document.querySelectorAll('.login-error-box').forEach((box) => {
                box.classList.toggle('hidden', !message);
                box.querySelector('.login-error-text').textContent = message || '';
            });
        }

        function setTwoFactorError(message) {
            document.querySelectorAll('.twofa-error-box').forEach((box) => {
                box.classList.toggle('hidden', !message);
                box.querySelector('.twofa-error-text').textContent = message || '';
            });
        }

        document.querySelectorAll('.login-form').forEach((form) => {
            form.addEventListener('submit', async function (e) {
                e.preventDefault();
                setLoginError(null);

                const email = form.querySelector('[name="email"]').value;
                const password = form.querySelector('[name="password"]').value;
                const submitBtn = form.querySelector('button[type="submit"]');
                submitBtn.disabled = true;

                try {
                    const res = await fetch('/login', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: 'email=' + encodeURIComponent(email) + '&password=' + encodeURIComponent(password),
                    });
                    const data = await res.json();

                    if (!data.ok) {
                        setLoginError(data.message || 'Something went wrong. Please try again.');
                        return;
                    }

                    if (data.twoFactorRequired) {
                        showTwoFactorPanels();
                    } else {
                        window.location.href = data.redirect;
                    }
                } catch (err) {
                    setLoginError('Could not reach the server. Please check your connection and try again.');
                } finally {
                    submitBtn.disabled = false;
                }
            });
        });

        document.querySelectorAll('.twofa-form').forEach((form) => {
            form.addEventListener('submit', async function (e) {
                e.preventDefault();
                setTwoFactorError(null);

                const code = form.querySelector('[name="code"]').value;
                const submitBtn = form.querySelector('button[type="submit"]');
                submitBtn.disabled = true;

                try {
                    const res = await fetch('/login/2fa', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: 'code=' + encodeURIComponent(code),
                    });
                    const data = await res.json();

                    if (!data.ok) {
                        if (data.expired) {
                            showLoginPanels();
                            setLoginError(data.message);
                        } else {
                            setTwoFactorError(data.message || 'Incorrect code. Please try again.');
                        }
                        return;
                    }

                    window.location.href = data.redirect;
                } catch (err) {
                    setTwoFactorError('Could not reach the server. Please check your connection and try again.');
                } finally {
                    submitBtn.disabled = false;
                }
            });
        });

        document.querySelectorAll('.twofa-cancel-btn').forEach((btn) => {
            btn.addEventListener('click', async function () {
                try {
                    await fetch('/login/2fa/cancel', { method: 'POST' });
                } catch (e) {
                    // best-effort - still switch back to the login form client-side either way
                }
                showLoginPanels();
            });
        });

        <% if (showTwoFactor) { %>
        showTwoFactorPanels();
        <% } %>
    </script>
</body>
</html>
