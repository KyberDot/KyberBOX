<!DOCTYPE html>
<html lang="en">
<head>
    <% pageTitle = 'Providers' %>
    <%- include('partials/head') %>
</head>
<body class="antialiased overflow-x-hidden">
    <%- include('partials/nav') %>

    <main class="max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-10 pb-24">
        <div class="flex items-start justify-between gap-4 mb-2">
            <h1 class="text-2xl sm:text-3xl font-extrabold">Providers</h1>
            <div class="flex items-center gap-2 flex-shrink-0">
                <button type="button" onclick="fetchProviderStatuses(true)" id="refreshStatusBtn" title="Refresh all statuses" class="w-10 h-10 flex items-center justify-center rounded-xl btn-outline">
                    <i class="fas fa-rotate"></i>
                </button>
                <button type="button" onclick="openAddProvider()" title="Add Provider" class="w-10 h-10 flex items-center justify-center rounded-xl btn-outline">
                    <i class="fas fa-plus"></i>
                </button>
            </div>
        </div>
        <p class="text-slate-400 text-sm mb-8">Track uptime and account status for debrid services, Usenet providers, indexers, and anything else worth keeping an eye on.</p>

        <% if (providers.length === 0) { %>
            <div class="glass rounded-2xl p-8 text-center">
                <i class="fas fa-plug text-3xl text-slate-600 mb-3"></i>
                <p class="text-slate-400 text-sm">No providers added yet. Use the <i class="fas fa-plus mx-1"></i> button above to add your first one.</p>
            </div>
        <% } %>

        <%
            // Single card-builder reused across all three fixed categories,
            // rather than repeating the same markup three times over.
            // isIndexer forces the blue accent/badge treatment and drops the
            // empty status-badge slot indexers have nothing to put there,
            // which is what was leaving the tracking badge looking stranded
            // on its own before.
            function providerCard(p, idx, total, isIndexer) {
                const toneBorder = { active: 'border-emerald-500 text-emerald-400', warning: 'border-amber-500 text-amber-400', inactive: 'border-red-500 text-red-400', lifetime: 'border-sky-500 text-sky-400', unset: 'border-slate-700 border-dashed text-slate-500' }[p.tracking.tone];
                const accentColor = isIndexer ? '#58a6ff' : (p.check_type === 'none' ? '#334155' : '#475569');
                const trackingBadge = '<button type="button" onclick="openTrackingModal(' + p.id + ')" class="px-2.5 py-1 rounded-md border font-mono text-[10px] uppercase tracking-wider font-bold hover:opacity-75 transition flex-shrink-0 ' + (isIndexer ? 'border-sky-500 text-sky-400' : toneBorder) + '">' + p.tracking.label + '</button>';

                let html = '<div class="glass rounded-2xl overflow-hidden relative" id="provider-card-' + p.id + '">';
                html += '<div class="h-[3px] w-full" id="provider-accent-' + p.id + '" data-indexer="' + (isIndexer ? '1' : '0') + '" style="background:' + accentColor + ';"></div>';
                html += '<div class="p-4' + (isIndexer ? '' : ' sm:p-5') + '">';

                // Indexers have no status/metrics to show, so their whole
                // card collapses to a single row - icon and name on the
                // left, the tracking badge and admin controls together on
                // the right - rather than leaving a near-empty second row
                // underneath just to hold one small badge.
                html += '<div class="flex items-center justify-between gap-2' + (isIndexer ? '' : ' mb-3') + '">';
                html += '<a href="' + (p.custom_link || p.link || '#') + '" target="_blank" class="flex items-center gap-3 min-w-0 hover:opacity-75 transition">';
                html += '<span class="w-10 h-10 rounded-xl bg-white/5 flex items-center justify-center text-lg flex-shrink-0">' + p.icon + '</span>';
                html += '<div class="min-w-0"><p class="font-extrabold text-white text-sm uppercase tracking-wide truncate">' + p.name + '</p>';
                if (p.type_label) html += '<p class="font-mono text-[10px] text-sky-400/60 uppercase tracking-wider truncate mt-0.5">' + p.type_label + '</p>';
                html += '</div></a>';

                html += '<div class="flex items-center gap-1.5 flex-shrink-0">';
                if (isIndexer) html += trackingBadge;
                html += '<div class="flex items-center gap-0.5">';
                html += '<form method="POST" action="/admin/providers/' + p.id + '/move" data-ajax-form><input type="hidden" name="direction" value="up"><button type="submit" class="w-6 h-6 rounded-lg text-slate-500 hover:text-white hover:bg-white/5" title="Move earlier"' + (idx === 0 ? ' disabled style=opacity:0.3' : '') + '><i class="fas fa-arrow-up text-xs"></i></button></form>';
                html += '<form method="POST" action="/admin/providers/' + p.id + '/move" data-ajax-form><input type="hidden" name="direction" value="down"><button type="submit" class="w-6 h-6 rounded-lg text-slate-500 hover:text-white hover:bg-white/5" title="Move later"' + (idx === total - 1 ? ' disabled style=opacity:0.3' : '') + '><i class="fas fa-arrow-down text-xs"></i></button></form>';
                html += '<button type="button" onclick="openEditProvider(' + p.id + ')" title="Edit" class="text-slate-500 hover:text-white w-6 h-6 flex items-center justify-center rounded-lg hover:bg-white/5"><i class="fas fa-pen text-xs"></i></button>';
                html += '<form method="POST" action="/admin/providers/' + p.id + '/delete" data-ajax-form data-confirm="Remove &quot;' + p.name + '&quot;? This can\'t be undone."><button type="submit" class="text-slate-500 hover:text-red-400 w-6 h-6 flex items-center justify-center rounded-lg hover:bg-white/5"><i class="fas fa-trash text-xs"></i></button></form>';
                html += '</div></div></div>';

                if (!isIndexer) {
                    if (p.check_type !== 'none') {
                        html += '<div class="flex items-center justify-between gap-2 mb-3">';
                        html += '<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md border border-slate-600 text-slate-400 font-mono text-[10px] uppercase tracking-wider font-bold" id="provider-status-' + p.id + '"><span class="w-1.5 h-1.5 rounded-full bg-slate-500 flex-shrink-0" id="provider-status-dot-' + p.id + '"></span>checking</span>';
                        html += trackingBadge;
                        html += '</div>';
                    } else {
                        html += '<div class="flex items-center mb-3">' + trackingBadge + '</div>';
                    }
                    html += '<div class="space-y-1 font-mono text-[11px]" id="provider-metrics-' + p.id + '"></div>';
                }

                if (p.active_servers != null) {
                    html += '<div class="flex items-center justify-between font-mono text-[11px] mt-1"><span class="text-slate-500">Active Servers</span><span class="px-2 py-0.5 rounded-full bg-emerald-500/15 text-emerald-400 border border-emerald-500/30 font-bold">' + p.active_servers + '</span></div>';
                }
                if (p.plan_name) {
                    html += '<div class="flex items-center justify-between font-mono text-[11px] mt-1"><span class="text-slate-500">Plan</span><span class="text-slate-300">' + p.plan_name + '</span></div>';
                }
                if (p.notes) {
                    html += '<p class="text-slate-500 text-xs mt-2 pt-2 border-t border-white/5">' + p.notes + '</p>';
                }

                html += '</div></div>';
                return html;
            }
        %>

        <% if (infrastructureProviders.length > 0) { %>
            <div class="mb-10">
                <div class="flex items-center gap-3 mb-4">
                    <h2 class="text-xs font-mono uppercase tracking-[0.2em] text-sky-400/70 font-bold flex-shrink-0">Infrastructure</h2>
                    <div class="flex-1 h-px bg-white/10"></div>
                </div>
                <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
                    <% infrastructureProviders.forEach(function(p, idx) { %><%- providerCard(p, idx, infrastructureProviders.length, false) %><% }); %>
                </div>
            </div>
        <% } %>

        <% if (usenetProviders.length > 0 || torrentsProviders.length > 0) { %>
            <div class="mb-2">
                <div class="flex items-center gap-3 mb-6">
                    <h2 class="text-xs font-mono uppercase tracking-[0.2em] text-white/80 font-bold flex-shrink-0">Indexers</h2>
                    <div class="flex-1 h-px bg-white/10"></div>
                </div>
            </div>

            <% if (usenetProviders.length > 0) { %>
                <div class="mb-10">
                    <div class="flex items-center gap-3 mb-4 pl-2">
                        <h3 class="text-xs font-mono uppercase tracking-[0.15em] text-sky-400/70 font-bold flex-shrink-0">Usenet</h3>
                        <div class="flex-1 h-px bg-white/5"></div>
                    </div>
                    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
                        <% usenetProviders.forEach(function(p, idx) { %><%- providerCard(p, idx, usenetProviders.length, true) %><% }); %>
                    </div>
                </div>
            <% } %>

            <% if (torrentsProviders.length > 0) { %>
                <div class="mb-10">
                    <div class="flex items-center gap-3 mb-4 pl-2">
                        <h3 class="text-xs font-mono uppercase tracking-[0.15em] text-sky-400/70 font-bold flex-shrink-0">Torrents</h3>
                        <div class="flex-1 h-px bg-white/5"></div>
                    </div>
                    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
                        <% torrentsProviders.forEach(function(p, idx) { %><%- providerCard(p, idx, torrentsProviders.length, true) %><% }); %>
                    </div>
                </div>
            <% } %>
        <% } %>

        <script type="application/json" id="providers-data"><%- JSON.stringify(providers) %></script>
    </main>

    <!-- Add Provider Modal -->
    <div id="addProviderModal" class="fixed inset-0 bg-black/70 backdrop-blur-sm hidden items-center justify-center z-50 px-4 py-8 overflow-y-auto">
        <div class="glass rounded-3xl p-6 sm:p-8 max-w-lg w-full my-auto">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-lg font-bold text-white"><i class="fas fa-plus mr-2 text-sky-400"></i>Add Provider</h3>
                <button type="button" onclick="closeModal('addProviderModal')" title="Close" class="text-slate-400 hover:text-white w-8 h-8 flex items-center justify-center rounded-lg hover:bg-white/5"><i class="fas fa-xmark"></i></button>
            </div>
            <form method="POST" action="/admin/providers" data-ajax-form class="grid gap-3">
                <div class="grid grid-cols-3 gap-3">
                    <input type="text" name="icon" class="input col-span-1 text-center" placeholder="🔌" maxlength="4" value="🔌">
                    <input type="text" name="name" required class="input col-span-2" placeholder="Provider name">
                </div>
                <select name="group_label" required class="input">
                    <option value="Infrastructure">Infrastructure</option>
                    <option value="Usenet">Indexers - Usenet</option>
                    <option value="Torrents">Indexers - Torrents</option>
                </select>
                <input type="text" name="type_label" class="input" placeholder="Description shown under the name (optional)">
                <select name="check_type" class="input" onchange="toggleCheckTypeFields('add')" data-check-type-select="add">
                    <option value="none">No live check - manual tracking only</option>
                    <option value="real_debrid">Real-Debrid (API key)</option>
                    <option value="alldebrid">AllDebrid (API key)</option>
                    <option value="easynews">Easynews (username + password)</option>
                    <option value="tcp">TCP port check (host + port)</option>
                    <option value="http_ping">HTTP ping - latency only (Hetzner, AWS, etc)</option>
                </select>
                <div data-check-fields="add-real_debrid,add-alldebrid" class="hidden">
                    <input type="text" name="api_key" class="input w-full" placeholder="API key">
                </div>
                <div data-check-fields="add-easynews" class="hidden grid grid-cols-2 gap-3">
                    <input type="text" name="username" class="input" placeholder="Username">
                    <input type="password" name="password" class="input" placeholder="Password">
                </div>
                <div data-check-fields="add-tcp" class="hidden grid grid-cols-3 gap-3">
                    <input type="text" name="host" class="input col-span-2" placeholder="Host">
                    <input type="number" name="port" class="input" placeholder="Port">
                </div>
                <div data-check-fields="add-http_ping" class="hidden grid gap-2">
                    <p class="text-slate-500 text-xs">Pings the website link below to measure latency - useful for services with no standard port to check directly.</p>
                    <input type="number" name="active_servers" class="input w-full" placeholder="Active servers (optional)" min="0">
                </div>
                <input type="url" name="link" class="input" placeholder="Website link (https://...)">
                <button type="submit" class="btn-primary py-3 rounded-xl text-sm mt-2"><i class="fas fa-plus mr-2"></i>Add Provider</button>
            </form>
        </div>
    </div>

    <!-- Edit Provider Modal -->
    <div id="editProviderModal" class="fixed inset-0 bg-black/70 backdrop-blur-sm hidden items-center justify-center z-50 px-4 py-8 overflow-y-auto">
        <div class="glass rounded-3xl p-6 sm:p-8 max-w-lg w-full my-auto">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-lg font-bold text-white"><i class="fas fa-pen mr-2 text-sky-400"></i>Edit Provider</h3>
                <button type="button" onclick="closeModal('editProviderModal')" title="Close" class="text-slate-400 hover:text-white w-8 h-8 flex items-center justify-center rounded-lg hover:bg-white/5"><i class="fas fa-xmark"></i></button>
            </div>
            <form id="editProviderForm" method="POST" data-ajax-form class="grid gap-3">
                <div class="grid grid-cols-3 gap-3">
                    <input type="text" name="icon" class="input col-span-1 text-center" maxlength="4">
                    <input type="text" name="name" required class="input col-span-2">
                </div>
                <select name="group_label" required class="input">
                    <option value="Infrastructure">Infrastructure</option>
                    <option value="Usenet">Indexers - Usenet</option>
                    <option value="Torrents">Indexers - Torrents</option>
                </select>
                <input type="text" name="type_label" class="input" placeholder="Description shown under the name (optional)">
                <select name="check_type" class="input" onchange="toggleCheckTypeFields('edit')" data-check-type-select="edit">
                    <option value="none">No live check - manual tracking only</option>
                    <option value="real_debrid">Real-Debrid (API key)</option>
                    <option value="alldebrid">AllDebrid (API key)</option>
                    <option value="easynews">Easynews (username + password)</option>
                    <option value="tcp">TCP port check (host + port)</option>
                    <option value="http_ping">HTTP ping - latency only (Hetzner, AWS, etc)</option>
                </select>
                <div data-check-fields="edit-real_debrid,edit-alldebrid" class="hidden">
                    <input type="text" name="api_key" class="input w-full" placeholder="Leave blank to keep the current key">
                </div>
                <div data-check-fields="edit-easynews" class="hidden grid grid-cols-2 gap-3">
                    <input type="text" name="username" class="input" placeholder="Username">
                    <input type="password" name="password" class="input" placeholder="Leave blank to keep the current password">
                </div>
                <div data-check-fields="edit-tcp" class="hidden grid grid-cols-3 gap-3">
                    <input type="text" name="host" class="input col-span-2" placeholder="Host">
                    <input type="number" name="port" class="input" placeholder="Port">
                </div>
                <div data-check-fields="edit-http_ping" class="hidden grid gap-2">
                    <p class="text-slate-500 text-xs">Pings the website link below to measure latency - useful for services with no standard port to check directly.</p>
                    <input type="number" name="active_servers" class="input w-full" placeholder="Active servers (optional)" min="0">
                </div>
                <input type="url" name="link" class="input" placeholder="Website link (https://...)">
                <button type="submit" class="btn-primary py-3 rounded-xl text-sm mt-2">Save Changes</button>
            </form>
        </div>
    </div>

    <!-- Tracking (Plan / Expiry) Modal -->
    <div id="trackingModal" class="fixed inset-0 bg-black/70 backdrop-blur-sm hidden items-center justify-center z-50 px-4 py-8 overflow-y-auto">
        <div class="glass rounded-3xl p-6 sm:p-8 max-w-lg w-full my-auto">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-lg font-bold text-white"><i class="fas fa-calendar mr-2 text-sky-400"></i>Plan &amp; Expiry</h3>
                <button type="button" onclick="closeModal('trackingModal')" title="Close" class="text-slate-400 hover:text-white w-8 h-8 flex items-center justify-center rounded-lg hover:bg-white/5"><i class="fas fa-xmark"></i></button>
            </div>
            <form id="trackingForm" method="POST" data-ajax-form class="grid gap-3">
                <select name="plan_status" class="input" onchange="toggleTrackingValueField()" data-tracking-status-select>
                    <option value="unset">Unset</option>
                    <option value="date">Tracks an expiry date</option>
                    <option value="lifetime">Lifetime</option>
                    <option value="free">Free</option>
                    <option value="billed">Billed / Active</option>
                    <option value="inactive">Inactive</option>
                    <option value="balance_gb">Balance (GB)</option>
                    <option value="balance_tb">Balance (TB)</option>
                </select>
                <div data-tracking-value-wrap class="hidden">
                    <label class="text-xs text-slate-500 mb-1 block" data-tracking-value-label>Expiry date</label>
                    <input type="text" name="tracking_value" id="trackingValueInput" class="input w-full">
                </div>
                <div>
                    <label class="text-xs text-slate-500 mb-1 block">Plan name (shown as a metric, e.g. "Unlimited")</label>
                    <input type="text" name="plan_name" class="input w-full">
                </div>
                <div>
                    <label class="text-xs text-slate-500 mb-1 block">Custom link (overrides the default website link)</label>
                    <input type="url" name="custom_link" class="input w-full" placeholder="https://...">
                </div>
                <div>
                    <label class="text-xs text-slate-500 mb-1 block">Notes (shown on the card)</label>
                    <input type="text" name="notes" class="input w-full">
                </div>
                <button type="submit" class="btn-primary py-3 rounded-xl text-sm mt-2">Save</button>
            </form>
        </div>
    </div>

    <script>
        function getProvidersData() {
            const el = document.getElementById('providers-data');
            if (!el) return [];
            try { return JSON.parse(el.textContent); } catch (e) { return []; }
        }

        function formField(form, name) {
            return form.querySelector('[name="' + name + '"]');
        }

        function toggleCheckTypeFields(prefix) {
            const select = document.querySelector('[data-check-type-select="' + prefix + '"]');
            const value = select.value;
            document.querySelectorAll('[data-check-fields^="' + prefix + '-"]').forEach(function (el) { el.classList.add('hidden'); });
            document.querySelectorAll('[data-check-fields]').forEach(function (el) {
                const keys = el.getAttribute('data-check-fields').split(',');
                if (keys.indexOf(prefix + '-' + value) !== -1) el.classList.remove('hidden');
            });
        }

        const PLAN_STATUS_COLORS = {
            unset:      { border: '#475569', bg: 'rgba(71,85,105,0.15)',  text: '#cbd5e1' },
            date:       { border: '#0ea5e9', bg: 'rgba(14,165,233,0.15)', text: '#bae6fd' },
            lifetime:   { border: '#8b5cf6', bg: 'rgba(139,92,246,0.15)', text: '#ddd6fe' },
            free:       { border: '#10b981', bg: 'rgba(16,185,129,0.15)', text: '#a7f3d0' },
            billed:     { border: '#14b8a6', bg: 'rgba(20,184,166,0.15)', text: '#99f6e4' },
            inactive:   { border: '#ef4444', bg: 'rgba(239,68,68,0.15)',  text: '#fecaca' },
            balance_gb: { border: '#f59e0b', bg: 'rgba(245,158,11,0.15)', text: '#fde68a' },
            balance_tb: { border: '#f97316', bg: 'rgba(249,115,22,0.15)', text: '#fed7aa' },
        };

        function applyTrackingSelectColor() {
            const select = document.querySelector('[data-tracking-status-select]');
            const color = PLAN_STATUS_COLORS[select.value] || PLAN_STATUS_COLORS.unset;
            // Inline styles rather than Tailwind classes - .input sets its
            // border color via a CSS shorthand, which would otherwise fight
            // a utility class for specificity.
            select.style.borderColor = color.border;
            select.style.backgroundColor = color.bg;
            select.style.color = color.text;
        }

        function toggleTrackingValueField() {
            const select = document.querySelector('[data-tracking-status-select]');
            const wrap = document.querySelector('[data-tracking-value-wrap]');
            const label = document.querySelector('[data-tracking-value-label]');
            const input = document.getElementById('trackingValueInput');
            const value = select.value;

            applyTrackingSelectColor();

            if (value === 'date') {
                wrap.classList.remove('hidden');
                label.textContent = 'Expiry date';
                input.type = 'date';
            } else if (value === 'balance_gb' || value === 'balance_tb') {
                wrap.classList.remove('hidden');
                label.textContent = value === 'balance_tb' ? 'Balance (TB)' : 'Balance (GB)';
                input.type = 'number';
                input.step = '0.01';
            } else {
                wrap.classList.add('hidden');
            }
        }

        function openAddProvider() {
            toggleCheckTypeFields('add');
            openModal('addProviderModal');
        }

        function openEditProvider(id) {
            const p = getProvidersData().find(function (x) { return x.id === id; });
            if (!p) return;
            const form = document.getElementById('editProviderForm');
            form.action = '/admin/providers/' + id + '/update';
            formField(form, 'icon').value = p.icon;
            formField(form, 'name').value = p.name;
            formField(form, 'group_label').value = p.group_label;
            formField(form, 'type_label').value = p.type_label || '';
            formField(form, 'check_type').value = p.check_type;
            formField(form, 'api_key').value = '';
            formField(form, 'username').value = p.username || '';
            formField(form, 'password').value = '';
            formField(form, 'host').value = p.host || '';
            formField(form, 'port').value = p.port || '';
            formField(form, 'active_servers').value = p.active_servers != null ? p.active_servers : '';
            formField(form, 'link').value = p.link || '';
            toggleCheckTypeFields('edit');
            openModal('editProviderModal');
        }

        function openTrackingModal(id) {
            const p = getProvidersData().find(function (x) { return x.id === id; });
            if (!p) return;
            const form = document.getElementById('trackingForm');
            form.action = '/admin/providers/' + id + '/tracking';
            formField(form, 'plan_status').value = p.plan_status || 'unset';
            formField(form, 'tracking_value').value = p.tracking_value || '';
            formField(form, 'plan_name').value = p.plan_name || '';
            formField(form, 'custom_link').value = p.custom_link || '';
            formField(form, 'notes').value = p.notes || '';
            toggleTrackingValueField();
            openModal('trackingModal');
        }

        function latencyClass(ms) {
            if (ms == null) return 'text-slate-300';
            if (ms < 200) return 'text-emerald-400';
            if (ms < 600) return 'text-amber-400';
            return 'text-red-400';
        }

        const STATUS_STYLE = {
            online:   { border: 'border-emerald-500 text-emerald-400', dot: 'bg-emerald-400', accent: '#34d399', pulse: true },
            offline:  { border: 'border-red-500 text-red-400',         dot: 'bg-red-400',      accent: '#f87171', pulse: false },
            degraded: { border: 'border-amber-500 text-amber-400',     dot: 'bg-amber-400',    accent: '#fbbf24', pulse: false },
            unknown:  { border: 'border-slate-600 text-slate-400',     dot: 'bg-slate-500',    accent: '#64748b', pulse: false },
        };

        function renderMetrics(data) {
            if (!data) return '';
            const rows = [];
            if (data.latency_ms != null) rows.push(['Latency', data.latency_ms + 'ms', latencyClass(data.latency_ms)]);
            if (data.username) rows.push(['Account', data.username, 'text-slate-300']);
            if (data.premium_until) rows.push(['Premium Until', data.premium_until, 'text-slate-300']);
            if (data.host) rows.push(['Host', data.host, 'text-slate-300']);
            if (data.error) rows.push(['Error', data.error, 'text-red-400']);
            return rows.map(function (r) {
                return '<div class="flex items-center justify-between"><span class="text-slate-500">' + r[0] + '</span><span class="' + r[2] + '">' + r[1] + '</span></div>';
            }).join('');
        }

        let statusFetchInFlight = false;

        async function fetchProviderStatuses(manual) {
            if (statusFetchInFlight) return; // avoid piling up overlapping requests if triggered rapidly
            statusFetchInFlight = true;
            const btn = document.getElementById('refreshStatusBtn');
            if (manual && btn) btn.querySelector('i').classList.add('fa-spin');

            try {
                const res = await fetch('/admin/providers/status' + (manual ? '?force=1' : ''));
                const data = await res.json();
                if (!data.ok) return;
                Object.keys(data.results).forEach(function (id) {
                    const result = data.results[id];
                    const badge = document.getElementById('provider-status-' + id);
                    const dot = document.getElementById('provider-status-dot-' + id);
                    const accent = document.getElementById('provider-accent-' + id);
                    const metrics = document.getElementById('provider-metrics-' + id);
                    if (!result) return;

                    const isUnconfigured = result.status === 'unknown' && result.error && /configured/i.test(result.error);
                    const style = STATUS_STYLE[result.status] || STATUS_STYLE.unknown;

                    if (badge) {
                        badge.className = 'inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md border font-mono text-[10px] uppercase tracking-wider font-bold ' + style.border;
                        badge.lastChild.textContent = isUnconfigured ? 'n/a' : result.status;
                    }
                    if (dot) dot.className = 'w-1.5 h-1.5 rounded-full flex-shrink-0 ' + style.dot + (style.pulse ? ' animate-pulse' : '');
                    // Indexer cards keep their fixed blue accent regardless of
                    // status, even if one somehow has a live check configured -
                    // the category rule always wins here.
                    if (accent && accent.getAttribute('data-indexer') !== '1') accent.style.background = style.accent;
                    if (metrics) metrics.innerHTML = renderMetrics(isUnconfigured ? null : result);
                });
            } catch (e) {
                // Silent - badges just keep their last known state until the next attempt.
            } finally {
                statusFetchInFlight = false;
                if (manual && btn) btn.querySelector('i').classList.remove('fa-spin');
            }
        }

        // The ajax form handler only swaps the contents of <main> and never
        // re-runs this <script> block, so without this listener a freshly
        // added/edited provider's "checking" badge would sit there until
        // the next scheduled 60s poll - which reads as "stuck forever" to
        // anyone who (reasonably) doesn't wait a full minute before
        // reaching for a manual page refresh. Closing the modals here too,
        // since they live outside <main> and the ajax handler has no way
        // of knowing one was open for the save that just completed.
        document.addEventListener('main:updated', function () {
            fetchProviderStatuses();
            closeModal('addProviderModal');
            closeModal('editProviderModal');
            closeModal('trackingModal');
        });

        fetchProviderStatuses();
        setInterval(fetchProviderStatuses, 60000);
    </script>
</body>
</html>
